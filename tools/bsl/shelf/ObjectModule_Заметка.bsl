
Процедура ПередЗаписью(Отказ)

	Если Не ЗначениеЗаполнено(ДатаСоздания) Тогда
		ДатаСоздания = ТекущаяДатаСеанса();
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(Наименование)) И Не ПустаяСтрока(СокрЛП(ТекстЗаметки)) Тогда
		Наименование = Лев(СокрЛП(ТекстЗаметки), 100);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если НомерСтраницы <= 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Номер страницы заметки должен быть больше нуля.";
		Сообщение.Поле = "НомерСтраницы";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(ТекстЗаметки)) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Заполните текст заметки.";
		Сообщение.Поле = "ТекстЗаметки";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры
