
// Один пакет запросов: прогресс по источникам, сессии за 7 дней,
// страницы за 7 дней и самый активный источник.
// Страницы и активный источник читаются из регистра ПрочитанныеСтраницы.
// Число сессий читается из документов.
Функция ДанныеПрогресса() Экспорт

	ДатаСеанса = НачалоДня(ТекущаяДатаСеанса());
	// Дата() сама нормализует день, если он ушёл в предыдущий месяц.
	НачалоНедели = Дата(Год(ДатаСеанса), Месяц(ДатаСеанса), День(ДатаСеанса) - 7);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоНедели", НачалоНедели);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Источники.Ссылка КАК ИсточникЧтения,
	|	Источники.Наименование КАК НазваниеИсточника,
	|	Источники.Автор КАК Автор,
	|	Источники.ТипИсточника КАК ТипИсточника,
	|	Источники.Тема КАК Тема,
	|	Источники.ОбщееКоличествоСтраниц КАК ОбщееКоличествоСтраниц,
	|	ЕСТЬNULL(ОборотыЧтения.КоличествоПрочитанныхСтраницОборот, 0) КАК ПрочитаноСтраниц,
	|	ВЫБОР
	|		КОГДА Источники.ОбщееКоличествоСтраниц > 0
	|			ТОГДА ВЫРАЗИТЬ(ЕСТЬNULL(ОборотыЧтения.КоличествоПрочитанныхСтраницОборот, 0) * 100 / Источники.ОбщееКоличествоСтраниц КАК ЧИСЛО(10, 1))
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПроцентЗавершения,
	|	ЕСТЬNULL(ДатыСессий.ДатаПоследнейСессии, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПоследнейСессии
	|ИЗ
	|	Справочник.ИсточникиЧтения КАК Источники
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПрочитанныеСтраницы.Обороты(, , , ) КАК ОборотыЧтения
	|		ПО Источники.Ссылка = ОборотыЧтения.ИсточникЧтения
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Сессия.ИсточникЧтения КАК ИсточникЧтения,
	|			МАКСИМУМ(Сессия.Дата) КАК ДатаПоследнейСессии
	|		ИЗ
	|			Документ.СессияЧтения КАК Сессия
	|		ГДЕ
	|			Сессия.Проведен = ИСТИНА
	|		
	|		СГРУППИРОВАТЬ ПО
	|			Сессия.ИсточникЧтения) КАК ДатыСессий
	|		ПО Источники.Ссылка = ДатыСессий.ИсточникЧтения
	|ГДЕ
	|	НЕ Источники.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Сессия.Ссылка) КАК КоличествоСессийЗаНеделю
	|ИЗ
	|	Документ.СессияЧтения КАК Сессия
	|ГДЕ
	|	Сессия.Проведен = ИСТИНА
	|	И Сессия.Дата >= &НачалоНедели
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ОборотыЗаНеделю.КоличествоПрочитанныхСтраницОборот), 0) КАК СуммаСтраницЗаНеделю
	|ИЗ
	|	РегистрНакопления.ПрочитанныеСтраницы.Обороты(&НачалоНедели, , , ) КАК ОборотыЗаНеделю
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОборотыЗаНеделю.ИсточникЧтения КАК СамыйАктивныйИсточник,
	|	ПРЕДСТАВЛЕНИЕ(ОборотыЗаНеделю.ИсточникЧтения) КАК НазваниеАктивногоИсточника,
	|	ОборотыЗаНеделю.КоличествоПрочитанныхСтраницОборот КАК СтраницАктивногоИсточника
	|ИЗ
	|	РегистрНакопления.ПрочитанныеСтраницы.Обороты(&НачалоНедели, , , ) КАК ОборотыЗаНеделю
	|
	|УПОРЯДОЧИТЬ ПО
	|	СтраницАктивногоИсточника УБЫВ,
	|	ОборотыЗаНеделю.ИсточникЧтения";

	РезультатыПакета = Запрос.ВыполнитьПакет();

	Данные = Новый Структура;
	Данные.Вставить("ТаблицаПрогресса", РезультатыПакета[0].Выгрузить());

	КоличествоСессийЗаНеделю = 0;
	ВыборкаСессий = РезультатыПакета[1].Выбрать();
	Если ВыборкаСессий.Следующий() Тогда
		КоличествоСессийЗаНеделю = ВыборкаСессий.КоличествоСессийЗаНеделю;
	КонецЕсли;
	Данные.Вставить("КоличествоСессийЗаНеделю", КоличествоСессийЗаНеделю);

	СуммаСтраницЗаНеделю = 0;
	ВыборкаСуммы = РезультатыПакета[2].Выбрать();
	Если ВыборкаСуммы.Следующий() Тогда
		СуммаСтраницЗаНеделю = ВыборкаСуммы.СуммаСтраницЗаНеделю;
	КонецЕсли;
	Данные.Вставить("СуммаСтраницЗаНеделю", СуммаСтраницЗаНеделю);

	ВыборкаАктивного = РезультатыПакета[3].Выбрать();
	Если ВыборкаАктивного.Следующий() Тогда
		Данные.Вставить("СамыйАктивныйИсточник", Строка(ВыборкаАктивного.НазваниеАктивногоИсточника));
	Иначе
		Данные.Вставить("СамыйАктивныйИсточник", "нет данных за 7 дней");
	КонецЕсли;

	Возврат Данные;

КонецФункции

Функция ЗаметкиИсточника(ИсточникЧтения) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заметки.НомерСтраницы КАК НомерСтраницы,
	|	Заметки.ТекстЗаметки КАК ТекстЗаметки,
	|	Заметки.ДатаСоздания КАК ДатаСоздания
	|ИЗ
	|	Справочник.ЗаметкиКИсточникам КАК Заметки
	|ГДЕ
	|	Заметки.Владелец = &ИсточникЧтения
	|	И НЕ Заметки.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтраницы";
	Запрос.УстановитьПараметр("ИсточникЧтения", ИсточникЧтения);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции
