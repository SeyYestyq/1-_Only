
Процедура РассчитатьПрочитаноСтраниц()

	// Формула живёт в модуле объекта. Форма её не считает.
	Если КонечнаяСтраница >= НачальнаяСтраница И НачальнаяСтраница > 0 Тогда
		ПрочитаноСтраниц = КонечнаяСтраница - НачальнаяСтраница + 1;
	Иначе
		ПрочитаноСтраниц = 0;
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	РассчитатьПрочитаноСтраниц();

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не ЗначениеЗаполнено(ИсточникЧтения) Тогда
		СообщитьОшибку("Укажите источник чтения.", "ИсточникЧтения");
		Отказ = Истина;
	КонецЕсли;

	Если НачальнаяСтраница <= 0 Или КонечнаяСтраница < НачальнаяСтраница Тогда
		СообщитьОшибку(
			"Конечная страница должна быть не меньше начальной, начальная страница больше нуля.",
			"КонечнаяСтраница");
		Отказ = Истина;
	КонецЕсли;

	Если ЗначениеЗаполнено(ИсточникЧтения)
		И КонечнаяСтраница > ИсточникЧтения.ОбщееКоличествоСтраниц Тогда
		СообщитьОшибку("Конечная страница больше объёма источника.", "КонечнаяСтраница");
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	РассчитатьПрочитаноСтраниц();

	// Повторное проведение заменяет движения. Отмена проведения удаляет их
	// свойством «Удалять автоматически при отмене проведения».
	// Регистр оборотный, вида движения у него нет.
	Движения.ПрочитанныеСтраницы.Записывать = Истина;
	Движения.ПрочитанныеСтраницы.Очистить();

	Движение = Движения.ПрочитанныеСтраницы.Добавить();
	Движение.Период = Дата;
	Движение.ИсточникЧтения = ИсточникЧтения;
	Движение.КоличествоПрочитанныхСтраниц = ПрочитаноСтраниц;

КонецПроцедуры

Процедура СообщитьОшибку(Текст, ИмяПоля)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = ИмяПоля;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();

КонецПроцедуры
