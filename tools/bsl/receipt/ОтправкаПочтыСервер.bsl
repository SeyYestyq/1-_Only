
// Формирует PDF по макету проведённого поступления и отправляет его по SMTP.
// Ошибка почты не отменяет проведение: документ не перезаписывается.
Функция СформироватьИОтправитьОтчетПоПочте(ДокументСсылка) Экспорт

	Результат = Новый Структура("Успех, ТекстСообщения", Ложь, "");

	ДанныеДокумента = ПрочитатьПроведенноеПоступление(ДокументСсылка, Результат);
	Если ДанныеДокумента = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если Не НастройкиSMTPЗаполнены() Тогда
		Результат.ТекстСообщения =
			"Заполните константы SMTP: сервер, порт, логин и пароль. "
			+ "Пример: smtp.yandex.ru, порт 465, флажок SSL. Это пример, подойдёт другой сервер. "
			+ "После правки настроек нажмите «Отправить отчёт» ещё раз.";
		Возврат Результат;
	КонецЕсли;

	ИмяФайлаPDF = "";
	ПочтаПодключена = Ложь;
	Почта = Новый ИнтернетПочта;

	Попытка
		ТабличныйДокумент = ПечатнаяФормаПоступления(ДанныеДокумента);
		ИмяФайлаPDF = ПолучитьИмяВременногоФайла("pdf");
		ТабличныйДокумент.Записать(ИмяФайлаPDF, ТипФайлаТабличногоДокумента.PDF);

		Профиль = ПрофильSMTPИзКонстант();
		Письмо = ПисьмоСОтчетом(ДанныеДокумента, ИмяФайлаPDF);

		Почта.Подключиться(Профиль);
		ПочтаПодключена = Истина;
		Почта.Послать(Письмо);

		Результат.Успех = Истина;
		Результат.ТекстСообщения = СтрШаблон(
			"Отчёт отправлен на адрес %1. Документ остаётся проведённым.",
			ДанныеДокумента.АдресЭлектроннойПочты);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			"ОтправкаПочты.Ошибка",
			УровеньЖурналаРегистрации.Ошибка,
			,
			ДокументСсылка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Результат.Успех = Ложь;
		Результат.ТекстСообщения =
			"Не удалось отправить письмо по SMTP. Причина: " + ТекстОшибки
			+ ". Документ остался проведённым. Исправьте адрес или настройки и нажмите «Отправить отчёт» ещё раз.";
	КонецПопытки;

	Если ПочтаПодключена Тогда
		Попытка
			Почта.Отключиться();
		Исключение
			ЗаписьЖурналаРегистрации(
				"ОтправкаПочты.Отключение",
				УровеньЖурналаРегистрации.Предупреждение,
				,
				ДокументСсылка,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	Если Не ПустаяСтрока(ИмяФайлаPDF) Тогда
		Попытка
			УдалитьФайлы(ИмяФайлаPDF);
		Исключение
			// Временный PDF уже мог быть удалён почтовой подсистемой.
		КонецПопытки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПрочитатьПроведенноеПоступление(ДокументСсылка, Результат)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Поступление.Ссылка КАК Ссылка,
	|	Поступление.Номер КАК Номер,
	|	Поступление.Дата КАК Дата,
	|	Поступление.Проведен КАК Проведен,
	|	Поступление.АдресЭлектроннойПочты КАК АдресЭлектроннойПочты,
	|	Поступление.Товары.(
	|		НомерСтроки КАК НомерСтроки,
	|		Товар.Наименование КАК ТоварНаименование,
	|		Количество КАК Количество
	|	) КАК Товары
	|ИЗ
	|	Документ.ПоступлениеТоваровНаСклад КАК Поступление
	|ГДЕ
	|	Поступление.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);

	ВыборкаШапка = Запрос.Выполнить().Выбрать();
	Если Не ВыборкаШапка.Следующий() Тогда
		Результат.ТекстСообщения = "Документ не найден. Запишите его и проведите.";
		Возврат Неопределено;
	КонецЕсли;

	Если Не ВыборкаШапка.Проведен Тогда
		Результат.ТекстСообщения = "Отчёт отправляется только из проведённого документа.";
		Возврат Неопределено;
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(ВыборкаШапка.АдресЭлектроннойПочты)) Тогда
		Результат.ТекстСообщения = "В документе не заполнен адрес электронной почты. Выберите контакт или впишите адрес и запишите документ.";
		Возврат Неопределено;
	КонецЕсли;

	СтрокиТоваров = Новый Массив;
	ВыборкаТовары = ВыборкаШапка.Товары.Выбрать();
	Пока ВыборкаТовары.Следующий() Цикл
		СтрокаТовара = Новый Структура("НомерСтроки, ТоварНаименование, Количество");
		ЗаполнитьЗначенияСвойств(СтрокаТовара, ВыборкаТовары);
		СтрокиТоваров.Добавить(СтрокаТовара);
	КонецЦикла;

	Возврат Новый Структура(
		"Номер, Дата, АдресЭлектроннойПочты, СтрокиТоваров",
		ВыборкаШапка.Номер,
		ВыборкаШапка.Дата,
		СокрЛП(ВыборкаШапка.АдресЭлектроннойПочты),
		СтрокиТоваров);

КонецФункции

Функция ПечатнаяФормаПоступления(ДанныеДокумента)

	ТабличныйДокумент = Новый ТабличныйДокумент;
	Макет = Документы.ПоступлениеТоваровНаСклад.ПолучитьМакет("ПечатьПоступления");

	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьЗаголовок.Параметры.Номер = СокрЛП(ДанныеДокумента.Номер);
	ОбластьЗаголовок.Параметры.Дата = Формат(ДанныеДокумента.Дата, "ДФ=dd.MM.yyyy");
	ОбластьЗаголовок.Параметры.АдресЭлектроннойПочты = ДанныеДокумента.АдресЭлектроннойПочты;
	ТабличныйДокумент.Вывести(ОбластьЗаголовок);

	ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("ШапкаТаблицы"));

	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	Для Каждого СтрокаТовара Из ДанныеДокумента.СтрокиТоваров Цикл
		ОбластьСтрока.Параметры.НомерСтроки = СтрокаТовара.НомерСтроки;
		ОбластьСтрока.Параметры.Товар = СтрокаТовара.ТоварНаименование;
		ОбластьСтрока.Параметры.Количество = СтрокаТовара.Количество;
		ТабличныйДокумент.Вывести(ОбластьСтрока);
	КонецЦикла;

	Возврат ТабличныйДокумент;

КонецФункции

Функция НастройкиSMTPЗаполнены()

	Возврат Не ПустаяСтрока(СокрЛП(Константы.АдресСервераSMTP.Получить()))
		И Константы.ПортSMTP.Получить() > 0
		И Не ПустаяСтрока(СокрЛП(Константы.ЛогинSMTP.Получить()))
		И Не ПустаяСтрока(Константы.ПарольSMTP.Получить());

КонецФункции

Функция ПрофильSMTPИзКонстант()

	Профиль = Новый ИнтернетПочтовыйПрофиль;
	Профиль.АдресСервераSMTP = СокрЛП(Константы.АдресСервераSMTP.Получить());
	Профиль.ПортSMTP = Константы.ПортSMTP.Получить();
	Профиль.ПользовательSMTP = СокрЛП(Константы.ЛогинSMTP.Получить());
	Профиль.ПарольSMTP = Константы.ПарольSMTP.Получить();
	Профиль.ИспользоватьSSLSMTP = Константы.ИспользоватьSSLSMTP.Получить();
	Профиль.ВремяОжидания = 30;
	Возврат Профиль;

КонецФункции

Функция ПисьмоСОтчетом(ДанныеДокумента, ИмяФайлаPDF)

	Письмо = Новый ИнтернетПочтовоеСообщение;

	АдресОтправителя = Новый ИнтернетПочтовыйАдрес;
	АдресОтправителя.Адрес = СокрЛП(Константы.ЛогинSMTP.Получить());
	Письмо.Отправитель = АдресОтправителя;
	Письмо.Получатели.Добавить(ДанныеДокумента.АдресЭлектроннойПочты);

	НомерПоступления = СокрЛП(ДанныеДокумента.Номер);
	Письмо.Тема = СтрШаблон(
		"Отчёт о приёмке по поступлению № %1 от %2",
		НомерПоступления,
		Формат(ДанныеДокумента.Дата, "ДФ=dd.MM.yyyy"));
	Письмо.Тексты.Добавить("Во вложении PDF-отчёт о приёмке товаров на склад.");
	Письмо.Вложения.Добавить(ИмяФайлаPDF, "Поступление_" + НомерПоступления + ".pdf");

	Возврат Письмо;

КонецФункции
