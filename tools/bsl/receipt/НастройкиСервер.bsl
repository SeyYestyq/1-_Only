
Функция ПрочитатьНастройкиSMTP() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("АдресСервераSMTP", Константы.АдресСервераSMTP.Получить());
	Настройки.Вставить("ПортSMTP", Константы.ПортSMTP.Получить());
	Настройки.Вставить("ЛогинSMTP", Константы.ЛогинSMTP.Получить());
	Настройки.Вставить("ПарольSMTP", Константы.ПарольSMTP.Получить());
	Настройки.Вставить("ИспользоватьSSLSMTP", Константы.ИспользоватьSSLSMTP.Получить());
	Возврат Настройки;

КонецФункции

Процедура ЗаписатьНастройкиSMTP(Настройки) Экспорт

	Константы.АдресСервераSMTP.Установить(СокрЛП(Настройки.АдресСервераSMTP));
	Константы.ПортSMTP.Установить(Настройки.ПортSMTP);
	Константы.ЛогинSMTP.Установить(СокрЛП(Настройки.ЛогинSMTP));
	Константы.ПарольSMTP.Установить(Настройки.ПарольSMTP);
	Константы.ИспользоватьSSLSMTP.Установить(Настройки.ИспользоватьSSLSMTP);

КонецПроцедуры
