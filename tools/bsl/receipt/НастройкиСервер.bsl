
Функция ПрочитатьНастройкиSMTP() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("АдресСервераSMTP", Константы.АдресСервераSMTP.Получить());
	Настройки.Вставить("ПортSMTP", Константы.ПортSMTP.Получить());
	Настройки.Вставить("ЛогинSMTP", Константы.ЛогинSMTP.Получить());
	Настройки.Вставить("ПарольSMTP", Константы.ПарольSMTP.Получить());
	Настройки.Вставить("ИспользоватьSSLSMTP", Константы.ИспользоватьSSLSMTP.Получить());
	Возврат Настройки;

КонецФункции

Процедура ЗаписатьНастройкиSMTP(Настройки) Экспорт

	Константы.АдресСервераSMTP.Установить(СокрЛП(Настройки.АдресСервераSMTP));
	Константы.ПортSMTP.Установить(Настройки.ПортSMTP);
	Константы.ЛогинSMTP.Установить(СокрЛП(Настройки.ЛогинSMTP));
	Константы.ПарольSMTP.Установить(Настройки.ПарольSMTP);
	Константы.ИспользоватьSSLSMTP.Установить(Настройки.ИспользоватьSSLSMTP);

КонецПроцедуры

// Локальный файл smtp.local не коммитится. Пароль в журнал не пишется.
Процедура ПодключитьЛокальныеНастройкиSMTP(ЗаписатьСтатус = Ложь) Экспорт

	Состояние = "unchanged";
	ДокументСтатус = "skipped";

	Если Не ЛокальныеНастройкиSMTPУжеЗаданы() Тогда
		Попытка
			ТекстФайла = ТекстЛокальногоФайлаSMTP();
			Если ПустаяСтрока(ТекстФайла) Тогда
				Состояние = "file-missing";
			Иначе
				Настройки = НастройкиSMTPИзТекста(ТекстФайла);
				Если Настройки = Неопределено Тогда
					Состояние = "parse-failed";
				Иначе
					ЗаписатьНастройкиSMTP(Настройки);
					Состояние = "set";
				КонецЕсли;
			КонецЕсли;
		Исключение
			// Текст исключения не сохраняем: в нём может быть пароль.
			Состояние = "fail";
		КонецПопытки;
	КонецЕсли;

	Если Состояние = "set" Или (ЗаписатьСтатус И ЛокальныеНастройкиSMTPУжеЗаданы()) Тогда
		Попытка
			ДокументСтатус = ЗаписатьАдресПоследнегоПроведенногоПоступления(СокрЛП(Константы.ЛогинSMTP.Получить()));
		Исключение
			ДокументСтатус = "document-fail";
		КонецПопытки;
	КонецЕсли;

	Если ЗаписатьСтатус Тогда
		Попытка
			ЗаписатьСтатусПодключенияSMTP(Состояние, ДокументСтатус);
		Исключение
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

Функция ЛокальныеНастройкиSMTPУжеЗаданы()

	Возврат Не ПустаяСтрока(СокрЛП(Константы.АдресСервераSMTP.Получить()))
		И Константы.ПортSMTP.Получить() > 0
		И Не ПустаяСтрока(СокрЛП(Константы.ЛогинSMTP.Получить()))
		И Не ПустаяСтрока(Константы.ПарольSMTP.Получить());

КонецФункции

Функция ТекстЛокальногоФайлаSMTP()

	КаталогПроекта = "/Users/damir/Documents/хакатоны/1С";
	Пути = Новый Массив;
	Пути.Добавить(КаталогПроекта + "/smtp.local");
	Найденные = НайтиФайлы(КаталогПроекта, "smtp.local", Ложь);
	Для Каждого ФайлНайденный Из Найденные Цикл
		Пути.Добавить(ФайлНайденный.ПолноеИмя);
	КонецЦикла;

	Для Каждого Путь Из Пути Цикл
		Файл = Новый Файл(Путь);
		Если Не Файл.Существует() Или Файл.ЭтоКаталог() Или Файл.Размер() <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Документ = Новый ТекстовыйДокумент;
		Документ.Прочитать(Путь, КодировкаТекста.UTF8);
		Части = Новый Массив;
		Для Номер = 1 По Документ.КоличествоСтрок() Цикл
			Части.Добавить(Документ.ПолучитьСтроку(Номер));
		КонецЦикла;
		Возврат СтрСоединить(Части, Символы.ПС);
	КонецЦикла;

	Возврат "";

КонецФункции

Функция НастройкиSMTPИзТекста(Текст)

	Значения = Новый Соответствие;
	ЧислоСтрок = СтрЧислоСтрок(Текст);
	Для Номер = 1 По ЧислоСтрок Цикл
		СтрокаФайла = СокрЛП(СтрПолучитьСтроку(Текст, Номер));
		Если ПустаяСтрока(СтрокаФайла) Или Лев(СтрокаФайла, 1) = "#" Тогда
			Продолжить;
		КонецЕсли;
		Позиция = СтрНайти(СтрокаФайла, "=");
		Если Позиция <= 1 Тогда
			Продолжить;
		КонецЕсли;
		Имя = НРег(СокрЛП(Лев(СтрокаФайла, Позиция - 1)));
		Имя = СтрЗаменить(Имя, Символ(65279), "");
		Значение = СокрЛП(Сред(СтрокаФайла, Позиция + 1));
		Значения.Вставить(Имя, Значение);
	КонецЦикла;

	Сервер = ЗначениеКлючаSMTP(Значения, "server");
	Логин = ЗначениеКлючаSMTP(Значения, "login");
	Пароль = ЗначениеКлючаSMTP(Значения, "password");
	ПортТекст = ЗначениеКлючаSMTP(Значения, "port");
	SSLТекст = ЗначениеКлючаSMTP(Значения, "ssl");

	Если ПустаяСтрока(Сервер) Или ПустаяСтрока(Логин) Или ПустаяСтрока(Пароль) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Порт = 465;
	Если Не ПустаяСтрока(ПортТекст) Тогда
		Попытка
			Порт = Число(ПортТекст);
		Исключение
			Порт = 465;
		КонецПопытки;
	КонецЕсли;
	Если Порт <= 0 Тогда
		Порт = 465;
	КонецЕсли;

	Настройки = Новый Структура;
	Настройки.Вставить("АдресСервераSMTP", Сервер);
	Настройки.Вставить("ПортSMTP", Порт);
	Настройки.Вставить("ЛогинSMTP", Логин);
	Настройки.Вставить("ПарольSMTP", Пароль);
	Настройки.Вставить("ИспользоватьSSLSMTP", ЭтоИстинаSMTP(SSLТекст));
	Возврат Настройки;

КонецФункции

Функция ЗначениеКлючаSMTP(Значения, Имя)

	Значение = Значения.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Значение);

КонецФункции

Функция ЭтоИстинаSMTP(Текст)

	Нормализованный = НРег(СокрЛП(Текст));
	Если ПустаяСтрока(Нормализованный) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Нормализованный = "true"
		Или Нормализованный = "1"
		Или Нормализованный = "да"
		Или Нормализованный = "истина";

КонецФункции

Функция ЗаписатьАдресПоследнегоПроведенногоПоступления(Адрес)

	Адрес = СокрЛП(Адрес);
	Если ПустаяСтрока(Адрес) Тогда
		Возврат "empty-login";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Поступление.Ссылка КАК Ссылка,
	|	Поступление.Номер КАК Номер,
	|	Поступление.АдресЭлектроннойПочты КАК АдресЭлектроннойПочты
	|ИЗ
	|	Документ.ПоступлениеТоваровНаСклад КАК Поступление
	|ГДЕ
	|	Поступление.Проведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	Поступление.Дата УБЫВ,
	|	Поступление.Номер УБЫВ";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "no-posted-document";
	КонецЕсли;

	Если СокрЛП(Выборка.АдресЭлектроннойПочты) = Адрес Тогда
		Возврат "already " + СокрЛП(Выборка.Номер);
	КонецЕсли;

	ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
	ДокументОбъект.ОбменДанными.Загрузка = Истина;
	ДокументОбъект.АдресЭлектроннойПочты = Адрес;
	ДокументОбъект.Записать();
	Возврат "updated " + СокрЛП(Выборка.Номер);

КонецФункции

Процедура ЗаписатьСтатусПодключенияSMTP(Состояние, ДокументСтатус)

	ПарольЗадан = Не ПустаяСтрока(Константы.ПарольSMTP.Получить());
	Если Константы.ИспользоватьSSLSMTP.Получить() Тогда
		SSLТекст = "true";
	Иначе
		SSLТекст = "false";
	КонецЕсли;
	Строки = Новый Массив;
	Строки.Добавить("constants=" + Состояние);
	Строки.Добавить("server=" + СокрЛП(Константы.АдресСервераSMTP.Получить()));
	Строки.Добавить("port=" + Формат(Константы.ПортSMTP.Получить(), "ЧГ=0"));
	Строки.Добавить("login=" + СокрЛП(Константы.ЛогинSMTP.Получить()));
	Строки.Добавить("password_set=" + ?(ПарольЗадан, "yes", "no"));
	Строки.Добавить("ssl=" + SSLТекст);
	Строки.Добавить("document=" + ДокументСтатус);
	Запись = Новый ЗаписьТекста("/tmp/1c-smtp-status.txt", КодировкаТекста.UTF8);
	Запись.Записать(СтрСоединить(Строки, Символы.ПС));
	Запись.Закрыть();

КонецПроцедуры
