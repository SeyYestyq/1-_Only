
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Товары.Количество() = 0 Тогда
		СообщитьОшибку("Для проведения нужна хотя бы одна строка в таблице «Товары».", "Товары");
		Отказ = Истина;
	КонецЕсли;

	ИндексСтроки = 0;
	Для Каждого СтрокаТовары Из Товары Цикл

		НомерСтрокиТаблицы = ИндексСтроки + 1;
		ПутьСтроки = "Товары[" + Формат(ИндексСтроки, "ЧГ=0") + "]";

		Если Не ЗначениеЗаполнено(СтрокаТовары.Товар) Тогда
			СообщитьОшибку(СтрШаблон("В строке %1 не заполнен товар.", НомерСтрокиТаблицы), ПутьСтроки + ".Товар");
			Отказ = Истина;
		КонецЕсли;

		Если СтрокаТовары.Количество <= 0 Или СтрокаТовары.Количество <> Цел(СтрокаТовары.Количество) Тогда
			СообщитьОшибку(
				СтрШаблон("В строке %1 количество должно быть целым числом больше нуля.", НомерСтрокиТаблицы),
				ПутьСтроки + ".Количество");
			Отказ = Истина;
		КонецЕсли;

		ИндексСтроки = ИндексСтроки + 1;

	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// Повторное проведение: старый набор очищается и записывается заново.
	// Отмена проведения удаляет движения свойством документа
	// «Удалять автоматически при отмене проведения».
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОстаткиТоваров.Очистить();

	Для Каждого СтрокаТовары Из Товары Цикл
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Товар = СтрокаТовары.Товар;
		Движение.Количество = СтрокаТовары.Количество;
	КонецЦикла;

КонецПроцедуры

Процедура СообщитьОшибку(Текст, ИмяПоля)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = ИмяПоля;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();

КонецПроцедуры
