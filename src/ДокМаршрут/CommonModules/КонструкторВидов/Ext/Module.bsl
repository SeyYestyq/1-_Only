// Проверка табличных частей «Поля» и «Маршрут» перед публикацией вида.
Функция ПроверитьШаблон(СсылкаВид) Экспорт

	Результат = Новый Структура("Успех, Сообщения", Истина, Новый Массив);
	Если Не ЗначениеЗаполнено(СсылкаВид) Тогда
		Результат.Успех = Ложь;
		Результат.Сообщения.Добавить("Не указан вид документа.");
		Возврат Результат;
	КонецЕсли;

	ВидОбъект = СсылкаВид.ПолучитьОбъект();

	Если ПустаяСтрока(ВидОбъект.Наименование) Тогда
		Результат.Успех = Ложь;
		Результат.Сообщения.Добавить("Укажите наименование вида.");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ВидОбъект.Категория) Тогда
		Результат.Успех = Ложь;
		Результат.Сообщения.Добавить("Укажите категорию вида.");
	КонецЕсли;

	ТекстПрефикса = ТекстОшибкиПрефикса(ВидОбъект);
	Если Не ПустаяСтрока(ТекстПрефикса) Тогда
		Результат.Успех = Ложь;
		Результат.Сообщения.Добавить(ТекстПрефикса);
	КонецЕсли;

	Идентификаторы = Новый Соответствие;
	Для Каждого СтрокаПоля Из ВидОбъект.Поля Цикл
		Если ПустаяСтрока(СтрокаПоля.Идентификатор) Или ПустаяСтрока(СтрокаПоля.Заголовок) Тогда
			Результат.Успех = Ложь;
			Результат.Сообщения.Добавить(
				"В таблице «1. Поля документа» у каждой строки заполните «Заголовок» и «Идентификатор».");
		ИначеЕсли Идентификаторы.Получить(СтрокаПоля.Идентификатор) <> Неопределено Тогда
			Результат.Успех = Ложь;
			Результат.Сообщения.Добавить("Идентификатор поля повторяется: " + СтрокаПоля.Идентификатор + ".");
		Иначе
			Идентификаторы.Вставить(СтрокаПоля.Идентификатор, Истина);
		КонецЕсли;

		Если СтрокаПоля.ТипПоля = Перечисления.ТипыПолей.ВыборИзСписка Тогда
			КоличествоЗначений = КоличествоЗначенийСписка(СсылкаВид, СтрокаПоля.Идентификатор);
			Если КоличествоЗначений < 2 Тогда
				Результат.Успех = Ложь;
				Результат.Сообщения.Добавить(
					"Для поля «" + СтрокаПоля.Заголовок + "» добавьте не меньше двух значений списка.");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ВидОбъект.Поля.Количество() = 0 Тогда
		Результат.Успех = Ложь;
		Результат.Сообщения.Добавить("В таблице «1. Поля документа» добавьте хотя бы одно поле.");
	КонецЕсли;

	НомераЭтапов = Новый Соответствие;
	УникальныеСогласующие = Новый Массив;
	ПредыдущийСогласующий = Неопределено;
	СообщилиПроЭтап = Ложь;
	СообщилиПроСоседей = Ложь;
	Для Каждого СтрокаМаршрута Из ВидОбъект.Маршрут Цикл
		Если СтрокаМаршрута.НомерЭтапа <= 0 Или Не ЗначениеЗаполнено(СтрокаМаршрута.Согласующий) Тогда
			Результат.Успех = Ложь;
			Если Не СообщилиПроЭтап Тогда
				Результат.Сообщения.Добавить(
					"В таблице «2. Маршрут согласования» у каждого этапа укажите номер и согласующего.");
				СообщилиПроЭтап = Истина;
			КонецЕсли;
			ПредыдущийСогласующий = Неопределено;
		ИначеЕсли НомераЭтапов.Получить(СтрокаМаршрута.НомерЭтапа) <> Неопределено Тогда
			Результат.Успех = Ложь;
			Результат.Сообщения.Добавить("Номер этапа повторяется: " + СтрокаМаршрута.НомерЭтапа + ".");
			ПредыдущийСогласующий = СтрокаМаршрута.Согласующий;
		Иначе
			НомераЭтапов.Вставить(СтрокаМаршрута.НомерЭтапа, Истина);
			Если ПредыдущийСогласующий <> Неопределено
				И ЗначениеЗаполнено(ПредыдущийСогласующий)
				И ЗначениеЗаполнено(СтрокаМаршрута.Согласующий)
				И СтрокаМаршрута.Согласующий = ПредыдущийСогласующий Тогда
				Результат.Успех = Ложь;
				Если Не СообщилиПроСоседей Тогда
					Результат.Сообщения.Добавить("Согласующие в соседних этапах не должны совпадать.");
					СообщилиПроСоседей = Истина;
				КонецЕсли;
			КонецЕсли;
			ПредыдущийСогласующий = СтрокаМаршрута.Согласующий;
		КонецЕсли;

		Если ЗначениеЗаполнено(СтрокаМаршрута.Согласующий)
			И УникальныеСогласующие.Найти(СтрокаМаршрута.Согласующий) = Неопределено Тогда
			УникальныеСогласующие.Добавить(СтрокаМаршрута.Согласующий);
		КонецЕсли;
	КонецЦикла;

	Если ВидОбъект.Маршрут.Количество() < 2 Тогда
		Результат.Успех = Ложь;
		Результат.Сообщения.Добавить(
			"В таблице «2. Маршрут согласования» добавьте не меньше двух этапов.");
	ИначеЕсли УникальныеСогласующие.Количество() < 2 Тогда
		Результат.Успех = Ложь;
		Результат.Сообщения.Добавить(
			"В маршруте должно быть не меньше двух разных согласующих.");
	КонецЕсли;

	Если Результат.Успех Тогда
		Результат.Сообщения.Добавить("Шаблон проверен. Нажмите «Опубликовать вид».");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Публикует вид после успешной проверки.
Функция ОпубликоватьВид(СсылкаВид) Экспорт

	Проверка = ПроверитьШаблон(СсылкаВид);
	Если Не Проверка.Успех Тогда
		Если ЗначениеЗаполнено(СсылкаВид) Тогда
			ВидОбъект = СсылкаВид.ПолучитьОбъект();
			Если ВидОбъект.СтатусНастройки <> Перечисления.СтатусыНастройкиВида.Черновик Тогда
				ВидОбъект.СтатусНастройки = Перечисления.СтатусыНастройкиВида.Черновик;
				ВидОбъект.Записать();
			КонецЕсли;
		КонецЕсли;
		Возврат Проверка;
	КонецЕсли;

	ВидОбъект = СсылкаВид.ПолучитьОбъект();
	ВидОбъект.СтатусНастройки = Перечисления.СтатусыНастройкиВида.Готов;
	ВидОбъект.Записать();

	Проверка.Сообщения.Очистить();
	Проверка.Сообщения.Добавить("Вид опубликован. Теперь его можно выбрать в поле «Вид документа».");
	Возврат Проверка;

КонецФункции

Функция ТекстОшибкиПрефикса(ВидОбъект)

	Префикс = СокрЛП(ВидОбъект.Префикс);
	Если ПустаяСтрока(Префикс) Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВидыДокументов.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ВидыДокументов КАК ВидыДокументов
	|ГДЕ
	|	ВидыДокументов.Префикс = &Префикс
	|	И ВидыДокументов.Ссылка <> &Ссылка
	|	И ВидыДокументов.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Префикс", Префикс);
	Запрос.УстановитьПараметр("Ссылка", ВидОбъект.Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат "Префикс «" + Префикс + "» уже занят видом «" + Выборка.Наименование
			+ "»: номера документов пересекутся.";
	КонецЕсли;

	Возврат "";

КонецФункции

Функция КоличествоЗначенийСписка(ВидСсылка, ИдентификаторПоля)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(ЗначенияПолей.Ссылка) КАК Количество
	|ИЗ
	|	Справочник.ЗначенияПолей КАК ЗначенияПолей
	|ГДЕ
	|	ЗначенияПолей.Владелец = &Вид
	|	И ЗначенияПолей.ИдентификаторПоля = &ИдентификаторПоля";
	Запрос.УстановитьПараметр("Вид", ВидСсылка);
	Запрос.УстановитьПараметр("ИдентификаторПоля", ИдентификаторПоля);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	Возврат 0;

КонецФункции
