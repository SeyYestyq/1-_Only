#Область ПрограммныйИнтерфейс

// Передает уведомление после фиксации транзакции согласования.
// ДокументСсылка - ДокументСсылка.ДокументСЭД.
// Событие - Строка. Комментарий - Строка.
Процедура ОтправитьПоСобытию(ДокументСсылка, Событие, Комментарий = "") Экспорт

	ПриСменеСтатуса(ДокументСсылка, Событие, Комментарий);

КонецПроцедуры

// Запускает рассылку о сохраненном статусе; файловая база выполняет ее синхронно.
// ДокументСсылка - ДокументСсылка.ДокументСЭД.
// Событие - Строка. Комментарий - Строка.
Процедура ПриСменеСтатуса(ДокументСсылка, Событие, Комментарий = "") Экспорт

	Если ТранзакцияАктивна() Тогда
		Возврат;
	КонецЕсли;
	Попытка
		СтрокаСоединения = ВРег(СтрокаСоединенияИнформационнойБазы());
		Если СтрНачинаетсяС(СтрокаСоединения, "FILE=") Тогда
			ДоставитьУведомление(ДокументСсылка, Событие, Комментарий);
		Иначе
			Параметры = Новый Массив;
			Параметры.Добавить(ДокументСсылка);
			Параметры.Добавить(Событие);
			Параметры.Добавить(Комментарий);
			ФоновыеЗадания.Выполнить("Уведомления.ДоставитьУведомление", Параметры, , "Почта ДокМаршрут");
		КонецЕсли;
	Исключение
		ЗаписатьВЖурнал(ДокументСсылка, "", Событие, Ложь,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Формирует вложение и выполняет отправку получателям, в том числе из фонового задания.
// ДокументСсылка - ДокументСсылка.ДокументСЭД.
// Событие - Строка. Комментарий - Строка.
Процедура ДоставитьУведомление(ДокументСсылка, Событие, Комментарий) Экспорт

	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	Получатели = СотрудникиДляУведомления(ДокументОбъект);
	ОповеститьВСистемеВзаимодействия(ДокументОбъект, Получатели, Событие);
	Если Получатели.Количество() = 0 Тогда
		ЗаписатьВЖурнал(ДокументСсылка, "", Событие, Ложь, "Не определен ответственный за документ.");
		Возврат;
	КонецЕсли;

	ИмяФайлаВложения = "";
	Попытка
		Вложение = ПечатьДокументов.СформироватьВложениеПечатнойФормы(ДокументСсылка);
		Если Вложение.Успех Тогда
			ИмяФайлаВложения = Вложение.ИмяФайла;
		КонецЕсли;

		ТемаИТекст = СформироватьТемаИТекст(ДокументСсылка, Событие, Комментарий, Вложение);
		ИмяВложения = ТемаИТекст.ИмяВложения;
		Если Вложение.Успех И Не ПустаяСтрока(Вложение.ИмяФайлаКлиент) Тогда
			ИмяВложения = Вложение.ИмяФайлаКлиент;
		КонецЕсли;

		ОтправленныеАдреса = Новый Массив;
		Для Каждого Сотрудник Из Получатели Цикл
			Адрес = EmailСотрудника(Сотрудник);
			Если ПустаяСтрока(Адрес) Тогда
				ЗаписатьВЖурнал(ДокументСсылка, Адрес, Событие, Ложь, "У сотрудника не указан Email");
				Продолжить;
			КонецЕсли;
			КлючАдреса = НРег(Адрес);
			Если ОтправленныеАдреса.Найти(КлючАдреса) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ОтправленныеАдреса.Добавить(КлючАдреса);
			Если Не Вложение.Успех Тогда
				ЗаписатьВЖурнал(ДокументСсылка, Адрес, Событие, Ложь, Вложение.Текст);
				Продолжить;
			КонецЕсли;
			ОтправитьИЗаписатьПисьмоДокумента(ДокументСсылка, Адрес, Событие,
				ТемаИТекст, ИмяФайлаВложения, ИмяВложения);
		КонецЦикла;
	Исключение
		ЗаписатьВЖурнал(
			ДокументСсылка,
			"",
			Событие,
			Ложь,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Не ПустаяСтрока(ИмяФайлаВложения) Тогда
		Попытка
			УдалитьФайлы(ИмяФайлаВложения);
		Исключение
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

// Отправляет проверочное письмо и регистрирует результат.
// АдресПолучателя - Строка. По умолчанию адрес отправителя.
// Возвращаемое значение - Структура, Успех и Текст.
Функция ПроверитьОтправку(АдресПолучателя = "") Экспорт

	ПроверитьДоступКНастройкамSMTP();

	Результат = Новый Структура("Успех, Текст", Ложь, "");
	Адрес = СокрЛП(АдресПолучателя);
	Если ПустаяСтрока(Адрес) Тогда
		Адрес = СокрЛП(Константы.АдресОтправителя.Получить());
	КонецЕсли;
	Если ПустаяСтрока(Адрес) Тогда
		Результат.Текст =
			"Укажите адрес отправителя в блоке «Отправитель» или email получателя.";
		Возврат Результат;
	КонецЕсли;

	Тема = "ДокМаршрут: проверка почты";
	Текст = "Тестовое письмо. Если оно пришло, почта настроена.";
	Отправка = ОтправитьПисьмо(Адрес, Тема, Текст, Неопределено, "");
	ЗаписатьВЖурнал(Документы.ДокументСЭД.ПустаяСсылка(), Адрес, "Проверка SMTP",
		Отправка.Успех, Отправка.ТекстОшибки);
	Результат.Успех = Отправка.Успех;
	Если Отправка.Успех Тогда
		Результат.Текст = "Тестовое письмо отправлено на " + Адрес + ".";
	Иначе
		Результат.Текст = Отправка.ТекстОшибки;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Отправляет печатную форму выбранному адресу или участникам документа.
// ДокументСсылка - ДокументСсылка.ДокументСЭД. АдресПолучателя - Строка.
// Возвращаемое значение - Структура, Успех и Текст.
Функция ОтправитьПечатнуюФормуДокумента(ДокументСсылка, АдресПолучателя = "") Экспорт

	Результат = Новый Структура("Успех, Текст", Ложь, "");
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Результат.Текст = "Сначала запишите документ.";
		Возврат Результат;
	КонецЕсли;

	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	ПолучателиАдреса = Новый Массив;
	ОписаниеКому = Новый Массив;

	АдресЯвный = СокрЛП(АдресПолучателя);
	Если Не ПустаяСтрока(АдресЯвный) Тогда
		ПолучателиАдреса.Добавить(АдресЯвный);
		ОписаниеКому.Добавить(АдресЯвный);
	Иначе
		ДобавитьАдресПолучателяФормы(ПолучателиАдреса, ОписаниеКому, ДокументОбъект.Ответственный, "ответственный");
		ДобавитьАдресПолучателяФормы(ПолучателиАдреса, ОписаниеКому,
			ПечатьДокументов.РуководительОтветственного(ДокументОбъект), "руководитель");
	КонецЕсли;

	Если ПолучателиАдреса.Количество() = 0 Тогда
		Результат.Текст =
			"Нет получателей. В блоке «Кто участвует» заполните «Ответственный» "
			+ "или «Руководитель» и укажите Email в карточке сотрудника. "
			+ "Автор письма не получает.";
		Возврат Результат;
	КонецЕсли;

	Вложение = ПечатьДокументов.СформироватьВложениеПечатнойФормы(ДокументСсылка);
	Если Не Вложение.Успех Тогда
		Результат.Текст = Вложение.Текст;
		Возврат Результат;
	КонецЕсли;

	ТемаИТекст = СформироватьТемаИТекст(ДокументСсылка, "ПечатнаяФорма", "", Вложение);
	ИмяВложения = ?(ПустаяСтрока(Вложение.ИмяФайлаКлиент), ТемаИТекст.ИмяВложения, Вложение.ИмяФайлаКлиент);

	Успехов = 0;
	Ошибки = Новый Массив;
	Для Каждого Адрес Из ПолучателиАдреса Цикл
		Отправка = ОтправитьИЗаписатьПисьмоДокумента(ДокументСсылка, Адрес, "ПечатнаяФорма",
			ТемаИТекст, Вложение.ИмяФайла, ИмяВложения);
		Если Отправка.Успех Тогда
			Успехов = Успехов + 1;
		Иначе
			Ошибки.Добавить(Адрес + ": " + Отправка.ТекстОшибки);
		КонецЕсли;
	КонецЦикла;

	Если Не ПустаяСтрока(Вложение.ИмяФайла) Тогда
		Попытка
			УдалитьФайлы(Вложение.ИмяФайла);
		Исключение
		КонецПопытки;
	КонецЕсли;

	КомуТекст = СтрСоединить(ОписаниеКому, "; ");
	Результат.Успех = Успехов > 0;
	Если Результат.Успех Тогда
		Результат.Текст = СтрШаблон("Письмо отправлено (%1): %2.", Вложение.ФорматВложения, КомуТекст);
		Если Ошибки.Количество() > 0 Тогда
			Результат.Текст = Результат.Текст + Символы.ПС
				+ "Часть адресов не приняла письмо: " + СтрСоединить(Ошибки, "; ");
		КонецЕсли;
	Иначе
		Результат.Текст = "Письмо не отправлено." + Символы.ПС + СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Возвращает подсказку о получателях писем для карточки документа.
// ДокументОбъект - ДокументОбъект.ДокументСЭД.
// Возвращаемое значение - Строка.
Функция ТекстКомуУходятПисьма(ДокументОбъект) Экспорт

	Части = Новый Массив;
	Если ЗначениеЗаполнено(ДокументОбъект.Ответственный) Тогда
		Адрес = EmailСотрудника(ДокументОбъект.Ответственный);
		Если ПустаяСтрока(Адрес) Тогда
			Части.Добавить(Строка(ДокументОбъект.Ответственный) + " (нет Email)");
		Иначе
			Части.Добавить(Строка(ДокументОбъект.Ответственный) + " <" + Адрес + ">");
		КонецЕсли;
	КонецЕсли;
	Руководитель = ПечатьДокументов.РуководительОтветственного(ДокументОбъект);
	Если ЗначениеЗаполнено(Руководитель) И Руководитель <> ДокументОбъект.Ответственный Тогда
		Адрес = EmailСотрудника(Руководитель);
		Метка = Строка(Руководитель);
		Если ПустаяСтрока(Адрес) Тогда
			Части.Добавить(Метка + " (нет Email)");
		ИначеЕсли Части.Найти(Метка + " <" + Адрес + ">") = Неопределено Тогда
			Части.Добавить(Метка + " <" + Адрес + ">");
		КонецЕсли;
	КонецЕсли;

	Если Части.Количество() = 0 Тогда
		Возврат "Письма уйдут ответственному и руководителю. "
			+ "Заполните поля выше и Email в карточке сотрудника. Автор письма не получает.";
	КонецЕсли;
	Возврат "Письма: " + СтрСоединить(Части, "; ") + ". Автор письма не получает.";

КонецФункции

// Записывает настройки SMTP. Пустой пароль оставляет сохраненный пароль.
// Настройки - Структура, параметры сервера и отправителя.
Процедура ЗаписатьНастройкиSMTP(Настройки) Экспорт

	ПроверитьДоступКНастройкамSMTP();
	Если ПустаяСтрока(Настройки.АдресSMTP) Или Настройки.ПортSMTP < 1
		Или Настройки.ПортSMTP > 65535 Или Настройки.ТаймаутSMTP < 1
		Или Не ПочтовыйАдресДопустим(СокрЛП(Настройки.АдресОтправителя)) Тогда
		ВызватьИсключение "Укажите сервер, допустимый порт, положительный таймаут и адрес отправителя.";
	КонецЕсли;

	Константы.АдресSMTP.Установить(СокрЛП(Настройки.АдресSMTP));
	Константы.ПортSMTP.Установить(Настройки.ПортSMTP);
	Константы.ИспользоватьSSL.Установить(Настройки.ИспользоватьSSL);
	Константы.ЛогинSMTP.Установить(СокрЛП(Настройки.ЛогинSMTP));
	Если Не ПустаяСтрока(Настройки.ПарольSMTP) Тогда
		Константы.ПарольSMTP.Установить(Настройки.ПарольSMTP);
	КонецЕсли;
	Константы.АдресОтправителя.Установить(СокрЛП(Настройки.АдресОтправителя));
	Константы.ТаймаутSMTP.Установить(Настройки.ТаймаутSMTP);
	Если Настройки.Свойство("Автоповтор") Тогда
		НастроитьРасписаниеПовторов(Настройки.Автоповтор);
	КонецЕсли;

КонецПроцедуры

// Возвращает настройки SMTP для формы администратора.
// Возвращаемое значение - Структура, параметры сервера и отправителя.
Функция ПрочитатьНастройкиSMTP() Экспорт

	ПроверитьДоступКНастройкамSMTP();

	Настройки = Новый Структура;
	Настройки.Вставить("АдресSMTP", Константы.АдресSMTP.Получить());
	Настройки.Вставить("ПортSMTP", Константы.ПортSMTP.Получить());
	Настройки.Вставить("ИспользоватьSSL", Константы.ИспользоватьSSL.Получить());
	Настройки.Вставить("ЛогинSMTP", Константы.ЛогинSMTP.Получить());
	Настройки.Вставить("АдресОтправителя", Константы.АдресОтправителя.Получить());
	Настройки.Вставить("ТаймаутSMTP", Константы.ТаймаутSMTP.Получить());
	Настройки.Вставить("ПарольЗадан", Не ПустаяСтрока(Константы.ПарольSMTP.Получить()));
	Задание = ЗаданиеПовторнойОтправки();
	Настройки.Вставить("Автоповтор", Задание <> Неопределено И Задание.Использование);
	Возврат Настройки;

КонецФункции

// Возвращает сохранённый пароль SMTP для показа администратору в форме настроек.
// Возвращаемое значение - Строка.
Функция ПрочитатьПарольSMTP() Экспорт

	ПроверитьДоступКНастройкамSMTP();
	Возврат Константы.ПарольSMTP.Получить();

КонецФункции

// Повторяет выбранную неудачную попытку с исходным письмом и вложением.
// КлючПопытки - Структура, измерения записи журнала уведомлений.
// Возвращаемое значение - Структура, Успех и Текст.
Функция ПовторитьПоЗаписиЖурнала(КлючПопытки) Экспорт

	ПроверитьДоступКНастройкамSMTP();
	Возврат ПовторитьПопытку(КлючПопытки, Истина);

КонецФункции

// Обрабатывает до 10 писем, для которых наступило время повторной отправки.
Процедура ОбработатьОчередьПовторов() Экспорт

	ПроверитьДоступКНастройкамSMTP();
	Если ПустаяСтрока(Константы.АдресSMTP.Получить()) Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 10
	|	Журнал.Документ КАК Документ,
	|	Журнал.ДатаВремя КАК ДатаВремя,
	|	Журнал.Получатель КАК Получатель,
	|	Журнал.Канал КАК Канал,
	|	Журнал.ИдентификаторПопытки КАК ИдентификаторПопытки
	|ИЗ РегистрСведений.ЖурналУведомлений КАК Журнал
	|ГДЕ Журнал.Канал = &Канал
	|	И НЕ Журнал.Успешно
	|	И НЕ Журнал.ВОтправке
	|	И Журнал.ПовторитьПосле > ДАТАВРЕМЯ(1, 1, 1)
	|	И Журнал.ПовторитьПосле <= &Сейчас
	|	И Журнал.Попытка < &МаксимумПопыток
	|УПОРЯДОЧИТЬ ПО Журнал.ПовторитьПосле, Журнал.ИдентификаторПопытки");
	Запрос.УстановитьПараметр("Канал", Перечисления.КаналыУведомлений.ЭлектроннаяПочта);
	Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("МаксимумПопыток", МаксимумАвтоматическихПопыток());
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = Новый Структура("Документ, ДатаВремя, Получатель, Канал, ИдентификаторПопытки");
		ЗаполнитьЗначенияСвойств(Ключ, Выборка);
		Попытка
			ПовторитьПопытку(Ключ, Ложь);
		Исключение
			ЗаписьЖурналаРегистрации("ДокМаршрут.ПовторПочты", УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы.ДокументСЭД, Ключ.Документ,
				ТекстОшибкиОтправки(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СотрудникиДляУведомления(ДокументОбъект)

	Получатели = Новый Массив;
	Если ЗначениеЗаполнено(ДокументОбъект.Ответственный) Тогда
		Получатели.Добавить(ДокументОбъект.Ответственный);
	КонецЕсли;
	Руководитель = ПечатьДокументов.РуководительОтветственного(ДокументОбъект);
	Если ЗначениеЗаполнено(Руководитель) И Получатели.Найти(Руководитель) = Неопределено Тогда
		Получатели.Добавить(Руководитель);
	КонецЕсли;
	Возврат Получатели;

КонецФункции

Процедура ОповеститьВСистемеВзаимодействия(ДокументОбъект, Получатели, Событие)

	Канал = Перечисления.КаналыУведомлений.СистемаВзаимодействия;
	Попытка
		Если Не СистемаВзаимодействия.ИнформационнаяБазаЗарегистрирована() Тогда
			Возврат;
		КонецЕсли;
		Если Получатели.Количество() = 0 Тогда
			ЗаписатьВЖурнал(ДокументОбъект.Ссылка, "", Событие, Ложь,
				"Не определен ответственный за документ.", , Канал);
			Возврат;
		КонецЕсли;
		Автор = СистемаВзаимодействия.ИдентификаторТекущегоПользователя();
		Текст = ТекстОповещенияВСистемеВзаимодействия(ДокументОбъект, Событие);
	Исключение
		ЗаписатьВЖурнал(ДокументОбъект.Ссылка, "", Событие, Ложь,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), , Канал);
		Возврат;
	КонецПопытки;

	Оповещенные = Новый Массив;
	Для Каждого Сотрудник Из Получатели Цикл
		ПолучательЖурнала = Строка(Сотрудник);
		Попытка
			Логин = СокрЛП(Сотрудник.ИмяПользователяИБ);
			Если Не ПустаяСтрока(Логин) Тогда
				ПолучательЖурнала = Логин;
			КонецЕсли;
			Адресат = ПолучательВСистемеВзаимодействия(Логин);
			Если Оповещенные.Найти(Адресат) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ОтправитьСообщениеВСистемеВзаимодействия(Автор, Адресат, Текст);
			Оповещенные.Добавить(Адресат);
			ЗаписатьВЖурнал(ДокументОбъект.Ссылка, ПолучательЖурнала, Событие, Истина, "", , Канал);
		Исключение
			ЗаписатьВЖурнал(ДокументОбъект.Ссылка, ПолучательЖурнала, Событие, Ложь,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), , Канал);
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Функция ПолучательВСистемеВзаимодействия(Логин)

	Если ПустаяСтрока(Логин) Тогда
		ВызватьИсключение "В карточке сотрудника не указано имя пользователя ИБ.";
	КонецЕсли;
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Логин);
	Если ПользовательИБ = Неопределено Тогда
		ВызватьИсключение "Пользователь информационной базы не найден.";
	КонецЕсли;
	Возврат СистемаВзаимодействия.ПолучитьИдентификаторПользователя(ПользовательИБ.УникальныйИдентификатор);

КонецФункции

Функция ТекстОповещенияВСистемеВзаимодействия(ДокументОбъект, Событие)

	Текст = СтрШаблон("%1 № %2: %3", Строка(ДокументОбъект.ВидДокумента),
		СокрЛП(ДокументОбъект.Номер), Строка(ДокументОбъект.Статус));
	Текст = Текст + Символы.ПС + "Событие: " + ПредставлениеСобытияПисьма(Событие);
	Если ДокументОбъект.ВсегоЭтапов > 0 Тогда
		НомерЭтапа = ?(ДокументОбъект.ТекущийЭтап > 0,
			ДокументОбъект.ТекущийЭтап, ДокументОбъект.ВсегоЭтапов);
		Текст = Текст + Символы.ПС + СтрШаблон("Этап: %1 из %2", НомерЭтапа, ДокументОбъект.ВсегоЭтапов);
	КонецЕсли;
	Возврат Текст + Символы.ПС + "Документ: " + ПолучитьНавигационнуюСсылку(ДокументОбъект.Ссылка);

КонецФункции

Процедура ОтправитьСообщениеВСистемеВзаимодействия(Автор, Адресат, Текст)

	// Отдельный диалог для пары пользователей исключает рассылку в общий чат.
	Ключ = "ДокМаршрут:" + Строка(Автор) + ":" + Строка(Адресат);
	Обсуждение = СистемаВзаимодействия.ПолучитьОбсуждение(Ключ);
	Если Обсуждение = Неопределено Тогда
		Обсуждение = СистемаВзаимодействия.СоздатьОбсуждение();
		Обсуждение.Ключ = Ключ;
		Обсуждение.Групповое = Автор = Адресат;
		Обсуждение.Участники.Добавить(Автор);
		Если Автор <> Адресат Тогда
			Обсуждение.Участники.Добавить(Адресат);
		Иначе
			Обсуждение.Заголовок = "ДокМаршрут: мои уведомления";
		КонецЕсли;
		Обсуждение.Записать();
	КонецЕсли;
	ПроверитьУчастниковОбсуждения(Обсуждение, Автор, Адресат);
	Сообщение = СистемаВзаимодействия.СоздатьСообщение(Обсуждение.Идентификатор);
	Сообщение.Автор = Автор;
	Сообщение.Получатели.Добавить(Адресат);
	Сообщение.Текст = Новый ФорматированнаяСтрока(Текст);
	Сообщение.Записать();

КонецПроцедуры

Процедура ПроверитьУчастниковОбсуждения(Обсуждение, Автор, Адресат)

	ЕстьАвтор = Ложь;
	ЕстьАдресат = Ложь;
	Для Каждого Участник Из Обсуждение.Участники Цикл
		Если Участник <> Автор И Участник <> Адресат Тогда
			ВызватьИсключение "В обсуждении уведомлений есть посторонний участник.";
		КонецЕсли;
		ЕстьАвтор = ЕстьАвтор Или Участник = Автор;
		ЕстьАдресат = ЕстьАдресат Или Участник = Адресат;
	КонецЦикла;
	Если Не ЕстьАвтор Или Не ЕстьАдресат Тогда
		ВызватьИсключение "Получатель или отправитель отсутствует в обсуждении уведомлений.";
	КонецЕсли;

КонецПроцедуры

Функция ЗаданиеПовторнойОтправки()

	Отбор = Новый Структура("Метаданные", Метаданные.РегламентныеЗадания.ПовторнаяОтправкаУведомлений);
	Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания(Отбор);
	Возврат ?(Задания.Количество() = 0, Неопределено, Задания[0]);

КонецФункции

Процедура НастроитьРасписаниеПовторов(Включить)

	Задание = ЗаданиеПовторнойОтправки();
	Если Задание = Неопределено И Не Включить Тогда
		Возврат;
	КонецЕсли;
	Если Задание = Неопределено Тогда
		Задание = РегламентныеЗадания.СоздатьРегламентноеЗадание(
			Метаданные.РегламентныеЗадания.ПовторнаяОтправкаУведомлений);
	КонецЕсли;
	Если Задание.Использование = Включить Тогда
		Возврат;
	КонецЕсли;
	Если Включить Тогда
		Расписание = Новый РасписаниеРегламентногоЗадания;
		Расписание.ПериодПовтораДней = 1;
		Расписание.ПериодПовтораВТечениеДня = 60 * 5;
		Задание.Расписание = Расписание;
		Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
		Если Пользователь <> Неопределено Тогда
			Задание.ИмяПользователя = Пользователь.Имя;
		КонецЕсли;
	КонецЕсли;
	Задание.Использование = Включить;
	Задание.Записать();

КонецПроцедуры

Функция МаксимумАвтоматическихПопыток()

	// Две автоматические повторные отправки после первоначальной попытки.
	Возврат 3;

КонецФункции

Функция ОтправитьИЗаписатьПисьмоДокумента(ДокументСсылка, Адрес, Событие,
	ТемаИТекст, ПутьВложения, ИмяВложения)

	Письмо = Новый Структура("Тема, Текст, ДанныеВложения, ИмяВложения",
		ТемаИТекст.Тема, ТемаИТекст.Текст, Новый ДвоичныеДанные(ПутьВложения), ИмяВложения);
	Отправка = ОтправитьСохраненноеПисьмо(Адрес, Письмо);
	ПисьмоДляПовтора = ?(ПочтовыйАдресДопустим(Адрес), Письмо, Неопределено);
	ЗаписатьВЖурнал(ДокументСсылка, Адрес, Событие,
		Отправка.Успех, Отправка.ТекстОшибки, ПисьмоДляПовтора);
	Возврат Отправка;

КонецФункции

Функция ОтправитьСохраненноеПисьмо(Адрес, Письмо)

	Возврат ОтправитьПисьмо(Адрес, Письмо.Тема, Письмо.Текст, Письмо.ДанныеВложения,
		Письмо.ИмяВложения, Истина);

КонецФункции

Функция ПовторитьПопытку(Ключ, РучнойЗапуск)

	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение "Повторную отправку нужно запускать вне транзакции.";
	КонецЕсли;
	Если Ключ.Канал <> Перечисления.КаналыУведомлений.ЭлектроннаяПочта
		Или ПустаяСтрока(Ключ.ИдентификаторПопытки) Тогда
		Возврат Новый Структура("Успех, Текст", Ложь, "У этой записи нет письма для повторной отправки.");
	КонецЕсли;
	ПопыткаПочты = ВзятьПопыткуВРаботу(Ключ, РучнойЗапуск);
	Если ПопыткаПочты = Неопределено Тогда
		Возврат Новый Структура("Успех, Текст", Ложь,
			"Эта попытка уже обработана, выполняется или не содержит исходного письма.");
	КонецЕсли;

	// SMTP выполняется вне транзакции и после сохранения отметки о захвате.
	Результат = ОтправитьСохраненноеПисьмо(Ключ.Получатель, ПопыткаПочты.Письмо);
	НачатьТранзакцию();
	Попытка
		Запись = ПрочитатьПопытку(Ключ);
		Запись.ДанныеПовтора = Новый ХранилищеЗначения(Неопределено);
		Запись.ПовторитьПосле = Дата(1, 1, 1);
		Запись.ВОтправке = Ложь;
		Запись.Записать();
		СохранитьПопытку(Ключ.Документ, Ключ.Получатель, ПопыткаПочты.Событие, Результат.Успех,
			Результат.ТекстОшибки, ПопыткаПочты.Письмо, ПопыткаПочты.Номер);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Если Не Результат.Успех Тогда
		ЗаписьЖурналаРегистрации("ДокМаршрут.ПовторПочты", УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ДокументСЭД, Ключ.Документ, Результат.ТекстОшибки);
	КонецЕсли;
	Возврат Новый Структура("Успех, Текст", Результат.Успех,
		?(Результат.Успех, "Письмо отправлено повторно.", Результат.ТекстОшибки));

КонецФункции

Функция ВзятьПопыткуВРаботу(Ключ, РучнойЗапуск)

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.ЖурналУведомлений");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Для Каждого Измерение Из Ключ Цикл
			Элемент.УстановитьЗначение(Измерение.Ключ, Измерение.Значение);
		КонецЦикла;
		Блокировка.Заблокировать();
		Запись = ПрочитатьПопытку(Ключ);
		Письмо = Неопределено;
		Если Запись.Выбран() И Не Запись.Успешно И Не Запись.ВОтправке
			И ЗначениеЗаполнено(Запись.ПовторитьПосле)
			И (РучнойЗапуск Или (Запись.ПовторитьПосле <= ТекущаяДатаСеанса()
				И Запись.Попытка < МаксимумАвтоматическихПопыток())) Тогда
			Если ТипЗнч(Запись.ДанныеПовтора) = Тип("ХранилищеЗначения") Тогда
				Письмо = Запись.ДанныеПовтора.Получить();
			КонецЕсли;
		КонецЕсли;
		Результат = Неопределено;
		Если ТипЗнч(Письмо) = Тип("Структура") Тогда
			Запись.ВОтправке = Истина;
			Запись.Записать();
			Результат = Новый Структура("Письмо, Событие, Номер", Письмо,
				Запись.Событие, Запись.Попытка + 1);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;

КонецФункции

Функция ПрочитатьПопытку(Ключ)

	Запись = РегистрыСведений.ЖурналУведомлений.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(Запись, Ключ);
	Запись.Прочитать();
	Возврат Запись;

КонецФункции


Процедура ПроверитьДоступКНастройкамSMTP()

	Если Не РольДоступна("ПолныеПрава") Тогда
		ВызватьИсключение "Настройки почты доступны только администратору.";
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьАдресПолучателяФормы(ПолучателиАдреса, ОписаниеКому, СотрудникСсылка, РольТекст)

	Если Не ЗначениеЗаполнено(СотрудникСсылка) Тогда
		Возврат;
	КонецЕсли;
	Адрес = EmailСотрудника(СотрудникСсылка);
	Если ПустаяСтрока(Адрес) Тогда
		Возврат;
	КонецЕсли;
	Если ПолучателиАдреса.Найти(НРег(Адрес)) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолучателиАдреса.Добавить(НРег(Адрес));
	ОписаниеКому.Добавить(РольТекст + " " + Строка(СотрудникСсылка) + " <" + Адрес + ">");

КонецПроцедуры

Функция СформироватьТемаИТекст(ДокументСсылка, Событие, Комментарий, Вложение = Неопределено)

	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	ВидТекст = Строка(ДокументОбъект.ВидДокумента);
	НомерТекст = СокрЛП(ДокументОбъект.Номер);
	СтатусТекст = Строка(ДокументОбъект.Статус);
	ЭтапТекст = "—";
	Если ДокументОбъект.ВсегоЭтапов > 0 Тогда
		ЭтапНомер = ?(ДокументОбъект.ТекущийЭтап = 0, ДокументОбъект.ВсегоЭтапов, ДокументОбъект.ТекущийЭтап);
		ЭтапТекст = СтрШаблон("%1 из %2", ЭтапНомер, ДокументОбъект.ВсегоЭтапов);
	КонецЕсли;

	Тема = СтрШаблон("%1 № %2: %3", ВидТекст, НомерТекст, СтатусТекст);

	ФорматВложения = "PDF";
	Если ТипЗнч(Вложение) = Тип("Структура") И Вложение.Свойство("ФорматВложения")
		И Не ПустаяСтрока(Вложение.ФорматВложения) Тогда
		ФорматВложения = Вложение.ФорматВложения;
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("Документ: %1 № %2 от %3", ВидТекст, НомерТекст, Формат(ДокументОбъект.Дата, "ДЛФ=D")));
	Строки.Добавить("Статус: " + СтатусТекст);
	Строки.Добавить("Этап: " + ЭтапТекст);
	Строки.Добавить("Событие: " + ПредставлениеСобытияПисьма(Событие));
	Если ЗначениеЗаполнено(ДокументОбъект.ТекущийСогласующий) Тогда
		Строки.Добавить("Сейчас согласует: " + Строка(ДокументОбъект.ТекущийСогласующий));
	КонецЕсли;
	История = Согласование.ИсторияДляКарточки(ДокументСсылка);
	Если История.Количество() > 0 И Событие <> "ПечатнаяФорма" Тогда
		ПоследнееРешение = История[История.Количество() - 1];
		Строки.Добавить("Решение принял: " + ПоследнееРешение.Сотрудник);
	КонецЕсли;
	Если Не ПустаяСтрока(Комментарий) Тогда
		Строки.Добавить("Комментарий: " + Комментарий);
	КонецЕсли;
	Попытка
		Строки.Добавить("Ссылка: " + ПолучитьНавигационнуюСсылку(ДокументСсылка));
	Исключение
	КонецПопытки;
	Строки.Добавить("");
	Если ФорматВложения = "HTML" Тогда
		Строки.Добавить("Во вложении печатная форма (HTML). На учебной версии PDF недоступен.");
	Иначе
		Строки.Добавить("Во вложении печатная форма (PDF).");
	КонецЕсли;

	ИмяВложения = СтрШаблон("%1_%2.%3", НомерТекст, СтрЗаменить(ВидТекст, " ", "_"), НРег(ФорматВложения));
	Возврат Новый Структура("Тема, Текст, ИмяВложения", Тема, ТекстПисьмаHTML(Строки), ИмяВложения);

КонецФункции

Функция ПредставлениеСобытияПисьма(Событие)

	Ключ = СокрЛП(Строка(Событие));
	Если Ключ = "ПечатнаяФорма" Тогда
		Возврат "Отправка печатной формы";
	ИначеЕсли Ключ = "ОтправленНаСогласование" Тогда
		Возврат "Отправлен на согласование";
	ИначеЕсли Ключ = "Согласовано" Тогда
		Возврат "Согласовано";
	ИначеЕсли Ключ = "Отклонено" Тогда
		Возврат "Отклонено";
	ИначеЕсли Ключ = "ВозвращенНаДоработку" Тогда
		Возврат "Возвращён на доработку";
	КонецЕсли;
	Возврат Ключ;

КонецФункции

Функция ОтправитьПисьмо(АдресПолучателя, Тема, Текст, ДанныеВложения, ИмяВложения, ЭтоHTML = Ложь)

	Результат = Новый Структура("Успех, ТекстОшибки", Ложь, "");
	Если Не ПочтовыйАдресДопустим(АдресПолучателя) Тогда
		Результат.ТекстОшибки = "Некорректный адрес получателя.";
		Возврат Результат;
	КонецЕсли;
	Если Не ПочтовыйАдресДопустим(Константы.АдресОтправителя.Получить()) Тогда
		Результат.ТекстОшибки = "Укажите корректный адрес отправителя в настройках почты.";
		Возврат Результат;
	КонецЕсли;
	Если Константы.ПортSMTP.Получить() <= 0 Или Константы.ТаймаутSMTP.Получить() <= 0 Тогда
		Результат.ТекстОшибки = "Укажите порт и положительный таймаут в настройках почты.";
		Возврат Результат;
	КонецЕсли;
	Если ПустаяСтрока(Константы.АдресSMTP.Получить()) Тогда
		Результат.ТекстОшибки = "Не заполнены настройки почты. Откройте «Настройки почты» в разделе «Сервис».";
		Возврат Результат;
	КонецЕсли;

	Почта = Неопределено;
	Попытка
		Профиль = ПрофильSMTP();
		Письмо = Новый ИнтернетПочтовоеСообщение;
		Письмо.Получатели.Добавить(АдресПолучателя);
		Письмо.Отправитель = Константы.АдресОтправителя.Получить();
		Письмо.Тема = Тема;
		Если ЭтоHTML Тогда
			Письмо.Тексты.Добавить(Текст, ТипТекстаПочтовогоСообщения.HTML);
		Иначе
			Письмо.Тексты.Добавить(Текст);
		КонецЕсли;

		Если ДанныеВложения <> Неопределено Тогда
			Письмо.Вложения.Добавить(ДанныеВложения, ИмяВложения);
		КонецЕсли;

		Почта = Новый ИнтернетПочта;
		Почта.Подключиться(Профиль);
		Почта.Послать(Письмо);
		Результат.Успех = Истина;
	Исключение
		Результат.ТекстОшибки = ТекстОшибкиОтправки(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Почта <> Неопределено Тогда
		Попытка
			Почта.Отключиться();
		Исключение
		КонецПопытки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПочтовыйАдресДопустим(Адрес)

	Если СтрДлина(Адрес) > 150 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайтиПоРегулярномуВыражению(Адрес,
		"\A[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+\z").НачальнаяПозиция > 0;

КонецФункции

Функция ТекстПисьмаHTML(Строки)

	Абзацы = Новый Массив;
	Для Каждого СтрокаПисьма Из Строки Цикл
		Текст = СтрЗаменить(СтрокаПисьма, "&", "&amp;");
		Текст = СтрЗаменить(Текст, "<", "&lt;");
		Текст = СтрЗаменить(Текст, ">", "&gt;");
		Абзацы.Добавить("<p>" + Текст + "</p>");
	КонецЦикла;
	Возврат "<html><body>" + СтрСоединить(Абзацы, Символы.ПС) + "</body></html>";

КонецФункции

Функция ТекстОшибкиОтправки(ТекстПлатформы)

	Текст = СокрЛП(Строка(ТекстПлатформы));
	Пароль = Константы.ПарольSMTP.Получить();
	Если Не ПустаяСтрока(Пароль) Тогда
		Текст = СтрЗаменить(Текст, Пароль, "[скрыто]");
	КонецЕсли;
	Если ПустаяСтрока(Текст) Тогда
		Возврат "Не удалось отправить письмо.";
	КонецЕсли;

	Если СтрНачинаетсяС(ВРег(Текст), "НЕ УДАЛОСЬ")
		Или СтрНачинаетсяС(ВРег(Текст), "ОШИБКА")
		Или СтрНачинаетсяС(ВРег(Текст), "НЕ ЗАПОЛНЕНЫ")
		Или СтрНачинаетсяС(ВРег(Текст), "У СОТРУДНИКА")
		Или СтрНачинаетсяС(ВРег(Текст), "УКАЖИТЕ") Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат "Не удалось отправить письмо: " + Текст;

КонецФункции

Функция ПрофильSMTP()

	Профиль = Новый ИнтернетПочтовыйПрофиль;
	Профиль.АдресСервераSMTP = Константы.АдресSMTP.Получить();
	Профиль.ПортSMTP = Константы.ПортSMTP.Получить();
	Профиль.ПользовательSMTP = Константы.ЛогинSMTP.Получить();
	Профиль.ПарольSMTP = Константы.ПарольSMTP.Получить();
	Профиль.ИспользоватьSSLSMTP = Константы.ИспользоватьSSL.Получить();
	Профиль.Таймаут = Константы.ТаймаутSMTP.Получить();
	Возврат Профиль;

КонецФункции

Функция EmailСотрудника(СотрудникСсылка)

	Если Не ЗначениеЗаполнено(СотрудникСсылка) Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(СотрудникСсылка.ПолучитьОбъект().Email);

КонецФункции

Процедура ЗаписатьВЖурнал(ДокументСсылка, Получатель, Событие, Успешно, ТекстОшибки,
	Письмо = Неопределено, Знач Канал = Неопределено)

	ПочтовыйКанал = Перечисления.КаналыУведомлений.ЭлектроннаяПочта;
	Канал = ?(Канал = Неопределено, ПочтовыйКанал, Канал);
	ОшибкаОтправки = "";
	Если Не Успешно Тогда
		ОшибкаОтправки = ?(Канал = ПочтовыйКанал, ТекстОшибкиОтправки(ТекстОшибки), ТекстОшибки);
		СобытиеЖурнала = ?(Канал = ПочтовыйКанал, "ДокМаршрут.Почта", "ДокМаршрут.СистемаВзаимодействия");
		ЗаписьЖурналаРегистрации(СобытиеЖурнала, УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ДокументСЭД, ДокументСсылка, ОшибкаОтправки);
	КонецЕсли;
	Попытка
		СохранитьПопытку(ДокументСсылка, Получатель, Событие, Успешно, ОшибкаОтправки, Письмо, , Канал);
	Исключение
		ЗаписьЖурналаРегистрации("ДокМаршрут.ЖурналУведомлений", УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ДокументСЭД, ДокументСсылка,
			ТекстОшибкиОтправки(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

Процедура СохранитьПопытку(ДокументСсылка, Получатель, Событие, Успешно, ОшибкаОтправки,
	Письмо = Неопределено, НомерПопытки = 1, Канал = Неопределено)

	Менеджер = РегистрыСведений.ЖурналУведомлений.СоздатьМенеджерЗаписи();
	Менеджер.ИдентификаторПопытки = Строка(Новый УникальныйИдентификатор());
	Менеджер.Документ = ДокументСсылка;
	Менеджер.ДатаВремя = ТекущаяДатаСеанса();
	Менеджер.Получатель = Лев(Получатель, 150);
	Менеджер.Канал = ?(Канал = Неопределено, Перечисления.КаналыУведомлений.ЭлектроннаяПочта, Канал);
	Менеджер.Событие = ПредставлениеСобытияПисьма(Событие);
	Менеджер.Успешно = Успешно;
	Менеджер.ТекстОшибки = ОшибкаОтправки;
	Менеджер.Попытка = НомерПопытки;
	Если Не Успешно И Письмо <> Неопределено Тогда
		Менеджер.ДанныеПовтора = Новый ХранилищеЗначения(Письмо);
		// Дать администратору время исправить настройки между попытками.
		Менеджер.ПовторитьПосле = ТекущаяДатаСеанса() + 60 * 5;
	КонецЕсли;
	Менеджер.Записать();

КонецПроцедуры

#КонецОбласти
