// Консультант ДокМаршрута. Гига ставит фильтр, число и строки считает запрос.

Процедура ПодключитьКлючИзФайла() Экспорт

	Попытка
		Если Не ПустаяСтрока(СокрЛП(Константы.КлючAPIИИ.Получить())) Тогда
			Возврат;
		КонецЕсли;
		Ключ = КлючИзЛокальногоФайла();
		Если Не ПустаяСтрока(Ключ) Тогда
			Константы.КлючAPIИИ.Установить(Ключ);
		КонецЕсли;
	Исключение
		Возврат;
	КонецПопытки;

КонецПроцедуры

Функция Ответить(ТекстВопроса, ИспользоватьМодель) Экспорт

	ПодключитьКлючИзФайла();
	ТаблицаДокументов = НоваяТаблицаДокументов();
	Вопрос = СокрЛП(ТекстВопроса);

	Если Не ИспользоватьМодель Тогда
		Фильтр = НовыйФильтрДокументов();
		Фильтр.СтатусИмя = "НаСогласовании";
		Фильтр.Роль = "согласующий";
		ЗаполнитьДокументыПоФильтру(ТаблицаДокументов, Фильтр, "Ждёт решения");
		Возврат Новый Структура("Текст, Документы", СводкаБазы(), ТаблицаДокументов);
	КонецЕсли;

	Если ПустаяСтрока(Вопрос) Тогда
		Вопрос = "На что обратить внимание по всем данным ДокМаршрута?";
	КонецЕсли;

	Фраза = НРег(Вопрос);
	Если ЭтоВопросСправочника(Фраза) Тогда
		Возврат Новый Структура("Текст, Документы", ОтветСправочника(Фраза), ТаблицаДокументов);
	КонецЕсли;

	Фильтр = РазобратьФильтрЛокально(Фраза);
	Если ПустаяСтрока(Фильтр.СтатусИмя) Тогда
		ДополнитьФильтрИзГига(Фильтр, Вопрос);
	КонецЕсли;
	Если ПустаяСтрока(Фильтр.СтатусИмя)
		И (СтрНайти(Фраза, "вниман") > 0
			Или СтрНайти(Фраза, "ждет") > 0
			Или СтрНайти(Фраза, "ждёт") > 0
			Или ПустаяСтрока(СокрЛП(ТекстВопроса))) Тогда
		Фильтр.СтатусИмя = "НаСогласовании";
		Фильтр.Роль = "согласующий";
	КонецЕсли;

	ЗаполнитьДокументыПоФильтру(ТаблицаДокументов, Фильтр, "По запросу");
	ТекстОтвета = ТекстОтветаПоФильтру(Фильтр, ТаблицаДокументов, Фраза);
	Если СтрНайти(Фраза, "отправ") > 0 Или СтрНайти(Фраза, "сделай") > 0 Или СтрНайти(Фраза, "выполни") > 0 Тогда
		ТекстОтвета = ТекстОтвета + Символы.ПС + "Действия здесь не выполняю, только ответы по данным.";
	КонецЕсли;
	Возврат Новый Структура("Текст, Документы", ТекстОтвета, ТаблицаДокументов);

КонецФункции

Функция НовыйФильтрДокументов()

	Возврат Новый Структура(
		"СтатусИмя, Этап, Чьи, Роль, Вид, Номер, СотрудникИмя",
		"",
		0,
		"мои",
		"автор",
		"",
		"",
		"");

КонецФункции

Функция РазобратьФильтрЛокально(Фраза)

	Фильтр = НовыйФильтрДокументов();
	Если СтрНайти(Фраза, "чернов") > 0 Тогда
		Фильтр.СтатусИмя = "Черновик";
	ИначеЕсли СтрНайти(Фраза, "отклон") > 0 Тогда
		Фильтр.СтатусИмя = "Отклонен";
	ИначеЕсли СтрНайти(Фраза, "доработ") > 0 Тогда
		Фильтр.СтатусИмя = "НаДоработке";
	ИначеЕсли ЭтоФразаНаСогласовании(Фраза)
		Или СтрНайти(Фраза, "ждет") > 0
		Или СтрНайти(Фраза, "ждёт") > 0 Тогда
		Фильтр.СтатусИмя = "НаСогласовании";
	ИначеЕсли СтрНайти(Фраза, "согласован") > 0 Тогда
		Фильтр.СтатусИмя = "Согласован";
	КонецЕсли;

	Для Номер = 1 По 9 Цикл
		Если СтрНайти(Фраза, "этап " + Номер) > 0
			Или СтрНайти(Фраза, "этап:" + Номер) > 0
			Или СтрНайти(Фраза, "этапе " + Номер) > 0 Тогда
			Фильтр.Этап = Номер;
			Если ПустаяСтрока(Фильтр.СтатусИмя) Тогда
				Фильтр.СтатусИмя = "НаСогласовании";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если СтрНайти(Фраза, "все документ") > 0
		Или СтрНайти(Фраза, "все документы") > 0
		Или СтрНайти(Фраза, " по всем") > 0
		Или СтрНайти(Фраза, "всех") > 0 Тогда
		Фильтр.Чьи = "все";
	КонецЕсли;

	Если СтрНайти(Фраза, "согласующ") > 0
		Или СтрНайти(Фраза, "ждёт меня") > 0
		Или СтрНайти(Фраза, "ждет меня") > 0
		Или СтрНайти(Фраза, "ждут меня") > 0
		Или СтрНайти(Фраза, "моего решения") > 0
		Или СтрНайти(Фраза, "вашего решения") > 0 Тогда
		Фильтр.Роль = "согласующий";
		Если ПустаяСтрока(Фильтр.СтатусИмя) Тогда
			Фильтр.СтатусИмя = "НаСогласовании";
		КонецЕсли;
	КонецЕсли;

	Возврат Фильтр;

КонецФункции

Процедура ДополнитьФильтрИзГига(Фильтр, Вопрос)

	Ключ = СокрЛП(Константы.КлючAPIИИ.Получить());
	Если ПустаяСтрока(Ключ) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Сырой = ТекстФильтраГига(Ключ, Вопрос);
		Данные = ДанныеФильтраИзТекста(Сырой);
		Если Данные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		СтатусИмя = СтрокаСвойстваФильтра(Данные, "статус");
		Если СтатусВБеломСписке(СтатусИмя) Тогда
			Фильтр.СтатусИмя = СтатусИмя;
		КонецЕсли;
		ЭтапТекст = СтрокаСвойстваФильтра(Данные, "этап");
		Если Не ПустаяСтрока(ЭтапТекст) Тогда
			Попытка
				ЭтапЧисло = Число(ЭтапТекст);
				Если ЭтапЧисло >= 1 И ЭтапЧисло <= 9 Тогда
					Фильтр.Этап = ЭтапЧисло;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;
		Чьи = НРег(СтрокаСвойстваФильтра(Данные, "чьи"));
		Если Чьи = "все" Или Чьи = "мои" Тогда
			Фильтр.Чьи = Чьи;
		КонецЕсли;
		Роль = НРег(СтрокаСвойстваФильтра(Данные, "роль"));
		Если Роль = "автор" Или Роль = "согласующий" Тогда
			Фильтр.Роль = Роль;
		КонецЕсли;
		Фильтр.Вид = СокрЛП(СтрокаСвойстваФильтра(Данные, "вид"));
		Фильтр.Номер = СокрЛП(СтрокаСвойстваФильтра(Данные, "номер"));
		Фильтр.СотрудникИмя = СокрЛП(СтрокаСвойстваФильтра(Данные, "сотрудник"));
	Исключение
		Возврат;
	КонецПопытки;

КонецПроцедуры

Функция ТекстФильтраГига(Ключ, Вопрос)

	Инструкция =
	"По фразе пользователя верни только JSON без текста вокруг. "
		+ "Ключи: статус, этап, чьи, роль, вид, номер, сотрудник. "
		+ "статус одно из: Черновик, НаСогласовании, Согласован, Отклонен, НаДоработке или пусто. "
		+ "этап число 0-9. чьи: мои или все. роль: автор или согласующий. "
		+ "вид и сотрудник — имена если названы, иначе пусто. номер документа если назван. "
		+ "Пример: {""статус"":""НаСогласовании"",""этап"":0,""чьи"":""мои"",""роль"":""автор"",""вид"":"""",""номер"":"""",""сотрудник"":""""}";
	Промпт = Инструкция + Символы.ПС + "Фраза: " + Вопрос;
	Токен = ТокенДоступа(Ключ);
	Тело = Новый Структура;
	Тело.Вставить("model", "GigaChat");
	Тело.Вставить("temperature", 0);
	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("role, content", "user", Промпт));
	Тело.Вставить("messages", Сообщения);
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Заголовки.Вставить("Accept", "application/json");
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Ответ = ОтветPOST("https://gigachat.devices.sberbank.ru/api/v1/chat/completions", Заголовки, ЗаписатьТелоJSON(Тело));
	Возврат ТекстИзОтвета(Ответ, Ключ);

КонецФункции

Функция ДанныеФильтраИзТекста(Сырой)

	Текст = СокрЛП(СтрЗаменить(СтрЗаменить(Сырой, "```json", ""), "```", ""));
	Начало = СтрНайти(Текст, "{");
	Конец = СтрНайти(Текст, "}", НаправлениеПоиска.СКонца);
	Если Начало = 0 Или Конец = 0 Или Конец < Начало Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат РазобратьJSON(Сред(Текст, Начало, Конец - Начало + 1));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция СтрокаСвойстваФильтра(Данные, Имя)

	Значение = Неопределено;
	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Значение = Данные.Получить(Имя);
	ИначеЕсли ТипЗнч(Данные) = Тип("Структура") Тогда
		Если Данные.Свойство(Имя, Значение) Тогда
		Иначе
			Возврат "";
		КонецЕсли;
	Иначе
		Возврат "";
	КонецЕсли;
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция СтатусВБеломСписке(СтатусИмя)

	Возврат СтатусИмя = "Черновик"
		Или СтатусИмя = "НаСогласовании"
		Или СтатусИмя = "Согласован"
		Или СтатусИмя = "Отклонен"
		Или СтатусИмя = "НаДоработке";

КонецФункции

Функция ТекстЗНАЧЕНИЯСтатуса(СтатусИмя)

	Если СтатусИмя = "Черновик" Тогда
		Возврат "ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Черновик)";
	ИначеЕсли СтатусИмя = "НаСогласовании" Тогда
		Возврат "ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.НаСогласовании)";
	ИначеЕсли СтатусИмя = "Согласован" Тогда
		Возврат "ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Согласован)";
	ИначеЕсли СтатусИмя = "Отклонен" Тогда
		Возврат "ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Отклонен)";
	ИначеЕсли СтатусИмя = "НаДоработке" Тогда
		Возврат "ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.НаДоработке)";
	КонецЕсли;
	Возврат "";

КонецФункции

Процедура ЗаполнитьДокументыПоФильтру(ТаблицаДокументов, Фильтр, Почему)

	ТаблицаДокументов.Очистить();
	Условия = Новый Массив;
	Условия.Добавить("НЕ ПометкаУдаления");
	Запрос = Новый Запрос;

	ТекстСтатуса = ТекстЗНАЧЕНИЯСтатуса(Фильтр.СтатусИмя);
	Если Не ПустаяСтрока(ТекстСтатуса) Тогда
		Условия.Добавить("Статус = " + ТекстСтатуса);
	КонецЕсли;
	Если Фильтр.Этап > 0 Тогда
		Условия.Добавить("ТекущийЭтап = &ОтборЭтап");
		Запрос.УстановитьПараметр("ОтборЭтап", Фильтр.Этап);
	КонецЕсли;
	Если Не ПустаяСтрока(Фильтр.Номер) Тогда
		Условия.Добавить("Номер = &ОтборНомер");
		Запрос.УстановитьПараметр("ОтборНомер", Фильтр.Номер);
	КонецЕсли;

	ВидСсылка = НайтиВидПоИмени(Фильтр.Вид);
	Если ЗначениеЗаполнено(ВидСсылка) Тогда
		Условия.Добавить("ВидДокумента = &ОтборВид");
		Запрос.УстановитьПараметр("ОтборВид", ВидСсылка);
	КонецЕсли;

	Сотрудник = СотрудникДляФильтра(Фильтр);
	Если Фильтр.Чьи <> "все" И ЗначениеЗаполнено(Сотрудник) Тогда
		Запрос.УстановитьПараметр("ОтборСотрудник", Сотрудник);
		Если Фильтр.Роль = "согласующий" Тогда
			Условия.Добавить("ТекущийСогласующий = &ОтборСотрудник");
		Иначе
			Условия.Добавить("(Автор = &ОтборСотрудник ИЛИ Ответственный = &ОтборСотрудник)");
		КонецЕсли;
	КонецЕсли;

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 30
	|	Ссылка,
	|	Номер,
	|	Дата,
	|	ВидДокумента,
	|	Статус,
	|	ТекущийЭтап
	|ИЗ
	|	Документ.ДокументСЭД
	|ГДЕ
	|	" + СтрСоединить(Условия, "
	|	И ") + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТекущийЭтап,
	|	Дата";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = ТаблицаДокументов.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Выборка);
		Строка.Почему = Почему;
	КонецЦикла;

КонецПроцедуры

Функция СотрудникДляФильтра(Фильтр)

	Если Не ПустаяСтрока(Фильтр.СотрудникИмя) Тогда
		Найденный = НайтиСотрудникаПоИмени(Фильтр.СотрудникИмя);
		Если ЗначениеЗаполнено(Найденный) Тогда
			Возврат Найденный;
		КонецЕсли;
	КонецЕсли;
	Привязка = ДинамическиеФормы.ПривязкаПользователяДляИнтерфейса();
	Возврат Привязка.Сотрудник;

КонецФункции

Функция НайтиСотрудникаПоИмени(Имя)

	Если ПустаяСтрока(Имя) Тогда
		Возврат Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.УстановитьПараметр("ИмяПодобно", Имя + "%");
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ссылка
	|ИЗ
	|	Справочник.Сотрудники
	|ГДЕ
	|	НЕ ПометкаУдаления
	|	И (Наименование = &Имя ИЛИ Наименование ПОДОБНО &ИмяПодобно)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Сотрудники.ПустаяСсылка();

КонецФункции

Функция НайтиВидПоИмени(Имя)

	Если ПустаяСтрока(Имя) Тогда
		Возврат Справочники.ВидыДокументов.ПустаяСсылка();
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.УстановитьПараметр("ИмяПодобно", Имя + "%");
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ссылка
	|ИЗ
	|	Справочник.ВидыДокументов
	|ГДЕ
	|	НЕ ПометкаУдаления
	|	И (Наименование = &Имя ИЛИ Наименование ПОДОБНО &ИмяПодобно)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.ВидыДокументов.ПустаяСсылка();

КонецФункции

Функция ТекстОтветаПоФильтру(Фильтр, ТаблицаДокументов, Фраза)

	Заголовок = ЗаголовокФильтра(Фильтр);
	Если ТаблицаДокументов.Количество() = 0 Тогда
		Возврат "По запросу документов нет.";
	КонецЕсли;
	Если СтрНайти(Фраза, "скольк") > 0 Тогда
		Возврат Заголовок + ": " + ТаблицаДокументов.Количество() + ".";
	КонецЕсли;
	Возврат Заголовок + ": " + ТаблицаДокументов.Количество() + ". "
		+ ТекстДокументов(ТаблицаДокументов);

КонецФункции

Функция ЗаголовокФильтра(Фильтр)

	Если Фильтр.СтатусИмя = "Черновик" Тогда
		Возврат "Черновики";
	ИначеЕсли Фильтр.СтатусИмя = "Отклонен" Тогда
		Возврат "Отклонённые";
	ИначеЕсли Фильтр.СтатусИмя = "НаДоработке" Тогда
		Возврат "На доработке";
	ИначеЕсли Фильтр.СтатусИмя = "НаСогласовании" Тогда
		Возврат "На согласовании";
	ИначеЕсли Фильтр.СтатусИмя = "Согласован" Тогда
		Возврат "Согласованные";
	КонецЕсли;
	Возврат "Найдено";

КонецФункции

Функция ЭтоВопросСправочника(Фраза)

	Если СтрНайти(Фраза, "сотруд") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтрНайти(Фраза, "видов") > 0
		Или СтрНайти(Фраза, "виды") > 0
		Или СтрНайти(Фраза, "вид документ") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтрНайти(Фраза, "журнал") > 0
		Или СтрНайти(Фраза, "почт") > 0
		Или СтрНайти(Фраза, "уведом") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

