КонецФункции

Функция ТокенДоступа(Ключ)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Заголовки.Вставить("Accept", "application/json");
	Заголовки.Вставить("RqUID", Строка(Новый УникальныйИдентификатор));
	Заголовок = Ключ;
	Если Не СтрНачинаетсяС(НРег(Заголовок), "basic ") Тогда
		Заголовок = "Basic " + Заголовок;
	КонецЕсли;
	Заголовки.Вставить("Authorization", Заголовок);
	Ответ = ОтветPOST("https://ngw.devices.sberbank.ru:9443/api/v2/oauth", Заголовки, "scope=GIGACHAT_API_PERS");
	Тело = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
		ВызватьИсключение "GigaChat не выдал токен, HTTP " + Ответ.КодСостояния;
	КонецЕсли;
	Данные = РазобратьJSON(Тело);
	Токен = "";
	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Токен = Строка(Данные.Получить("access_token"));
	ИначеЕсли ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("access_token") Тогда
		Токен = Строка(Данные.access_token);
	КонецЕсли;
	Если ПустаяСтрока(СокрЛП(Токен)) Или Токен = "Неопределено" Тогда
		ВызватьИсключение "В ответе OAuth нет токена.";
	КонецЕсли;
	Возврат СокрЛП(Токен);

КонецФункции

Функция ТекстИзОтвета(Ответ, Ключ)

	Тело = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
		ВызватьИсключение "Сервис ИИ вернул HTTP " + Ответ.КодСостояния;
	КонецЕсли;
	Данные = РазобратьJSON(Тело);
	Выборы = Неопределено;
	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Выборы = Данные.Получить("choices");
	ИначеЕсли ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("choices") Тогда
		Выборы = Данные.choices;
	КонецЕсли;
	Если ТипЗнч(Выборы) = Тип("Массив") И Выборы.Количество() > 0 Тогда
		Первый = Выборы[0];
		Сообщение = Неопределено;
		Если ТипЗнч(Первый) = Тип("Соответствие") Тогда
			Сообщение = Первый.Получить("message");
		ИначеЕсли ТипЗнч(Первый) = Тип("Структура") И Первый.Свойство("message") Тогда
			Сообщение = Первый.message;
		КонецЕсли;
		Если ТипЗнч(Сообщение) = Тип("Соответствие") Тогда
			Возврат СкрытьСекрет(Строка(Сообщение.Получить("content")), Ключ);
		ИначеЕсли ТипЗнч(Сообщение) = Тип("Структура") И Сообщение.Свойство("content") Тогда
			Возврат СкрытьСекрет(Строка(Сообщение.content), Ключ);
		КонецЕсли;
	КонецЕсли;
	ВызватьИсключение "Сервис ИИ вернул ответ без текста.";

КонецФункции

Функция ОтветPOST(Адрес, Заголовки, Тело)

	Остаток = Адрес;
	Порт = 443;
	Если СтрНачинаетсяС(НРег(Остаток), "https://") Тогда
		Остаток = Сред(Остаток, 9);
	КонецЕсли;
	ПозицияСлеша = СтрНайти(Остаток, "/");
	ХостИПорт = Лев(Остаток, ПозицияСлеша - 1);
	Путь = Сред(Остаток, ПозицияСлеша);
	ПозицияДвоеточия = СтрНайти(ХостИПорт, ":");
	Хост = ХостИПорт;
	Если ПозицияДвоеточия > 0 Тогда
		Хост = Лев(ХостИПорт, ПозицияДвоеточия - 1);
		Порт = Число(Сред(ХостИПорт, ПозицияДвоеточия + 1));
	КонецЕсли;
	Соединение = Новый HTTPСоединение(Хост, Порт, , , , 30, Новый ЗащищенноеСоединениеOpenSSL);
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Соединение.ОтправитьДляОбработки(Запрос);

КонецФункции

Функция КлючИзЛокальногоФайла()

	Каталоги = Новый Массив;
	КаталогБазы = КаталогФайловойБазыИзСтрокиСоединения();
	Если Не ПустаяСтрока(КаталогБазы) Тогда
		Каталоги.Добавить(КаталогБазы);
		Каталог = КаталогБазы;
		Для Шаг = 1 По 6 Цикл
			ФайлКаталога = Новый Файл(Каталог);
			Родитель = ФайлКаталога.Путь;
			Если ПустаяСтрока(Родитель) Или Родитель = Каталог Тогда
				Прервать;
			КонецЕсли;
			Каталоги.Добавить(Родитель);
			Каталог = Родитель;
		КонецЦикла;
	КонецЕсли;
	Каталоги.Добавить("/Users/damir/Documents/хакатоны/1С");

	Для Каждого КаталогПоиска Из Каталоги Цикл
		Ключ = КлючИзФайлаEnv(КаталогПоиска);
		Если Не ПустаяСтрока(Ключ) Тогда
			Возврат Ключ;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция КаталогФайловойБазыИзСтрокиСоединения()

	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	Маркер = "File=";
	Позиция = СтрНайти(ВРег(СтрокаСоединения), ВРег(Маркер));
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(СтрокаСоединения, Позиция + СтрДлина(Маркер));
	Если СтрНачинаетсяС(Остаток, """") Тогда
		Остаток = Сред(Остаток, 2);
		КонецКавычки = СтрНайти(Остаток, """");
		Если КонецКавычки > 0 Тогда
			Остаток = Лев(Остаток, КонецКавычки - 1);
		КонецЕсли;
	Иначе
		КонецТочкиСЗапятой = СтрНайти(Остаток, ";");
		Если КонецТочкиСЗапятой > 0 Тогда
			Остаток = Лев(Остаток, КонецТочкиСЗапятой - 1);
		КонецЕсли;
	КонецЕсли;
	Возврат СокрЛП(Остаток);

КонецФункции

Функция КлючИзФайлаEnv(Каталог)

	Если ПустаяСтрока(Каталог) Тогда
		Возврат "";
	КонецЕсли;
	Разделитель = ПолучитьРазделительПути();
	Путь = Каталог;
	ПоследнийСимвол = Прав(Путь, 1);
	Если ПоследнийСимвол <> Разделитель И ПоследнийСимвол <> "/" И ПоследнийСимвол <> "\" Тогда
		Путь = Путь + Разделитель;
	КонецЕсли;
	Файл = Новый Файл(Путь + ".env");
	Если Не Файл.Существует() Тогда
		Возврат "";
	КонецЕсли;
	Документ = Новый ТекстовыйДокумент;
	Документ.Прочитать(Файл.ПолноеИмя, КодировкаТекста.UTF8);
	Для Номер = 1 По Документ.КоличествоСтрок() Цикл
		СтрокаФайла = СокрЛП(Документ.ПолучитьСтроку(Номер));
		Если СтрНачинаетсяС(СтрокаФайла, "GIGACHAT_AUTHORIZATION_KEY=") Тогда
			Возврат СокрЛП(Сред(СтрокаФайла, СтрДлина("GIGACHAT_AUTHORIZATION_KEY=") + 1));
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция СкрытьСекрет(Текст, Ключ)

	Результат = Строка(Текст);
	Если Не ПустаяСтрока(Ключ) Тогда
		Результат = СтрЗаменить(Результат, Ключ, "***");
	КонецЕсли;
	Возврат Результат;

