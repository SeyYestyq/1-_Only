// Копирует описание полей вида в табличную часть документа (режим предприятия без смены конфигурации).
Процедура ЗаполнитьЗначенияПолейИзВида(ДокументОбъект, ВидОбъект) Экспорт

	Для Каждого СтрокаПоля Из ВидОбъект.Поля Цикл
		Если СтрокаПоля.Скрыто Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ДокументОбъект.ЗначенияПолей.Добавить();
		НоваяСтрока.Идентификатор = СтрокаПоля.Идентификатор;
		НоваяСтрока.Заголовок = СтрокаПоля.Заголовок;
	КонецЦикла;

КонецПроцедуры

// Дописывает в документ поля вида, которых ещё нет в табличной части.
// ДокументОбъект - ДокументОбъект.ДокументСЭД.
// Возвращаемое значение - Число, сколько строк добавлено.
Функция ДобавитьНедостающиеПоляИзВида(ДокументОбъект) Экспорт

	Если Не ЗначениеЗаполнено(ДокументОбъект.ВидДокумента) Тогда
		Возврат 0;
	КонецЕсли;

	ЕстьИд = Новый Соответствие;
	Для Каждого СтрокаЗначения Из ДокументОбъект.ЗначенияПолей Цикл
		ЕстьИд.Вставить(СтрокаЗначения.Идентификатор, Истина);
	КонецЦикла;

	Добавлено = 0;
	ВидОбъект = ДокументОбъект.ВидДокумента.ПолучитьОбъект();
	Для Каждого СтрокаПоля Из ВидОбъект.Поля Цикл
		Если СтрокаПоля.Скрыто Тогда
			Продолжить;
		КонецЕсли;
		Если ЕстьИд.Получить(СтрокаПоля.Идентификатор) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ДокументОбъект.ЗначенияПолей.Добавить();
		НоваяСтрока.Идентификатор = СтрокаПоля.Идентификатор;
		НоваяСтрока.Заголовок = СтрокаПоля.Заголовок;
		ЕстьИд.Вставить(СтрокаПоля.Идентификатор, Истина);
		Добавлено = Добавлено + 1;
	КонецЦикла;
	Возврат Добавлено;

КонецФункции

// Подтягивает таблицу и редакторы к текущим полям вида. Уже введённые значения остальных полей остаются.
// Возвращаемое значение - Истина, если редакторы пересобрали.
Функция СинхронизироватьРедакторыСВидом(Форма) Экспорт

	ПеренестиРедакторыВДокумент(Форма);
	СинхронизироватьЗначенияПолейСВидом(Форма.Объект);
	ПостроитьРедакторыПолей(Форма);
	Возврат Истина;

КонецФункции

Функция СинхронизироватьЗначенияПолейСВидом(ДокументОбъект) Экспорт

	Изменено = Ложь;
	Ожидаемые = ОжидаемыеПоляВида(ДокументОбъект.ВидДокумента);

	Индекс = ДокументОбъект.ЗначенияПолей.Количество() - 1;
	Пока Индекс >= 0 Цикл
		СтрокаЗначения = ДокументОбъект.ЗначенияПолей[Индекс];
		Описание = Ожидаемые.Получить(СтрокаЗначения.Идентификатор);
		Если Описание = Неопределено Тогда
			ДокументОбъект.ЗначенияПолей.Удалить(Индекс);
			Изменено = Истина;
		ИначеЕсли СтрокаЗначения.Заголовок <> Описание.Заголовок Тогда
			СтрокаЗначения.Заголовок = Описание.Заголовок;
			Изменено = Истина;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	ЕстьИд = Новый Соответствие;
	Для Каждого СтрокаЗначения Из ДокументОбъект.ЗначенияПолей Цикл
		ЕстьИд.Вставить(СтрокаЗначения.Идентификатор, Истина);
	КонецЦикла;

	Для Каждого КлючИЗначение Из Ожидаемые Цикл
		Если ЕстьИд.Получить(КлючИЗначение.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ДокументОбъект.ЗначенияПолей.Добавить();
		НоваяСтрока.Идентификатор = КлючИЗначение.Ключ;
		НоваяСтрока.Заголовок = КлючИЗначение.Значение.Заголовок;
		Изменено = Истина;
	КонецЦикла;

	Возврат Изменено;

КонецФункции

Функция ОжидаемыеПоляВида(ВидСсылка)

	Результат = Новый Соответствие;
	Если Не ЗначениеЗаполнено(ВидСсылка) Тогда
		Возврат Результат;
	КонецЕсли;

	ВидОбъект = ВидСсылка.ПолучитьОбъект();
	Поля = ВидОбъект.Поля.Выгрузить();
	Поля.Сортировать("Порядок");
	Для Каждого Описание Из Поля Цикл
		Если Описание.Скрыто Или ЭтоПолеСутиДокумента(Описание.Заголовок, Описание.Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		Если ПустаяСтрока(СокрЛП(Описание.Идентификатор)) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(
			Описание.Идентификатор,
			Новый Структура("Заголовок, ТипПоля", Описание.Заголовок, Описание.ТипПоля));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СоставРедакторовОтличаетсяОтВида(Форма)

	Ожидаемые = ОжидаемыеПоляВида(Форма.Объект.ВидДокумента);
	Если Форма.ПоляФормы.Количество() <> Ожидаемые.Количество() Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого Карта Из Форма.ПоляФормы Цикл
		Описание = Ожидаемые.Получить(Карта.Идентификатор);
		Если Описание = Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
		Если Карта.Заголовок <> Описание.Заголовок Или Карта.ТипПоля <> Описание.ТипПоля Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Наименования из справочника ЗначенияПолей для поля вида с типом «Выбор из списка».
Функция НаименованияЗначенийСписка(ВидСсылка, ИдентификаторПоля) Экспорт

	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(ВидСсылка) Или ПустаяСтрока(ИдентификаторПоля) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗначенияПолей.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ЗначенияПолей КАК ЗначенияПолей
	|ГДЕ
	|	ЗначенияПолей.Владелец = &Вид
	|	И ЗначенияПолей.ИдентификаторПоля = &ИдентификаторПоля
	|	И НЕ ЗначенияПолей.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Запрос.УстановитьПараметр("Вид", ВидСсылка);
	Запрос.УстановитьПараметр("ИдентификаторПоля", ИдентификаторПоля);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Наименование);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Тип поля в шаблоне вида по идентификатору (для настройки выпадающего списка в документе).
Функция ТипПоляПоИдентификатору(ВидСсылка, ИдентификаторПоля) Экспорт

	Если Не ЗначениеЗаполнено(ВидСсылка) Или ПустаяСтрока(ИдентификаторПоля) Тогда
		Возврат Перечисления.ТипыПолей.ПустаяСсылка();
	КонецЕсли;

	ВидОбъект = ВидСсылка.ПолучитьОбъект();
	Для Каждого СтрокаПоля Из ВидОбъект.Поля Цикл
		Если СтрокаПоля.Идентификатор = ИдентификаторПоля Тогда
			Возврат СтрокаПоля.ТипПоля;
		КонецЕсли;
	КонецЦикла;
	Возврат Перечисления.ТипыПолей.ПустаяСсылка();

КонецФункции

Функция ТекстПроверкиОбязательных(ДокументОбъект) Экспорт

	Если Не ЗначениеЗаполнено(ДокументОбъект.ВидДокумента) Тогда
		Возврат "Нельзя отправить. В поле «Вид документа» выберите значение.";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДокументОбъект.Ответственный) Тогда
		Возврат "Нельзя отправить. В блоке «Кто участвует» в поле «Ответственный» выберите сотрудника.";
	КонецЕсли;

	ВидОбъект = ДокументОбъект.ВидДокумента.ПолучитьОбъект();
	ЗначенияПоИд = Новый Соответствие;
	Для Каждого СтрокаЗначения Из ДокументОбъект.ЗначенияПолей Цикл
		ЗначенияПоИд.Вставить(СтрокаЗначения.Идентификатор, СтрокаЗначения.ЗначениеСтрока);
	КонецЦикла;

	Незаполненные = Новый Массив;
	Для Каждого СтрокаПоля Из ВидОбъект.Поля Цикл
		Если СтрокаПоля.Скрыто Или ЭтоПолеСутиДокумента(СтрокаПоля.Заголовок, СтрокаПоля.Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		Значение = ЗначенияПоИд.Получить(СтрокаПоля.Идентификатор);
		Если Значение = Неопределено Или ПустаяСтрока(СокрЛП(Строка(Значение))) Тогда
			Незаполненные.Добавить("«" + СтрокаПоля.Заголовок + "»");
		КонецЕсли;
	КонецЦикла;

	Если Незаполненные.Количество() > 0 Тогда
		Возврат "Нельзя отправить. В блоке «Поля документа» заполните "
			+ СтрСоединить(Незаполненные, ", ") + ".";
	КонецЕсли;

	ТекстФормата = ТекстОшибокФорматаПоВиду(ВидОбъект, ЗначенияПоИд, "Нельзя отправить");
	Если Не ПустаяСтрока(ТекстФормата) Тогда
		Возврат ТекстФормата;
	КонецЕсли;

	Возврат "";

КонецФункции

// Только формат уже введённых значений (черновик можно сохранить неполным).
Функция ТекстПроверкиФорматаПолей(ДокументОбъект) Экспорт

	Если Не ЗначениеЗаполнено(ДокументОбъект.ВидДокумента) Тогда
		Возврат "";
	КонецЕсли;

	ВидОбъект = ДокументОбъект.ВидДокумента.ПолучитьОбъект();
	ЗначенияПоИд = Новый Соответствие;
	Для Каждого СтрокаЗначения Из ДокументОбъект.ЗначенияПолей Цикл
		ЗначенияПоИд.Вставить(СтрокаЗначения.Идентификатор, СтрокаЗначения.ЗначениеСтрока);
	КонецЦикла;

	Возврат ТекстОшибокФорматаПоВиду(ВидОбъект, ЗначенияПоИд, "Нельзя записать");

КонецФункции

Функция ТекстОшибокФорматаПоВиду(ВидОбъект, ЗначенияПоИд, ПрефиксСообщения)

	Для Каждого СтрокаПоля Из ВидОбъект.Поля Цикл
		Если СтрокаПоля.Скрыто Тогда
			Продолжить;
		КонецЕсли;
		Значение = СокрЛП(Строка(ЗначенияПоИд.Получить(СтрокаПоля.Идентификатор)));
		Если ПустаяСтрока(Значение) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаПоля.ТипПоля = Перечисления.ТипыПолей.Число Тогда
			Если Не ЗначениеЭтоЧисло(Значение) Тогда
				Возврат ПрефиксСообщения + ". В блоке «Поля документа» в поле «"
					+ СтрокаПоля.Заголовок + "» укажите число.";
			КонецЕсли;
		ИначеЕсли СтрокаПоля.ТипПоля = Перечисления.ТипыПолей.Дата Тогда
			Если Не ЗначениеЭтоДата(Значение) Тогда
				Возврат ПрефиксСообщения + ". В блоке «Поля документа» в поле «"
					+ СтрокаПоля.Заголовок + "» укажите дату (например 31.12.2026).";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ЗначениеЭтоЧисло(Значение)

	Попытка
		Проверка = Число(СтрЗаменить(Значение, " ", ""));
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ЗначениеЭтоДата(Значение)

	Попытка
		ДатаИзСтрокиПоля(Значение);
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

#Область ИнтерфейсФормы

// Редакторы формы типизированы. В табличной части значение по-прежнему строка.
Процедура ПостроитьРедакторыПолей(Форма) Экспорт

	Удаляемые = Новый Массив;
	Для Каждого Карта Из Форма.ПоляФормы Цикл
		Форма.Элементы.Удалить(Форма.Элементы[Карта.Имя]);
		Удаляемые.Добавить(Карта.Имя);
	КонецЦикла;
	Форма.ПоляФормы.Очистить();
	Если Удаляемые.Количество() > 0 Тогда
		Форма.ИзменитьРеквизиты(Новый Массив, Удаляемые);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Форма.Объект.ВидДокумента) Тогда
		Возврат;
	КонецЕсли;

	ВидОбъект = Форма.Объект.ВидДокумента.ПолучитьОбъект();
	Поля = ВидОбъект.Поля.Выгрузить();
	Поля.Сортировать("Порядок");
	Добавляемые = Новый Массив;
	НачальныеЗначения = Новый Соответствие;
	Для Каждого Описание Из Поля Цикл
		Если Описание.Скрыто Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоПолеСутиДокумента(Описание.Заголовок, Описание.Идентификатор) Тогда
			ПеренестиСутьВСодержание(Форма.Объект, Описание.Идентификатор);
			Продолжить;
		КонецЕсли;
		Карта = Форма.ПоляФормы.Добавить();
		Карта.Имя = "ПолеВида" + Формат(Форма.ПоляФормы.Количество(), "ЧГ=0");
		Карта.Идентификатор = Описание.Идентификатор;
		Карта.Заголовок = Описание.Заголовок;
		Карта.Обязательное = Описание.Обязательное;
		Карта.ТипПоля = Описание.ТипПоля;
		Карта.Изменено = Ложь;
		ЗначениеСтрокой = ЗначениеПоляДокумента(Форма.Объект, Карта.Идентификатор);
		ЗначениеРедактора = ЗначениеСтрокой;
		ОписаниеТипаРедактора = Новый ОписаниеТипов("Строка");
		Если Описание.ТипПоля = Перечисления.ТипыПолей.Число Тогда
			Попытка
				ЗначениеРедактора = ?(ПустаяСтрока(ЗначениеСтрокой), 0, Число(ЗначениеСтрокой));
				ОписаниеТипаРедактора = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(38, 15));
			Исключение
				// Некорректное старое значение остаётся строкой, чтобы его можно было исправить.
			КонецПопытки;
		ИначеЕсли Описание.ТипПоля = Перечисления.ТипыПолей.Дата Тогда
			Попытка
				ЗначениеРедактора = ?(ПустаяСтрока(ЗначениеСтрокой), Дата(1, 1, 1), ДатаИзСтрокиПоля(ЗначениеСтрокой));
				ОписаниеТипаРедактора = Новый ОписаниеТипов(
					"Дата",
					,
					,
					Новый КвалификаторыДаты(ЧастиДаты.Дата));
			Исключение
			КонецПопытки;
		КонецЕсли;
		Добавляемые.Добавить(Новый РеквизитФормы(Карта.Имя, ОписаниеТипаРедактора));
		НачальныеЗначения.Вставить(Карта.Имя, ЗначениеРедактора);
	КонецЦикла;
	Если Добавляемые.Количество() > 0 Тогда
		Форма.ИзменитьРеквизиты(Добавляемые);
	КонецЕсли;
	Для Каждого Карта Из Форма.ПоляФормы Цикл
		Форма[Карта.Имя] = НачальныеЗначения.Получить(Карта.Имя);
		Поле = Форма.Элементы.Добавить(Карта.Имя, Тип("ПолеФормы"), Форма.Элементы.ПоляВида);
		Поле.Вид = ВидПоляФормы.ПолеВвода;
		Поле.ПутьКДанным = Карта.Имя;
		Поле.Заголовок = Карта.Заголовок;
		Поле.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Лево;
		Поле.АвтоОтметкаНезаполненного = Карта.Обязательное;
		Поле.УстановитьДействие("ПриИзменении", "ПолеВидаПриИзменении");
		Если Карта.ТипПоля = Перечисления.ТипыПолей.ВыборИзСписка Тогда
			Для Каждого Значение Из НаименованияЗначенийСписка(Форма.Объект.ВидДокумента, Карта.Идентификатор) Цикл
				Поле.СписокВыбора.Добавить(Значение);
			КонецЦикла;
			Поле.РежимВыбораИзСписка = Истина;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПеренестиРедакторыВДокумент(Форма) Экспорт

	Для Каждого Карта Из Форма.ПоляФормы Цикл
		Если Не Карта.Изменено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаЗначения = Неопределено;
		Для Каждого Значение Из Форма.Объект.ЗначенияПолей Цикл
			Если Значение.Идентификатор = Карта.Идентификатор Тогда
				СтрокаЗначения = Значение;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СтрокаЗначения = Неопределено Тогда
			СтрокаЗначения = Форма.Объект.ЗначенияПолей.Добавить();
			СтрокаЗначения.Идентификатор = Карта.Идентификатор;
			СтрокаЗначения.Заголовок = Карта.Заголовок;
		КонецЕсли;
		СтрокаЗначения.ЗначениеСтрока = СтрокаЗначенияРедактора(Форма[Карта.Имя]);
	КонецЦикла;

КонецПроцедуры

Функция ЗначениеПоляДокумента(Документ, Идентификатор)

	Для Каждого Значение Из Документ.ЗначенияПолей Цикл
		Если Значение.Идентификатор = Идентификатор Тогда
			Возврат Значение.ЗначениеСтрока;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ЭтоПолеСутиДокумента(ЗаголовокПоля, ИдентификаторПоля)

	Метка = НРег(СокрЛП(ЗаголовокПоля));
	Ид = НРег(СокрЛП(ИдентификаторПоля));
	Возврат Метка = "суть" Или Метка = "содержание"
		Или Ид = "суть" Или Ид = "содержание";

КонецФункции

Процедура ПеренестиСутьВСодержание(Документ, ИдентификаторПоля)

	Если Не ПустаяСтрока(СокрЛП(Документ.Содержание)) Тогда
		Возврат;
	КонецЕсли;
	Текст = СокрЛП(ЗначениеПоляДокумента(Документ, ИдентификаторПоля));
	Если Не ПустаяСтрока(Текст) Тогда
		Документ.Содержание = Текст;
	КонецЕсли;

КонецПроцедуры

Функция СтрокаЗначенияРедактора(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0;ЧРД=.;ЧН=0");
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат ?(ЗначениеЗаполнено(Значение), Формат(Значение, "ДФ=dd.MM.yyyy"), "");
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

Функция ДатаИзСтрокиПоля(Значение)

	Текст = СокрЛП(Строка(Значение));
	ПозицияПробела = СтрНайти(Текст, " ");
	Если ПозицияПробела > 0 Тогда
		Текст = Лев(Текст, ПозицияПробела - 1);
	КонецЕсли;
	Попытка
		Возврат Дата(Текст);
	Исключение
	КонецПопытки;
	Части = СтрРазделить(Текст, ".");
	Если Части.Количество() <> 3 Тогда
		ВызватьИсключение "Неверная дата";
	КонецЕсли;
	Возврат Дата(Число(Части[2]), Число(Части[1]), Число(Части[0]));

КонецФункции

#КонецОбласти

#Область НачальнаяСтраница

Функция ДанныеНачальнойСтраницы() Экспорт

	Запрос = Новый Запрос;
	Привязка = ПривязкаПользователяДляИнтерфейса();
	Сотрудник = Привязка.Сотрудник;
	Пояснение = "Пользователь ИБ не указан в карточке сотрудника. Показаны все документы.";
	Если Привязка.Количество = 1 Тогда
		Пояснение = "Мои документы: вы автор или ответственный. В таблицах показаны первые 20 записей.";
	ИначеЕсли Привязка.Количество > 1 Тогда
		Пояснение = "Один пользователь ИБ указан у нескольких сотрудников. Обратитесь к администратору.";
	КонецЕсли;
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("ЕстьСотрудник", ЗначениеЗаполнено(Сотрудник));
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 20
	|	Ссылка,
	|	Номер,
	|	Дата,
	|	ВидДокумента,
	|	Статус,
	|	ТекущийЭтап
	|ИЗ
	|	Документ.ДокументСЭД
	|ГДЕ
	|	НЕ ПометкаУдаления
	|	И (НЕ &ЕстьСотрудник ИЛИ Автор = &Сотрудник ИЛИ Ответственный = &Сотрудник)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ,
	|	Номер УБЫВ";
	ТаблицаДокументов = Запрос.Выполнить().Выгрузить();
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Статус,
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Документ.ДокументСЭД
	|ГДЕ
	|	НЕ ПометкаУдаления
	|	И (НЕ &ЕстьСотрудник ИЛИ Автор = &Сотрудник ИЛИ Ответственный = &Сотрудник)
	|
	|СГРУППИРОВАТЬ ПО
	|	Статус";
	Счетчики = Запрос.Выполнить().Выгрузить();
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 20
	|	Ссылка,
	|	Номер,
	|	Дата,
	|	ВидДокумента,
	|	Статус,
	|	ТекущийЭтап
	|ИЗ
	|	Документ.ДокументСЭД
	|ГДЕ
	|	НЕ ПометкаУдаления
	|	И Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.НаСогласовании)
	|	И (НЕ &ЕстьСотрудник ИЛИ ТекущийСогласующий = &Сотрудник)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер";
	Согласования = Запрос.Выполнить().Выгрузить();
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Документ.ДокументСЭД
	|ГДЕ
	|	НЕ ПометкаУдаления
	|	И Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.НаСогласовании)
	|	И (НЕ &ЕстьСотрудник ИЛИ ТекущийСогласующий = &Сотрудник)";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Новый Структура(
		"Сотрудник,Пояснение,Документы,Согласования,Счетчики,ВсегоСогласований",
		Сотрудник,
		Пояснение,
		ТаблицаДокументов,
		Согласования,
		Счетчики,
		Выборка.Количество);

КонецФункции

Функция ПривязкаПользователяДляИнтерфейса() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Ссылка
	|ИЗ
	|	Справочник.Сотрудники
	|ГДЕ
	|	ИмяПользователяИБ = &Пользователь
	|	И ИмяПользователяИБ <> """"
	|	И НЕ ПометкаУдаления";
	Запрос.УстановитьПараметр("Пользователь", ИмяПользователя());
	Привязки = Запрос.Выполнить().Выгрузить();
	Сотрудник = Справочники.Сотрудники.ПустаяСсылка();
	Если Привязки.Количество() = 1 Тогда
		Сотрудник = Привязки[0].Ссылка;
	КонецЕсли;
	Возврат Новый Структура("Сотрудник,Количество", Сотрудник, Привязки.Количество());

КонецФункции

// Подсказки «Начала» по своим документам. Без внешней модели.
Функция РазборВниманияНачальнойСтраницы(ТекстВопроса = "") Экспорт

	Привязка = ПривязкаПользователяДляИнтерфейса();
	Сотрудник = Привязка.Сотрудник;
	ЕстьСотрудник = ЗначениеЗаполнено(Сотрудник);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("ЕстьСотрудник", ЕстьСотрудник);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТекущийЭтап КАК Этап,
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Документ.ДокументСЭД
	|ГДЕ
	|	НЕ ПометкаУдаления
	|	И Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.НаСогласовании)
	|	И (НЕ &ЕстьСотрудник ИЛИ ТекущийСогласующий = &Сотрудник)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТекущийЭтап
	|
	|УПОРЯДОЧИТЬ ПО
	|	Этап";
	ЭтапыОжидания = Запрос.Выполнить().Выгрузить();

	Запрос.Текст =
	"ВЫБРАТЬ
	|	Статус,
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Документ.ДокументСЭД
	|ГДЕ
	|	НЕ ПометкаУдаления
	|	И (НЕ &ЕстьСотрудник ИЛИ Автор = &Сотрудник ИЛИ Ответственный = &Сотрудник)
	|	И Статус В (
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Черновик),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Отклонен),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.НаДоработке))
	|
	|СГРУППИРОВАТЬ ПО
	|	Статус";
	СчетчикиСвои = Запрос.Выполнить().Выгрузить();
	Черновики = 0;
	Отклонены = 0;
	НаДоработке = 0;
	Для Каждого Счетчик Из СчетчикиСвои Цикл
		Если Счетчик.Статус = Перечисления.СтатусыДокументов.Черновик Тогда
			Черновики = Счетчик.Количество;
		ИначеЕсли Счетчик.Статус = Перечисления.СтатусыДокументов.Отклонен Тогда
			Отклонены = Счетчик.Количество;
		ИначеЕсли Счетчик.Статус = Перечисления.СтатусыДокументов.НаДоработке Тогда
			НаДоработке = Счетчик.Количество;
		КонецЕсли;
	КонецЦикла;

	Фраза = НРег(СокрЛП(ТекстВопроса));
	Режим = "ожидание";
	ЭтапФильтр = 0;
	Если Не ПустаяСтрока(Фраза) Тогда
		Если СтрНайти(Фраза, "чернов") > 0 Тогда
			Режим = "черновики";
		ИначеЕсли СтрНайти(Фраза, "отклон") > 0 Тогда
			Режим = "отклонены";
		ИначеЕсли СтрНайти(Фраза, "доработ") > 0 Тогда
			Режим = "доработка";
		ИначеЕсли СтрНайти(Фраза, "этап") > 0 Тогда
			Режим = "этап";
			Для Номер = 1 По 9 Цикл
				Если СтрНайти(Фраза, Строка(Номер)) > 0 Тогда
					ЭтапФильтр = Номер;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ЭтапФильтр = 0 Тогда
				Режим = "ожидание";
			КонецЕсли;
		ИначеЕсли СтрНайти(Фраза, "ждёт") > 0
			Или СтрНайти(Фраза, "ждет") > 0
			Или СтрНайти(Фраза, "ожид") > 0
			Или СтрНайти(Фраза, "соглас") > 0
			Или СтрНайти(Фраза, "вниман") > 0 Тогда
			Режим = "ожидание";
		Иначе
			Режим = "подсказка";
		КонецЕсли;
	КонецЕсли;

	Таблица = НоваяТаблицаВнимания();
	Фразы = Новый Массив;

	Если Режим = "черновики" Тогда
		ДобавитьДокументыВнимания(Таблица, Сотрудник, ЕстьСотрудник, Перечисления.СтатусыДокументов.Черновик, 0, "Черновик без отправки");
		Если Черновики = 0 Тогда
			Фразы.Добавить("Черновиков нет.");
		Иначе
			Фразы.Добавить(СтрШаблон("%1 черновик(ов) без отправки на согласование.", Черновики));
		КонецЕсли;
	ИначеЕсли Режим = "отклонены" Тогда
		ДобавитьДокументыВнимания(Таблица, Сотрудник, ЕстьСотрудник, Перечисления.СтатусыДокументов.Отклонен, 0, "Отклонён");
		Если Отклонены = 0 Тогда
			Фразы.Добавить("Отклонённых документов нет.");
		Иначе
			Фразы.Добавить(СтрШаблон("%1 отклонённых документ(ов).", Отклонены));
		КонецЕсли;
	ИначеЕсли Режим = "доработка" Тогда
		ДобавитьДокументыВнимания(Таблица, Сотрудник, ЕстьСотрудник, Перечисления.СтатусыДокументов.НаДоработке, 0, "На доработке");
		Если НаДоработке = 0 Тогда
			Фразы.Добавить("Документов на доработке нет.");
		Иначе
			Фразы.Добавить(СтрШаблон("%1 документ(ов) на доработке.", НаДоработке));
		КонецЕсли;
	ИначеЕсли Режим = "этап" Тогда
		ДобавитьДокументыВнимания(
			Таблица,
			Сотрудник,
			ЕстьСотрудник,
			Перечисления.СтатусыДокументов.НаСогласовании,
			ЭтапФильтр,
			"Ждёт решения на этапе " + ЭтапФильтр);
		Фразы.Добавить(СтрШаблон(
			"%1 документ(ов) на этапе %2 ждут вашего решения.",
			Таблица.Количество(),
			ЭтапФильтр));
	Иначе
		ДобавитьДокументыВнимания(
			Таблица,
			Сотрудник,
			ЕстьСотрудник,
			Перечисления.СтатусыДокументов.НаСогласовании,
			0,
			"Ждёт вашего решения");
		Если ЭтапыОжидания.Количество() = 0 Тогда
			Фразы.Добавить("Сейчас ничего не ждёт вашего решения.");
		Иначе
			Для Каждого СтрокаЭтапа Из ЭтапыОжидания Цикл
				Фразы.Добавить(СтрШаблон(
					"%1 документ(ов) на этапе %2 ждут вашего решения.",
					СтрокаЭтапа.Количество,
					СтрокаЭтапа.Этап));
			КонецЦикла;
		КонецЕсли;
		Если Черновики > 0 Тогда
			Фразы.Добавить(СтрШаблон("%1 черновик(ов) без отправки.", Черновики));
		КонецЕсли;
		Если Отклонены > 0 Тогда
			Фразы.Добавить(СтрШаблон("%1 отклонённых.", Отклонены));
		КонецЕсли;
		Если НаДоработке > 0 Тогда
			Фразы.Добавить(СтрШаблон("%1 на доработке.", НаДоработке));
		КонецЕсли;
		Если Режим = "подсказка" Тогда
			Фразы.Вставить(0,
				"Спросите: «что ждёт меня», «этап 1», «черновики», «отклонённые» или «на доработке».");
		КонецЕсли;
	КонецЕсли;

	Пока Таблица.Количество() > 10 Цикл
		Таблица.Удалить(Таблица.Количество() - 1);
	КонецЦикла;

	Возврат Новый Структура("ТекстВнимания,ДокументыВнимания", СтрСоединить(Фразы, " "), Таблица);

КонецФункции

Функция НоваяТаблицаВнимания()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.ДокументСЭД"));
	Таблица.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)));
	Таблица.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	Таблица.Колонки.Добавить("ВидДокумента", Новый ОписаниеТипов("СправочникСсылка.ВидыДокументов"));
	Таблица.Колонки.Добавить("Статус", Новый ОписаниеТипов("ПеречислениеСсылка.СтатусыДокументов"));
	Таблица.Колонки.Добавить("ТекущийЭтап", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0, ДопустимыйЗнак.Неотрицательный)));
	Таблица.Колонки.Добавить("Почему", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(120)));
	Возврат Таблица;

КонецФункции

Процедура ДобавитьДокументыВнимания(Таблица, Сотрудник, ЕстьСотрудник, Статус, Этап, Почему)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("ЕстьСотрудник", ЕстьСотрудник);
	Запрос.УстановитьПараметр("Статус", Статус);
	Запрос.УстановитьПараметр("Этап", Этап);
	Запрос.УстановитьПараметр("ФильтрЭтапа", Этап > 0);

	Если Статус = Перечисления.СтатусыДокументов.НаСогласовании Тогда
		УсловиеСотрудника = "НЕ &ЕстьСотрудник ИЛИ ТекущийСогласующий = &Сотрудник";
	Иначе
		УсловиеСотрудника = "НЕ &ЕстьСотрудник ИЛИ Автор = &Сотрудник ИЛИ Ответственный = &Сотрудник";
	КонецЕсли;

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 10
	|	Ссылка,
	|	Номер,
	|	Дата,
	|	ВидДокумента,
	|	Статус,
	|	ТекущийЭтап
	|ИЗ
	|	Документ.ДокументСЭД
	|ГДЕ
	|	НЕ ПометкаУдаления
	|	И Статус = &Статус
	|	И (НЕ &ФильтрЭтапа ИЛИ ТекущийЭтап = &Этап)
	|	И (" + УсловиеСотрудника + ")
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТекущийЭтап,
	|	Дата,
	|	Номер";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Выборка);
		Строка.Почему = Почему;
	КонецЦикла;

КонецПроцедуры

Процедура УстановитьСоставНачальнойСтраницы() Экспорт

	Настройки = Новый НастройкиНачальнойСтраницы;
	Состав = Новый СоставФормНачальнойСтраницы;
	Состав.ЛеваяКолонка.Добавить("ОбщаяФорма.НачальнаяСтраница");
	Настройки.УстановитьСоставФорм(Состав);
	ХранилищеСистемныхНастроек.Сохранить(
		"Общее/НастройкиНачальнойСтраницы",
		"",
		Настройки,
		,
		ИмяПользователя());

КонецПроцедуры

