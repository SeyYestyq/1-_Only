#Область ПрограммныйИнтерфейс

// Возвращает двоичные данные единой печатной формы в формате PDF.
// ДокументСсылка - ДокументСсылка.ДокументСЭД.
// Возвращаемое значение - ДвоичныеДанные.
Функция СформироватьPDF(ДокументСсылка) Экспорт

	Поток = Новый ПотокВПамяти;
	СформироватьТабличныйДокумент(ДокументСсылка).Записать(Поток, ТипФайлаТабличногоДокумента.PDF);
	Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();

КонецФункции

// Возвращает файл для кнопки «Печать» и для вложения в письмо.
// На коммерческой платформе — PDF; на учебной 8.5 — HTML (запись табличного документа запрещена).
Функция СформироватьВложениеПечатнойФормы(ДокументСсылка) Экспорт

	Результат = Новый Структура(
		"Успех, ИмяФайла, Текст, ФорматВложения, ИмяФайлаКлиент",
		Ложь, "", "", "", "");

	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	ИмяБазы = СтрШаблон(
		"%1_%2",
		СокрЛП(ДокументОбъект.Номер),
		СтрЗаменить(Строка(ДокументОбъект.ВидДокумента), " ", "_"));

	ИмяФайлаPDF = ПолучитьИмяВременногоФайла("pdf");

	Попытка
		ФайлPDF = СформироватьPDF(ДокументСсылка);
		ФайлPDF.Записать(ИмяФайлаPDF);
		Результат.Успех = Истина;
		Результат.ИмяФайла = ИмяФайлаPDF;
		Результат.ФорматВложения = "PDF";
		Результат.ИмяФайлаКлиент = ИмяБазы + ".pdf";
		Результат.Текст = "Печатная форма готова (PDF)";
		Возврат Результат;
	Исключение
		ТекстОшибкиPDF = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Попытка
			УдалитьФайлы(ИмяФайлаPDF);
		Исключение
		КонецПопытки;
		// Учебная лицензия: «Функции печати и сохранения табличного документа … недоступны».
		Если СтрНайти(ВРег(ТекстОшибкиPDF), "ЛИЦЕНЗ") = 0
			И СтрНайти(ВРег(ТекстОшибкиPDF), "УЧЕБН") = 0
			И СтрНайти(ВРег(ТекстОшибкиPDF), "ФУНКЦИИ ПЕЧАТИ И СОХРАНЕНИЯ") = 0 Тогда
			Результат.Текст = ТекстОшибкиPDF;
			Возврат Результат;
		КонецЕсли;
	КонецПопытки;

	Попытка
		ИмяФайлаHTML = ПолучитьИмяВременногоФайла("html");
		Запись = Новый ЗаписьТекста(ИмяФайлаHTML, КодировкаТекста.UTF8);
		Запись.Записать(ТекстHTMLПечатнойФормы(ДокументОбъект));
		Запись.Закрыть();
		Результат.Успех = Истина;
		Результат.ИмяФайла = ИмяФайлаHTML;
		Результат.ФорматВложения = "HTML";
		Результат.ИмяФайлаКлиент = ИмяБазы + ".html";
		Результат.Текст =
			"На учебной версии PDF недоступен. Открыта HTML-копия печатной формы.";
	Исключение
		Результат.Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Собирает табличный документ по сохраненным данным и виду документа.
// ДокументСсылка - ДокументСсылка.ДокументСЭД.
// Возвращаемое значение - ТабличныйДокумент.
Функция СформироватьТабличныйДокумент(ДокументСсылка) Экспорт

	Возврат ПечатнаяФорма(ДокументСсылка.ПолучитьОбъект());

КонецФункции

// Заполняет области единого макета для переданного документа.
// ДокументОбъект - ДокументОбъект.ДокументСЭД.
// Возвращаемое значение - ТабличныйДокумент.
Функция ПечатнаяФорма(ДокументОбъект) Экспорт

	Макет = Документы.ДокументСЭД.ПолучитьМакет("ПечатнаяФормаДокумента");
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;

	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Номер = ДокументОбъект.Номер;
	ОбластьШапка.Параметры.Дата = Формат(ДокументОбъект.Дата, "ДЛФ=D");
	ОбластьШапка.Параметры.ВидДокумента = Строка(ДокументОбъект.ВидДокумента);
	ОбластьШапка.Параметры.Статус = Строка(ДокументОбъект.Статус);
	ОбластьШапка.Параметры.Категория = Строка(ДокументОбъект.Категория);
	ОбластьШапка.Параметры.Автор = Строка(ДокументОбъект.Автор);
	ОбластьШапка.Параметры.Ответственный = Строка(ДокументОбъект.Ответственный);
	ОбластьШапка.Параметры.Руководитель = Строка(РуководительОтветственного(ДокументОбъект));
	ОбластьШапка.Параметры.ТекущийЭтап = ДокументОбъект.ТекущийЭтап;
	ОбластьШапка.Параметры.ВсегоЭтапов = ДокументОбъект.ВсегоЭтапов;
	ТабличныйДокумент.Вывести(ОбластьШапка);

	ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("ЗаголовокПолей"));
	ОбластьСтрокаПоля = Макет.ПолучитьОбласть("СтрокаПоля");
	Для Каждого СтрокаЗначения Из ЗначенияДляПечати(ДокументОбъект) Цикл
		ОбластьСтрокаПоля.Параметры.Заголовок = СтрокаЗначения.Заголовок;
		ОбластьСтрокаПоля.Параметры.ЗначениеСтрока = СтрокаЗначения.ЗначениеСтрока;
		ТабличныйДокумент.Вывести(ОбластьСтрокаПоля);
	КонецЦикла;

	ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("ЗаголовокМаршрута"));
	ОбластьСтрокаМаршрута = Макет.ПолучитьОбласть("СтрокаМаршрута");
	Для Каждого Этап Из ЭтапыПечати(ДокументОбъект) Цикл
		ОбластьСтрокаМаршрута.Параметры.НомерЭтапа = Этап.Номер;
		ОбластьСтрокаМаршрута.Параметры.НазваниеЭтапа = Этап.Название;
		ОбластьСтрокаМаршрута.Параметры.Согласующий = Этап.Согласующий;
		ОбластьСтрокаМаршрута.Параметры.Решение = Этап.Решение;
		ОбластьСтрокаМаршрута.Параметры.ДатаРешения = Этап.ДатаРешения;
		ОбластьСтрокаМаршрута.Параметры.Комментарий = Этап.Комментарий;
		ТабличныйДокумент.Вывести(ОбластьСтрокаМаршрута);
	КонецЦикла;
	ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("Подвал"));

	Возврат ТабличныйДокумент;

КонецФункции

// Возвращает руководителя для писем и печати: поле документа, иначе из карточки ответственного.
// ДокументОбъект - ДокументОбъект.ДокументСЭД.
// Возвращаемое значение - СправочникСсылка.Сотрудники.
Функция РуководительОтветственного(ДокументОбъект) Экспорт

	Если ЗначениеЗаполнено(ДокументОбъект.Руководитель) Тогда
		Возврат ДокументОбъект.Руководитель;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДокументОбъект.Ответственный) Тогда
		Возврат Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;
	Возврат ДокументОбъект.Ответственный.Руководитель;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗначенияДляПечати(ДокументОбъект)

	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(ДокументОбъект.ВидДокумента) Тогда
		Возврат Результат;
	КонецЕсли;
	Значения = Новый Соответствие;
	Для Каждого СтрокаЗначения Из ДокументОбъект.ЗначенияПолей Цикл
		Значения.Вставить(СтрокаЗначения.Идентификатор, СтрокаЗначения.ЗначениеСтрока);
	КонецЦикла;
	Вид = ДокументОбъект.ВидДокумента.ПолучитьОбъект();
	Поля = Вид.Поля.Выгрузить();
	Поля.Сортировать("Порядок");
	Для Каждого Поле Из Поля Цикл
		Если Поле.Скрыто Тогда
			Продолжить;
		КонецЕсли;
		Метка = НРег(СокрЛП(Поле.Заголовок));
		Ид = НРег(СокрЛП(Поле.Идентификатор));
		Если Метка = "суть" Или Метка = "содержание" Или Ид = "суть" Или Ид = "содержание" Тогда
			Продолжить;
		КонецЕсли;
		Значение = Значения.Получить(Поле.Идентификатор);
		Результат.Добавить(Новый Структура("Заголовок, ЗначениеСтрока",
			Поле.Заголовок, ?(Значение = Неопределено, "", Значение)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЭтапыПечати(ДокументОбъект)

	Решения = Новый Соответствие;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ История.Этап КАК Этап, История.Решение КАК Решение
	|ИЗ РегистрСведений.ИсторияСогласования КАК История
	|ГДЕ История.Документ = &Документ И История.Цикл = &Цикл И История.Этап > 0
	|УПОРЯДОЧИТЬ ПО История.НомерЗаписи");
	Запрос.УстановитьПараметр("Документ", ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("Цикл", ДокументОбъект.ЦиклСогласования);
	История = Запрос.Выполнить().Выбрать();
	Пока История.Следующий() Цикл
		Решения.Вставить(История.Этап, Строка(История.Решение));
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого Этап Из Согласование.ЭтапыДляТаймлайна(ДокументОбъект.Ссылка) Цикл
		Решение = Решения.Получить(Этап.Номер);
		Результат.Добавить(Новый Структура("Номер, Название, Согласующий, Решение, ДатаРешения, Комментарий",
			Этап.Номер, Этап.Название, Этап.Согласующий, ?(Решение = Неопределено, Этап.Состояние, Решение),
			?(ЗначениеЗаполнено(Этап.Дата), Формат(Этап.Дата, "ДЛФ=DT"), ""), Этап.Комментарий));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ТекстHTMLПечатнойФормы(ДокументОбъект)

	Строки = Новый Массив;
	Строки.Добавить("<!DOCTYPE html><html><head><meta charset=""utf-8"">");
	Строки.Добавить("<title>ДокМаршрут</title>");
	Строки.Добавить("<style>body{font-family:sans-serif;margin:24px}h1{font-size:18px}");
	Строки.Добавить("table{border-collapse:collapse;width:100%;margin:12px 0}");
	Строки.Добавить("td,th{border:1px solid #ccc;padding:6px 8px;text-align:left}</style></head><body>");
	Строки.Добавить(СтрШаблон("<h1>%1 № %2 от %3</h1>",
		ЭкранироватьHTML(Строка(ДокументОбъект.ВидДокумента)),
		ЭкранироватьHTML(СокрЛП(ДокументОбъект.Номер)),
		ЭкранироватьHTML(Формат(ДокументОбъект.Дата, "ДЛФ=D"))));
	Строки.Добавить(СтрШаблон("<p>Статус: <b>%1</b>. Ответственный: %2. Этап: %3 из %4.</p>",
		ЭкранироватьHTML(Строка(ДокументОбъект.Статус)),
		ЭкранироватьHTML(Строка(ДокументОбъект.Ответственный)),
		ДокументОбъект.ТекущийЭтап,
		ДокументОбъект.ВсегоЭтапов));

	Строки.Добавить(СтрШаблон("<p>Категория: %1. Автор: %2. Руководитель: %3.</p>",
		ЭкранироватьHTML(ДокументОбъект.Категория), ЭкранироватьHTML(ДокументОбъект.Автор),
		ЭкранироватьHTML(РуководительОтветственного(ДокументОбъект))));
	Строки.Добавить("<h2>Поля</h2><table><tr><th>Поле</th><th>Значение</th></tr>");
	Для Каждого СтрокаЗначения Из ЗначенияДляПечати(ДокументОбъект) Цикл
		Строки.Добавить(СтрШаблон("<tr><td>%1</td><td>%2</td></tr>",
			ЭкранироватьHTML(СтрокаЗначения.Заголовок),
			ЭкранироватьHTML(СтрокаЗначения.ЗначениеСтрока)));
	КонецЦикла;
	Строки.Добавить("</table>");

	Строки.Добавить("<h2>Маршрут</h2><table><tr><th>№</th><th>Этап</th><th>Согласующий</th>"
		+ "<th>Решение</th><th>Дата</th><th>Комментарий</th></tr>");
	Для Каждого Этап Из ЭтапыПечати(ДокументОбъект) Цикл
		Строки.Добавить(СтрШаблон("<tr><td>%1</td><td>%2</td><td>%3</td><td>%4</td><td>%5</td><td>%6</td></tr>",
			Этап.Номер, ЭкранироватьHTML(Этап.Название), ЭкранироватьHTML(Этап.Согласующий),
			ЭкранироватьHTML(Этап.Решение), ЭкранироватьHTML(Этап.ДатаРешения), ЭкранироватьHTML(Этап.Комментарий)));
	КонецЦикла;
	Строки.Добавить("</table>");
	Строки.Добавить("<p><small>Сформировано ДокМаршрут. На учебной платформе вместо PDF используется HTML.</small></p>");
	Строки.Добавить("</body></html>");
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ЭкранироватьHTML(Значение)

	Текст = Строка(Значение);
	Текст = СтрЗаменить(Текст, "&", "&amp;");
	Текст = СтрЗаменить(Текст, "<", "&lt;");
	Текст = СтрЗаменить(Текст, ">", "&gt;");
	Текст = СтрЗаменить(Текст, """", "&quot;");
	Возврат Текст;

КонецФункции

#КонецОбласти
