Функция ОтправитьНаСогласование(ДокументСсылка) Экспорт

	Результат = Новый Структура("Успех, Текст", Ложь, "");

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("Документ.ДокументСЭД");
		Элемент.УстановитьЗначение("Ссылка", ДокументСсылка);
		Блокировка.Заблокировать();

		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		Если ДокументОбъект.Статус <> Перечисления.СтатусыДокументов.Черновик
			И ДокументОбъект.Статус <> Перечисления.СтатусыДокументов.НаДоработке Тогда
			ВызватьИсключение "Отправить на согласование можно из статуса «Черновик» или «На доработке».";
		КонецЕсли;

		ВидОбъект = ДокументОбъект.ВидДокумента.ПолучитьОбъект();
		Если ВидОбъект.СтатусНастройки <> Перечисления.СтатусыНастройкиВида.Готов Тогда
			ВызватьИсключение "В поле «Вид документа» выберите опубликованный вид (статус «Готов»).";
		КонецЕсли;

		ДинамическиеФормы.ДобавитьНедостающиеПоляИзВида(ДокументОбъект);

		ТекстПроверки = ДинамическиеФормы.ТекстПроверкиОбязательных(ДокументОбъект);
		Если Не ПустаяСтрока(ТекстПроверки) Тогда
			ВызватьИсключение ТекстПроверки;
		КонецЕсли;

		ДокументОбъект.МаршрутСнимок.Очистить();
		Для Каждого СтрокаМаршрута Из ВидОбъект.Маршрут Цикл
			НоваяСтрока = ДокументОбъект.МаршрутСнимок.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМаршрута);
		КонецЦикла;

		ДокументОбъект.ВсегоЭтапов = ДокументОбъект.МаршрутСнимок.Количество();
		ДокументОбъект.ТекущийЭтап = 1;
		ДокументОбъект.ЦиклСогласования = ДокументОбъект.ЦиклСогласования + 1;
		Если ДокументОбъект.ВсегоЭтапов > 0 Тогда
			ДокументОбъект.ТекущийСогласующий = ДокументОбъект.МаршрутСнимок[0].Согласующий;
		КонецЕсли;
		ДокументОбъект.Статус = Перечисления.СтатусыДокументов.НаСогласовании;
		ДокументОбъект.ДополнительныеСвойства.Вставить("РазрешитьЗаписьДвижка", Истина);
		ДокументОбъект.Записать();

		ЗаписатьИсторию(ДокументСсылка, ДокументОбъект, Перечисления.РешенияСогласования.ОтправленНаСогласование, "");

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Результат.Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Уведомления.ОтправитьПоСобытию(ДокументСсылка, "ОтправленНаСогласование");

	Результат.Успех = Истина;
	Результат.Текст = "Документ отправлен на согласование.";
	Возврат Результат;

КонецФункции

Функция ПринятьРешение(ДокументСсылка, Решение, Комментарий) Экспорт

	Результат = Новый Структура("Успех, Текст", Ложь, "");
	Если Решение = Перечисления.РешенияСогласования.Отклонено И ПустаяСтрока(Комментарий) Тогда
		Результат.Текст = "При отклонении укажите в комментарии, что нужно исправить.";
		Возврат Результат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("Документ.ДокументСЭД");
		Элемент.УстановитьЗначение("Ссылка", ДокументСсылка);
		Блокировка.Заблокировать();

		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();

		// Согласовать / отклонить — только на согласовании.
		// Вернуть на доработку — с согласования или после отклонения (FR-S5 / брендбук §12).
		Если Решение = Перечисления.РешенияСогласования.ВозвращенНаДоработку Тогда
			Если ДокументОбъект.Статус <> Перечисления.СтатусыДокументов.НаСогласовании
				И ДокументОбъект.Статус <> Перечисления.СтатусыДокументов.Отклонен Тогда
				ВызватьИсключение "Вернуть на доработку можно, если документ на согласовании или отклонён.";
			КонецЕсли;
			Если ДокументОбъект.Статус = Перечисления.СтатусыДокументов.НаСогласовании
				И Не ЭтоАктивныйСогласующий(ДокументОбъект) Тогда
				ВызватьИсключение ТекстОтказЧужому(ДокументОбъект);
			КонецЕсли;
		ИначеЕсли ДокументОбъект.Статус <> Перечисления.СтатусыДокументов.НаСогласовании Тогда
			ВызватьИсключение "Документ не на согласовании. Сейчас решение недоступно.";
		ИначеЕсли Не ЭтоАктивныйСогласующий(ДокументОбъект) Тогда
			ВызватьИсключение ТекстОтказЧужому(ДокументОбъект);
		КонецЕсли;

		ЗаписатьИсторию(ДокументСсылка, ДокументОбъект, Решение, Комментарий);

		Если Решение = Перечисления.РешенияСогласования.Согласовано Тогда
			Если ДокументОбъект.ТекущийЭтап >= ДокументОбъект.ВсегоЭтапов Тогда
				ДокументОбъект.Статус = Перечисления.СтатусыДокументов.Согласован;
				ДокументОбъект.ТекущийСогласующий = Справочники.Сотрудники.ПустаяСсылка();
			Иначе
				ДокументОбъект.ТекущийЭтап = ДокументОбъект.ТекущийЭтап + 1;
				Индекс = ДокументОбъект.ТекущийЭтап - 1;
				ДокументОбъект.ТекущийСогласующий = ДокументОбъект.МаршрутСнимок[Индекс].Согласующий;
			КонецЕсли;
		ИначеЕсли Решение = Перечисления.РешенияСогласования.Отклонено Тогда
			ДокументОбъект.Статус = Перечисления.СтатусыДокументов.Отклонен;
			ДокументОбъект.ТекущийСогласующий = Справочники.Сотрудники.ПустаяСсылка();
		ИначеЕсли Решение = Перечисления.РешенияСогласования.ВозвращенНаДоработку Тогда
			ДокументОбъект.Статус = Перечисления.СтатусыДокументов.НаДоработке;
			ДокументОбъект.ТекущийЭтап = 0;
			ДокументОбъект.ТекущийСогласующий = Справочники.Сотрудники.ПустаяСсылка();
		КонецЕсли;

		ДокументОбъект.ДополнительныеСвойства.Вставить("РазрешитьЗаписьДвижка", Истина);
		ДокументОбъект.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Результат.Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Уведомления.ОтправитьПоСобытию(ДокументСсылка, Строка(Решение), Комментарий);

	Результат.Успех = Истина;
	Если Решение = Перечисления.РешенияСогласования.Согласовано Тогда
		Результат.Текст = "Согласовано.";
	ИначеЕсли Решение = Перечисления.РешенияСогласования.Отклонено Тогда
		Результат.Текст = "Документ отклонён.";
	ИначеЕсли Решение = Перечисления.РешенияСогласования.ВозвращенНаДоработку Тогда
		Результат.Текст = "Документ возвращён на доработку.";
	Иначе
		Результат.Текст = "Решение записано.";
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЭтоАктивныйСогласующий(ДокументОбъект) Экспорт

	Если Не ЗначениеЗаполнено(ДокументОбъект.ТекущийСогласующий) Тогда
		Возврат Ложь;
	КонецЕсли;

	Сотрудник = ТекущийСотрудник();
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		// Учебная база: пока никто не привязан к ИБ — не блокируем демо.
		Возврат Не ЕстьПривязкиПользователейИБ();
	КонецЕсли;

	Возврат Сотрудник = ДокументОбъект.ТекущийСогласующий;

КонецФункции

Функция ТекущийСотрудник() Экспорт

	Имя = ИмяПользователя();
	Если ПустаяСтрока(Имя) Тогда
		Возврат Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сотрудники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.ИмяПользователяИБ = &Имя
	|	И НЕ Сотрудники.ПометкаУдаления";
	Запрос.УстановитьПараметр("Имя", Имя);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Сотрудники.ПустаяСсылка();

КонецФункции

Функция ЕстьПривязкиПользователейИБ()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сотрудники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.ИмяПользователяИБ <> """"
	|	И НЕ Сотрудники.ПометкаУдаления";
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Функция ТекстОтказЧужому(ДокументОбъект)

	Если ЗначениеЗаполнено(ДокументОбъект.ТекущийСогласующий) Тогда
		Возврат "Сейчас документ согласует " + Строка(ДокументОбъект.ТекущийСогласующий)
			+ ". Решение может принять только этот сотрудник.";
	КонецЕсли;
	Возврат "Нет текущего согласующего. Решение сейчас недоступно.";

КонецФункции

Функция ИсторияДляКарточки(ДокументСсылка) Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ДатаВремя", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	Таблица.Колонки.Добавить("Этап", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0, ДопустимыйЗнак.Неотрицательный)));
	Таблица.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Таблица.Колонки.Добавить("Решение", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(80)));
	Таблица.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0)));

	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Таблица;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	История.ДатаВремя КАК ДатаВремя,
	|	История.Этап КАК Этап,
	|	История.Сотрудник КАК Сотрудник,
	|	История.Решение КАК Решение,
	|	История.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.ИсторияСогласования КАК История
	|ГДЕ
	|	История.Документ = &Документ
	|УПОРЯДОЧИТЬ ПО
	|	История.Цикл,
	|	История.НомерЗаписи";
	Запрос.УстановитьПараметр("Документ", ДокументСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.ДатаВремя = Выборка.ДатаВремя;
		СтрокаТаблицы.Этап = Выборка.Этап;
		СтрокаТаблицы.Сотрудник = Строка(Выборка.Сотрудник);
		СтрокаТаблицы.Решение = Строка(Выборка.Решение);
		СтрокаТаблицы.Комментарий = Выборка.Комментарий;
	КонецЦикла;
	Возврат Таблица;

КонецФункции

Функция ЭтапыДляТаймлайна(ДокументСсылка) Экспорт

	// H-04: Номер, Название, Согласующий, Состояние (Пройден/Текущий/Ожидает/Отклонён), Дата, Комментарий.
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номер", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0, ДопустимыйЗнак.Неотрицательный)));
	Результат.Колонки.Добавить("Название", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	Результат.Колонки.Добавить("Согласующий", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Результат.Колонки.Добавить("Состояние", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)));
	Результат.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	Результат.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0)));

	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Результат;
	КонецЕсли;

	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	ТекущийЭтап = ДокументОбъект.ТекущийЭтап;
	Статус = ДокументОбъект.Статус;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	История.Этап КАК Этап,
	|	История.Решение КАК Решение,
	|	История.ДатаВремя КАК ДатаВремя,
	|	История.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.ИсторияСогласования КАК История
	|ГДЕ
	|	История.Документ = &Документ
	|	И История.Цикл = &Цикл
	|УПОРЯДОЧИТЬ ПО
	|	История.НомерЗаписи";
	Запрос.УстановитьПараметр("Документ", ДокументСсылка);
	Запрос.УстановитьПараметр("Цикл", ДокументОбъект.ЦиклСогласования);
	История = Запрос.Выполнить().Выгрузить();

	ДатыПоЭтапам = Новый Соответствие;
	КомментарииПоЭтапам = Новый Соответствие;
	ОтклонённыйЭтап = 0;
	Для Каждого СтрокаИстории Из История Цикл
		Если СтрокаИстории.Этап > 0 Тогда
			ДатыПоЭтапам.Вставить(СтрокаИстории.Этап, СтрокаИстории.ДатаВремя);
			Если Не ПустаяСтрока(СтрокаИстории.Комментарий) Тогда
				КомментарииПоЭтапам.Вставить(СтрокаИстории.Этап, СтрокаИстории.Комментарий);
			КонецЕсли;
			Если СтрокаИстории.Решение = Перечисления.РешенияСогласования.Отклонено Тогда
				ОтклонённыйЭтап = СтрокаИстории.Этап;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаМаршрута Из ДокументОбъект.МаршрутСнимок Цикл
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Номер = СтрокаМаршрута.НомерЭтапа;
		НоваяСтрока.Название = СтрокаМаршрута.НазваниеЭтапа;
		НоваяСтрока.Согласующий = Строка(СтрокаМаршрута.Согласующий);

		Номер = СтрокаМаршрута.НомерЭтапа;
		Если Статус = Перечисления.СтатусыДокументов.Отклонен И Номер = ОтклонённыйЭтап Тогда
			НоваяСтрока.Состояние = "Отклонён";
		ИначеЕсли Статус = Перечисления.СтатусыДокументов.Отклонен И ОтклонённыйЭтап > 0 И Номер > ОтклонённыйЭтап Тогда
			НоваяСтрока.Состояние = "Ожидает";
		ИначеЕсли Статус = Перечисления.СтатусыДокументов.Отклонен И ОтклонённыйЭтап > 0 И Номер < ОтклонённыйЭтап Тогда
			НоваяСтрока.Состояние = "Пройден";
		ИначеЕсли Статус = Перечисления.СтатусыДокументов.Согласован Тогда
			НоваяСтрока.Состояние = "Пройден";
		ИначеЕсли Статус = Перечисления.СтатусыДокументов.НаСогласовании Тогда
			Если Номер < ТекущийЭтап Тогда
				НоваяСтрока.Состояние = "Пройден";
			ИначеЕсли Номер = ТекущийЭтап Тогда
				НоваяСтрока.Состояние = "Текущий";
			Иначе
				НоваяСтрока.Состояние = "Ожидает";
			КонецЕсли;
		Иначе
			// Черновик / на доработке — все этапы ожидающие (или снимок пуст).
			НоваяСтрока.Состояние = "Ожидает";
		КонецЕсли;

		ДатаЭтапа = ДатыПоЭтапам.Получить(Номер);
		Если ДатаЭтапа <> Неопределено Тогда
			НоваяСтрока.Дата = ДатаЭтапа;
		КонецЕсли;
		КомментарийЭтапа = КомментарииПоЭтапам.Получить(Номер);
		Если КомментарийЭтапа <> Неопределено Тогда
			НоваяСтрока.Комментарий = КомментарийЭтапа;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ЗаписатьИсторию(ДокументСсылка, ДокументОбъект, Решение, Комментарий)

	// Выбрать(<Начало>, <Конец>, <Отбор>) — отбор только 3-м параметром.
	// Выбрать(Структура) даёт «Недопустимое значение параметра (параметр номер '1')».
	МаксНомер = 0;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(История.НомерЗаписи), 0) КАК МаксНомер
	|ИЗ
	|	РегистрСведений.ИсторияСогласования КАК История
	|ГДЕ
	|	История.Документ = &Документ
	|	И История.Цикл = &Цикл";
	Запрос.УстановитьПараметр("Документ", ДокументСсылка);
	Запрос.УстановитьПараметр("Цикл", ДокументОбъект.ЦиклСогласования);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		МаксНомер = Выборка.МаксНомер;
	КонецЕсли;

	Менеджер = РегистрыСведений.ИсторияСогласования.СоздатьМенеджерЗаписи();
	Менеджер.Документ = ДокументСсылка;
	Менеджер.Цикл = ДокументОбъект.ЦиклСогласования;
	Менеджер.НомерЗаписи = МаксНомер + 1;
	Менеджер.Этап = ?(ДокументОбъект.ТекущийЭтап = 0, 0, ДокументОбъект.ТекущийЭтап);
	Менеджер.Сотрудник = СотрудникДляИстории(ДокументОбъект, Решение);
	Менеджер.Решение = Решение;
	Менеджер.ДатаВремя = ТекущаяДатаСеанса();
	Менеджер.Комментарий = Комментарий;
	Менеджер.Записать();

КонецПроцедуры

Функция СотрудникДляИстории(ДокументОбъект, Решение)

	Если Решение = Перечисления.РешенияСогласования.ОтправленНаСогласование Тогда
		Если ЗначениеЗаполнено(ДокументОбъект.Автор) Тогда
			Возврат ДокументОбъект.Автор;
		КонецЕсли;
		СотрудникСеанса = ТекущийСотрудник();
		Если ЗначениеЗаполнено(СотрудникСеанса) Тогда
			Возврат СотрудникСеанса;
		КонецЕсли;
		Возврат ДокументОбъект.Ответственный;
	КонецЕсли;

	СотрудникСеанса = ТекущийСотрудник();
	Если ЗначениеЗаполнено(СотрудникСеанса) Тогда
		Возврат СотрудникСеанса;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДокументОбъект.ТекущийСогласующий) Тогда
		Возврат ДокументОбъект.ТекущийСогласующий;
	КонецЕсли;
	Возврат ДокументОбъект.Автор;

КонецФункции
