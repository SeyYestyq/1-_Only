Функция НайтиДокументПоКлючуДемо(КлючДемо)

	// Содержание — строка неограниченной длины; прямое = в запросе запрещено.
	// Идентификатор — реквизит ТЧ ЗначенияПолей, не шапки документа.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДокументСЭД.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ДокументСЭД КАК ДокументСЭД
	|ГДЕ
	|	ВЫРАЗИТЬ(ДокументСЭД.Содержание КАК СТРОКА(100)) = &КлючДемо";
	Запрос.УстановитьПараметр("КлючДемо", КлючДемо);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Документы.ДокументСЭД.ПустаяСсылка();

КонецФункции
