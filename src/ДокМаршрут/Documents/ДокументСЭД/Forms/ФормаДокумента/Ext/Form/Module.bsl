&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если ЗначениеЗаполнено(Параметры.ВидДляПредпросмотра) Тогда
		РежимПредпросмотра = Истина;
		Объект.ВидДокумента = Параметры.ВидДляПредпросмотра;
		Объект.Категория = Объект.ВидДокумента.Категория;
		ДинамическиеФормы.ЗаполнитьЗначенияПолейИзВида(Объект, Объект.ВидДокумента.ПолучитьОбъект());
	ИначеЕсли Не ЗначениеЗаполнено(Объект.Категория) И ЗначениеЗаполнено(Объект.ВидДокумента) Тогда
		Объект.Категория = Объект.ВидДокумента.Категория;
	КонецЕсли;

	Если Объект.Статус.Пустая() Тогда
		Объект.Статус = Перечисления.СтатусыДокументов.Черновик;
	КонецЕсли;

	НастроитьОформлениеТаймлайна();
	ОбновитьИсториюНаСервере();
	ОбновитьТаймлайнНаСервере();
	ОбновитьОформлениеСтатуса();
	ОбновитьПодписьПолучателейПисем();
	ПодготовитьРедакторыНаСервере();
	ОбновитьДоступностьКоманд();

	Если РежимПредпросмотра Тогда
		ТолькоПросмотр = Истина;
		Заголовок = "Предпросмотр — " + Строка(Объект.ВидДокумента);
		ПодсказкаШага = "Предпросмотр формы вида. Документ не записывается.";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ОбновитьИсториюНаСервере();
	ОбновитьТаймлайнНаСервере();
	ОбновитьОформлениеСтатуса();
	ОбновитьПодписьПолучателейПисем();
	ПодготовитьРедакторыНаСервере();
	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ОбновитьИсториюНаСервере();
	ОбновитьТаймлайнНаСервере();
	ОбновитьОформлениеСтатуса();
	ОбновитьПодписьПолучателейПисем();
	ПодготовитьРедакторыНаСервере();
	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия <> "ДокМаршрут_ВидДокументаЗаписан" Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметр) И Параметр <> Объект.ВидДокумента Тогда
		Возврат;
	КонецЕсли;
	СинхронизироватьПоляВидаНаСервере();

КонецПроцедуры

&НаСервере
Процедура СинхронизироватьПоляВидаНаСервере()

	Если РежимПредпросмотра Тогда
		Возврат;
	КонецЕсли;
	ДинамическиеФормы.СинхронизироватьРедакторыСВидом(ЭтотОбъект);
	Элементы.ЗначенияПолей.Видимость = Ложь;
	ОбновитьОформлениеСтатуса();

КонецПроцедуры

&НаКлиенте
Процедура УчастникПриИзменении(Элемент)

	Если Элемент.Имя = "Ответственный" Тогда
		ПодставитьРуководителяПоОтветственному();
	КонецЕсли;
	ОбновитьПодписьПолучателейПисем();

КонецПроцедуры

&НаСервере
Процедура ПодставитьРуководителяПоОтветственному()

	Если Не ЗначениеЗаполнено(Объект.Ответственный) Тогда
		Возврат;
	КонецЕсли;
	Объект.Руководитель = Объект.Ответственный.Руководитель;

КонецПроцедуры

&НаСервере
Процедура ОбновитьПодписьПолучателейПисем()

	ПодписьПолучателейПисем = Уведомления.ТекстКомуУходятПисьма(Объект);

КонецПроцедуры

&НаСервере
Процедура ОбновитьОформлениеСтатуса()

	// Цвета только из элементов стиля (брендбук / палитра 8.5), без RGB в коде.
	Если Объект.Статус = Перечисления.СтатусыДокументов.НаСогласовании Тогда
		БейджСтатуса = "● На согласовании";
		Элементы.БейджСтатуса.ЦветТекста = ЦветаСтиля.СтатусНаСогласованииЦвет;
		Элементы.БейджСтатуса.ЦветФона = ЦветаСтиля.СтатусНаСогласованииФон;
	ИначеЕсли Объект.Статус = Перечисления.СтатусыДокументов.Согласован Тогда
		БейджСтатуса = "✓ Согласован";
		Элементы.БейджСтатуса.ЦветТекста = ЦветаСтиля.СтатусСогласованЦвет;
		Элементы.БейджСтатуса.ЦветФона = ЦветаСтиля.СтатусСогласованФон;
	ИначеЕсли Объект.Статус = Перечисления.СтатусыДокументов.Отклонен Тогда
		БейджСтатуса = "✕ Отклонён";
		Элементы.БейджСтатуса.ЦветТекста = ЦветаСтиля.СтатусОтклоненЦвет;
		Элементы.БейджСтатуса.ЦветФона = ЦветаСтиля.СтатусОтклоненФон;
	ИначеЕсли Объект.Статус = Перечисления.СтатусыДокументов.НаДоработке Тогда
		БейджСтатуса = "↺ На доработке";
		Элементы.БейджСтатуса.ЦветТекста = ЦветаСтиля.СтатусНаДоработкеЦвет;
		Элементы.БейджСтатуса.ЦветФона = ЦветаСтиля.СтатусНаДоработкеФон;
	Иначе
		БейджСтатуса = "○ Черновик";
		Элементы.БейджСтатуса.ЦветТекста = ЦветаСтиля.СтатусЧерновикЦвет;
		Элементы.БейджСтатуса.ЦветФона = ЦветаСтиля.СтатусЧерновикФон;
	КонецЕсли;

	НаСогласовании = Объект.Статус = Перечисления.СтатусыДокументов.НаСогласовании;
	Отклонён = Объект.Статус = Перечисления.СтатусыДокументов.Отклонен;
	ЕстьМаршрут = Таймлайн.Количество() > 0 Или Объект.МаршрутСнимок.Количество() > 0;

	Если ЗначениеЗаполнено(Объект.ТекущийСогласующий) Тогда
		ПодписьСогласующего = Строка(Объект.ТекущийСогласующий);
	Иначе
		ПодписьСогласующего = "—";
	КонецЕсли;
	Элементы.ПодписьСогласующего.Видимость = НаСогласовании;

	ЗаголовокВида = ?(ЗначениеЗаполнено(Объект.ВидДокумента), Строка(Объект.ВидДокумента), "Документ");
	НомерТекст = ?(ЗначениеЗаполнено(Объект.Номер), Объект.Номер, "новый");
	Заголовок = ЗаголовокВида + " № " + НомерТекст;

	Если Объект.ВсегоЭтапов > 0 И Объект.ТекущийЭтап > 0 Тогда
		Элементы.ГруппаМаршрут.Заголовок = СтрШаблон(
			"Маршрут · этап %1 из %2",
			Объект.ТекущийЭтап,
			Объект.ВсегоЭтапов);
	ИначеЕсли Объект.Статус = Перечисления.СтатусыДокументов.Согласован Тогда
		Элементы.ГруппаМаршрут.Заголовок = "Маршрут · согласован";
	ИначеЕсли Отклонён Тогда
		Элементы.ГруппаМаршрут.Заголовок = "Маршрут · отклонён";
	Иначе
		Элементы.ГруппаМаршрут.Заголовок = "Маршрут согласования";
	КонецЕсли;

	// Свёртка задаётся в Form.xml (Collapsed); в 8.5.1 у группы нет свойства «Свернута» в рантайме.
	Элементы.ГруппаМаршрут.Видимость = ЕстьМаршрут
		Или Объект.Статус = Перечисления.СтатусыДокументов.НаСогласовании
		Или Объект.Статус = Перечисления.СтатусыДокументов.Согласован
		Или Отклонён;
	Элементы.ГруппаИстория.Видимость = Отклонён Или История.Количество() > 0;

	Если Не ЗначениеЗаполнено(Объект.Категория) Тогда
		ПодсказкаШага = "Сначала выберите категорию, затем готовый вид документа.";
	ИначеЕсли Не ЗначениеЗаполнено(Объект.ВидДокумента) Тогда
		ПодсказкаШага = "В поле «Вид документа» выберите готовый вид этой категории.";
	ИначеЕсли Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПодсказкаШага = "Заполните «Поля документа» и «Суть», затем нажмите «Записать».";
	ИначеЕсли Объект.Статус = Перечисления.СтатусыДокументов.Черновик
		Или Объект.Статус = Перечисления.СтатусыДокументов.НаДоработке Тогда
		ПодсказкаШага = "Номер присвоен. Нажмите «Отправить на согласование».";
	ИначеЕсли НаСогласовании Тогда
		ПодсказкаШага = "Документ на согласовании. Решение принимает текущий согласующий.";
	ИначеЕсли Объект.Статус = Перечисления.СтатусыДокументов.Согласован Тогда
		ПодсказкаШага = "Документ согласован. «Предпросмотр»: открыть форму. «Отправить на почту»: письмо с вложением.";
	ИначеЕсли Отклонён Тогда
		ПодсказкаШага = "Документ отклонён. Комментарий смотрите в блоке «История согласования».";
	Иначе
		ПодсказкаШага = "";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьДоступностьКоманд()

	ЧерновикИлиДоработка = Объект.Статус = Перечисления.СтатусыДокументов.Черновик
		Или Объект.Статус = Перечисления.СтатусыДокументов.НаДоработке;
	НаСогласовании = Объект.Статус = Перечисления.СтатусыДокументов.НаСогласовании;
	Отклонён = Объект.Статус = Перечисления.СтатусыДокументов.Отклонен;
	ДокументЗаписан = ЗначениеЗаполнено(Объект.Ссылка);

	ЯСогласующий = Ложь;
	Если НаСогласовании Тогда
		ЯСогласующий = Согласование.ЭтоАктивныйСогласующий(Объект);
	КонецЕсли;

	Элементы.КнопкаОтправить.Видимость = ЧерновикИлиДоработка;
	Элементы.КнопкаСогласовать.Видимость = НаСогласовании И ЯСогласующий;
	Элементы.КнопкаОтклонить.Видимость = НаСогласовании И ЯСогласующий;
	// HIG/M3: не больше 1–2 prominent; «Вернуть» только после отклонения.
	Элементы.КнопкаДоработка.Видимость = Отклонён;
	Элементы.КнопкаПечать.Видимость = ДокументЗаписан;
	Элементы.КнопкаОтправитьФорму.Видимость = ДокументЗаписан;

	Элементы.КнопкаОтправить.КнопкаПоУмолчанию = Ложь;
	Элементы.КнопкаСогласовать.КнопкаПоУмолчанию = Ложь;
	Элементы.КнопкаДоработка.КнопкаПоУмолчанию = Ложь;
	Элементы.КнопкаПечать.КнопкаПоУмолчанию = Ложь;
	Элементы.КнопкаОтправитьФорму.КнопкаПоУмолчанию = Ложь;

	// Пока документ не записан — главный шаг платформы «Записать», не «На согласование».
	Если ЧерновикИлиДоработка И ДокументЗаписан Тогда
		Элементы.КнопкаОтправить.КнопкаПоУмолчанию = Истина;
	ИначеЕсли НаСогласовании И ЯСогласующий Тогда
		Элементы.КнопкаСогласовать.КнопкаПоУмолчанию = Истина;
	ИначеЕсли Отклонён Тогда
		Элементы.КнопкаДоработка.КнопкаПоУмолчанию = Истина;
	ИначеЕсли Элементы.КнопкаПечать.Видимость Тогда
		Элементы.КнопкаПечать.КнопкаПоУмолчанию = Истина;
	КонецЕсли;

	// Содержимое только в черновике / на доработке; согласование идёт кнопками.
	ТолькоПросмотрСодержания = Не ЧерновикИлиДоработка;
	Элементы.Категория.ТолькоПросмотр = ТолькоПросмотрСодержания;
	Элементы.ВидДокумента.ТолькоПросмотр = ТолькоПросмотрСодержания;
	Элементы.ПоляВида.Доступность = Не ТолькоПросмотрСодержания;
	Элементы.Номер.ТолькоПросмотр = ТолькоПросмотрСодержания;
	Элементы.Дата.ТолькоПросмотр = ТолькоПросмотрСодержания;
	Элементы.Автор.ТолькоПросмотр = ТолькоПросмотрСодержания;
	Элементы.Ответственный.ТолькоПросмотр = ТолькоПросмотрСодержания;
	Элементы.Руководитель.ТолькоПросмотр = ТолькоПросмотрСодержания;
	Элементы.Содержание.ТолькоПросмотр = ТолькоПросмотрСодержания;
	Элементы.ЗначенияПолей.Видимость = Ложь;

	Если РежимПредпросмотра Тогда
		Элементы.КнопкаОтправить.Видимость = Ложь;
		Элементы.КнопкаСогласовать.Видимость = Ложь;
		Элементы.КнопкаОтклонить.Видимость = Ложь;
		Элементы.КнопкаДоработка.Видимость = Ложь;
		Элементы.КнопкаПечать.Видимость = Ложь;
		Элементы.КнопкаОтправитьФорму.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СообщитьРезультат(Текст, ЭтоОшибка = Ложь)

	Если ЭтоОшибка Тогда
		ПоказатьПредупреждение(, Текст);
	Иначе
		ПоказатьОповещениеПользователя("ДокМаршрут", , Текст);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИнструкцию(Команда)

	// Текст по Google/Microsoft procedures: Где → действие; результат отдельной строкой.
	// «ёлочки» для имён UI. Без ПоказатьПредупреждение — у неё иконка ошибки.
	Текст =
	"Создать документ и отправить на согласование
	|
	|1. Выберите категорию, затем готовый вид документа:
	|Служебная записка
	|Договор поставки
	|Исходящее письмо
	|В списке только готовые виды выбранной категории.
	|
	|2. В блоке «Поля документа» заполните поля.
	|Число и дата вводятся своими полями, для «Выбор из списка» откройте список поля.
	|
	|3. В поле «Суть» кратко опишите документ.
	|
	|4. В блоке «Кто участвует» в поле «Ответственный» выберите сотрудника.
	|Письма при смене статуса идут ответственному и руководителю (Email из карточки сотрудника).
	|
	|5. Нажмите «Записать».
	|В заголовке формы появится номер, например СЗ-00000001.
	|
	|6. Нажмите «Отправить на согласование».
	|Откроется блок «Маршрут согласования».
	|
	|После согласования:
	|«Предпросмотр»: открыть печатную форму.
	|«Отправить на почту»: письмо с вложением ответственному и руководителю.
	|
	|В блоке «Маршрут согласования» цвета строк показывают прогресс:
	|пройденные, текущий, ожидающие и отклонённый этапы.
	|
	|Согласовать или отклонить может только текущий согласующий.
	|В списке документов кнопка «Мои задачи» показывает документы, которые ждут вашего решения.";
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияСправки", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ОК, , , "Справка");

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияСправки(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Возврат;
КонецПроцедуры

&НаКлиенте
Процедура ВидДокументаПриИзменении(Элемент)

	Если ЗначениеЗаполнено(ПредыдущийВид) И Объект.ВидДокумента <> ПредыдущийВид Тогда
		ПоказатьВопрос(
			Новый ОписаниеОповещения("ПослеСменыВида", ЭтотОбъект),
			"Смена вида очистит введённые поля. Продолжить?",
			РежимДиалогаВопрос.ДаНет);
	Иначе
		ПрименитьВидНаСервере();
		ОбновитьОформлениеСтатуса();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КатегорияПриИзменении(Элемент)

	Если Объект.Категория = ПредыдущаяКатегория Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ПредыдущийВид) Тогда
		ПоказатьВопрос(
			Новый ОписаниеОповещения("ПослеСменыКатегории", ЭтотОбъект),
			"Смена категории очистит вид и введённые поля. Продолжить?",
			РежимДиалогаВопрос.ДаНет);
	Иначе
		ПрименитьКатегориюНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеСменыКатегории(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ПрименитьКатегориюНаСервере();
	Иначе
		Объект.Категория = ПредыдущаяКатегория;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеСменыВида(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ПрименитьВидНаСервере();
		ОбновитьОформлениеСтатуса();
	Иначе
		Объект.ВидДокумента = ПредыдущийВид;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПолеВидаПриИзменении(Элемент)

	Для Каждого Карта Из ПоляФормы Цикл
		Если Карта.Имя = Элемент.Имя Тогда
			Карта.Изменено = Истина;
			Элемент.ОтметкаНезаполненного = Ложь;
			Модифицированность = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПрименитьКатегориюНаСервере()

	Если Объект.Категория = ПредыдущаяКатегория Тогда
		НастроитьВыборВидаПоКатегории();
		Возврат;
	КонецЕсли;
	Если Объект.Статус <> Перечисления.СтатусыДокументов.Черновик
		И Объект.Статус <> Перечисления.СтатусыДокументов.НаДоработке Тогда
		Объект.Категория = ПредыдущаяКатегория;
		Возврат;
	КонецЕсли;
	Объект.ВидДокумента = Справочники.ВидыДокументов.ПустаяСсылка();
	Объект.ЗначенияПолей.Очистить();
	ПодготовитьРедакторыНаСервере();
	ОбновитьОформлениеСтатуса();

КонецПроцедуры

&НаСервере
Процедура ПрименитьВидНаСервере()

	Если Объект.ВидДокумента = ПредыдущийВид Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ВидДокумента)
		И ЗначениеЗаполнено(Объект.Категория)
		И Объект.ВидДокумента.Категория <> Объект.Категория Тогда
		Объект.ВидДокумента = ПредыдущийВид;
		СообщитьПользователю("Выберите вид выбранной категории.", "Объект.ВидДокумента");
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ВидДокумента)
		И (Объект.ВидДокумента.ПометкаУдаления
			Или Объект.ВидДокумента.СтатусНастройки <> Перечисления.СтатусыНастройкиВида.Готов) Тогда
		Объект.ВидДокумента = ПредыдущийВид;
		СообщитьПользователю("Выберите готовый вид документа.", "Объект.ВидДокумента");
		Возврат;
	КонецЕсли;
	Объект.ЗначенияПолей.Очистить();
	Если ЗначениеЗаполнено(Объект.ВидДокумента) Тогда
		ДинамическиеФормы.ЗаполнитьЗначенияПолейИзВида(Объект, Объект.ВидДокумента.ПолучитьОбъект());
	КонецЕсли;
	ПодготовитьРедакторыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьНаСогласование(Команда)

	Если Модифицированность Или Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Подготовка = ПодготовитьКОтправкеНаСервере();
	Если Не ПустаяСтрока(Подготовка.ТекстПроверки) Тогда
		СообщитьРезультат(Подготовка.ТекстПроверки, Истина);
		Возврат;
	КонецЕсли;
	Если Подготовка.Добавлено > 0 Или Модифицированность Тогда
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Результат = ОтправитьНаСогласованиеНаСервере(Объект.Ссылка);
	СообщитьРезультат(Результат.Текст, Не Результат.Успех);
	Если Результат.Успех Тогда
		Прочитать();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Согласовать(Команда)
	ПринятьРешениеКлиент(ПредопределенноеЗначение("Перечисление.РешенияСогласования.Согласовано"), "");
КонецПроцедуры

&НаКлиенте
Процедура Отклонить(Команда)

	Решение = ПредопределенноеЗначение("Перечисление.РешенияСогласования.Отклонено");
	ПоказатьВводСтроки(
		Новый ОписаниеОповещения("ПослеВводаКомментарияРешения", ЭтотОбъект, Решение),
		"",
		"Комментарий к отклонению: что нужно исправить в документе",
		250,
		Истина);

КонецПроцедуры

&НаКлиенте
Процедура ВернутьНаДоработку(Команда)

	Решение = ПредопределенноеЗначение("Перечисление.РешенияСогласования.ВозвращенНаДоработку");
	ПоказатьВводСтроки(
		Новый ОписаниеОповещения("ПослеВводаКомментарияРешения", ЭтотОбъект, Решение),
		"",
		"Комментарий к возврату на доработку (можно кратко)",
		250,
		Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаКомментарияРешения(ВведенныйКомментарий, Решение) Экспорт

	Если ВведенныйКомментарий = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Комментарий = СокрЛП(ВведенныйКомментарий);
	Если ПустаяСтрока(Комментарий) Тогда
		Если Решение = ПредопределенноеЗначение("Перечисление.РешенияСогласования.Отклонено") Тогда
			СообщитьРезультат(
				"В поле комментария напишите, что нужно исправить. Пустой комментарий нельзя.",
				Истина);
			Возврат;
		КонецЕсли;
		Комментарий = "Возврат на доработку";
	КонецЕсли;
	ПринятьРешениеКлиент(Решение, Комментарий);

КонецПроцедуры

&НаКлиенте
Процедура ПечатьPDF(Команда)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		СообщитьРезультат("Сначала нажмите «Записать».", Истина);
		Возврат;
	КонецЕсли;

	Результат = ПечатьНаСервере(Объект.Ссылка);
	Если Не Результат.Успех Тогда
		СообщитьРезультат(Результат.Текст, Истина);
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(Результат.АдресХранилища) Тогда
		СообщитьРезультат(Результат.Текст, Ложь);
		Возврат;
	КонецЕсли;

	// Предпросмотр: PDF (коммерческая) или HTML (учебная лицензия).
	ИмяЛокального = КаталогВременныхФайлов() + Результат.ИмяФайлаКлиент;
	Попытка
		ПолучитьФайл(Результат.АдресХранилища, ИмяЛокального, Ложь);
		ЗапуститьПриложение(ИмяЛокального);
		СообщитьРезультат("Печатная форма открыта.", Ложь);
	Исключение
		СообщитьРезультат(
			"Файл готов, но не открылся. Сохраните его вручную из папки временных файлов.",
			Истина);
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьПечатнуюФорму(Команда)

	Если Модифицированность Или Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		СообщитьРезультат("Сначала нажмите «Записать».", Истина);
		Возврат;
	КонецЕсли;

	Подготовка = ПодготовитьКОтправкеНаСервере();
	Если Не ПустаяСтрока(Подготовка.ТекстПроверки) Тогда
		СообщитьРезультат(Подготовка.ТекстПроверки, Истина);
		Возврат;
	КонецЕсли;
	Если Подготовка.Добавлено > 0 Или Модифицированность Тогда
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ОбновитьПодписьПолучателейПисем();
	КонтекстОтправки = Новый Структура("Ссылка,Получатели", Объект.Ссылка, ПодписьПолучателейПисем);
	Если ПустаяСтрока(ПодписьПолучателейПисем) Тогда
		ПослеПодтвержденияОтправкиФормы(КодВозвратаДиалога.Да, КонтекстОтправки);
		Возврат;
	КонецЕсли;
	ПоказатьВопрос(
		Новый ОписаниеОповещения("ПослеПодтвержденияОтправкиФормы", ЭтотОбъект, КонтекстОтправки),
		ПодписьПолучателейПисем + Символы.ПС + Символы.ПС + "Отправить на почту этим получателям?",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияОтправкиФормы(РезультатВопроса, КонтекстОтправки) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Результат = ОтправитьПечатнуюФормуНаСервере(КонтекстОтправки.Ссылка, КонтекстОтправки.Получатели);
	СообщитьРезультат(Результат.Текст, Не Результат.Успех);

КонецПроцедуры

&НаКлиенте
Процедура ПринятьРешениеКлиент(Решение, Комментарий)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		СообщитьРезультат("Сначала нажмите «Записать».", Истина);
		Возврат;
	КонецЕсли;

	Результат = ПринятьРешениеНаСервере(Объект.Ссылка, Решение, Комментарий);
	СообщитьРезультат(Результат.Текст, Не Результат.Успех);
	Если Результат.Успех Тогда
		Прочитать();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьИсториюНаСервере()

	История.Очистить();
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Таблица = Согласование.ИсторияДляКарточки(Объект.Ссылка);
	Для Каждого СтрокаИстории Из Таблица Цикл
		НоваяСтрока = История.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИстории);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОбновитьТаймлайнНаСервере()

	Таймлайн.Очистить();
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если Объект.МаршрутСнимок.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		Для Каждого СтрокаМаршрута Из Объект.МаршрутСнимок Цикл
			НоваяСтрока = Таймлайн.Добавить();
			НоваяСтрока.Номер = СтрокаМаршрута.НомерЭтапа;
			НоваяСтрока.Название = СтрокаМаршрута.НазваниеЭтапа;
			НоваяСтрока.Согласующий = Строка(СтрокаМаршрута.Согласующий);
			НоваяСтрока.Состояние = "Ожидает";
		КонецЦикла;
		Возврат;
	КонецЕсли;

	Таблица = Согласование.ЭтапыДляТаймлайна(Объект.Ссылка);
	Для Каждого СтрокаЭтапа Из Таблица Цикл
		НоваяСтрока = Таймлайн.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЭтапа);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура НастроитьОформлениеТаймлайна()

	ДобавитьОформлениеСостоянияТаймлайна(
		"Пройден",
		ЦветаСтиля.СтатусСогласованЦвет,
		ЦветаСтиля.СтатусСогласованФон);
	ДобавитьОформлениеСостоянияТаймлайна(
		"Текущий",
		ЦветаСтиля.СтатусНаСогласованииЦвет,
		ЦветаСтиля.СтатусНаСогласованииФон);
	ДобавитьОформлениеСостоянияТаймлайна(
		"Ожидает",
		ЦветаСтиля.СтатусЧерновикЦвет,
		ЦветаСтиля.СтатусЧерновикФон);
	ДобавитьОформлениеСостоянияТаймлайна(
		"Отклонён",
		ЦветаСтиля.СтатусОтклоненЦвет,
		ЦветаСтиля.СтатусОтклоненФон);

КонецПроцедуры

&НаСервере
Процедура ДобавитьОформлениеСостоянияТаймлайна(Состояние, ЦветТекста, ЦветФона)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();

	Для Каждого ИмяКолонки Из СтрРазделить("Номер,Название,Согласующий,Состояние", ",", Ложь) Цикл
		Поле = ЭлементОформления.Поля.Элементы.Добавить();
		Поле.Поле = Новый ПолеКомпоновкиДанных("Таймлайн." + ИмяКолонки);
		Поле.Использование = Истина;
	КонецЦикла;

	Отбор = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Таймлайн.Состояние");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Состояние;
	Отбор.Использование = Истина;

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветТекста);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
	ЭлементОформления.Использование = Истина;

КонецПроцедуры

&НаСервере
Функция ПодготовитьКОтправкеНаСервере()

	Результат = Новый Структура("ТекстПроверки, Добавлено", "", 0);
	ДинамическиеФормы.ПеренестиРедакторыВДокумент(ЭтотОбъект);
	Результат.Добавлено = ДинамическиеФормы.ДобавитьНедостающиеПоляИзВида(Объект);
	Если Результат.Добавлено > 0 Тогда
		ДинамическиеФормы.ПостроитьРедакторыПолей(ЭтотОбъект);
		Элементы.ЗначенияПолей.Видимость = Ложь;
	КонецЕсли;
	Результат.ТекстПроверки = ДинамическиеФормы.ТекстПроверкиОбязательных(Объект);
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ОтправитьНаСогласованиеНаСервере(Ссылка)

	Возврат Согласование.ОтправитьНаСогласование(Ссылка);

КонецФункции

&НаСервереБезКонтекста
Функция ПринятьРешениеНаСервере(Ссылка, Решение, Комментарий)

	Возврат Согласование.ПринятьРешение(Ссылка, Решение, Комментарий);

КонецФункции

&НаСервереБезКонтекста
Функция ПечатьНаСервере(Ссылка)

	Результат = Новый Структура("Успех, Текст, АдресХранилища, ИмяФайлаКлиент", Ложь, "", "", "");
	Вложение = ПечатьДокументов.СформироватьВложениеПечатнойФормы(Ссылка);
	Результат.Успех = Вложение.Успех;
	Результат.Текст = Вложение.Текст;
	Если Не Вложение.Успех Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		ДанныеФайла = Новый ДвоичныеДанные(Вложение.ИмяФайла);
		Результат.АдресХранилища = ПоместитьВоВременноеХранилище(ДанныеФайла, Новый УникальныйИдентификатор);
		Результат.ИмяФайлаКлиент = Вложение.ИмяФайлаКлиент;
	Исключение
		Результат.Успех = Ложь;
		Результат.Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Если Не ПустаяСтрока(Вложение.ИмяФайла) Тогда
		Попытка
			УдалитьФайлы(Вложение.ИмяФайла);
		Исключение
		КонецПопытки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ОтправитьПечатнуюФормуНаСервере(Ссылка, ОжидаемыеПолучатели)

	ДокументОбъект = Ссылка.ПолучитьОбъект();
	Если Уведомления.ТекстКомуУходятПисьма(ДокументОбъект) <> ОжидаемыеПолучатели Тогда
		Возврат Новый Структура(
			"Успех,Текст",
			Ложь,
			"Получатели изменились. Проверьте адресатов и подтвердите отправку заново.");
	КонецЕсли;
	Возврат Уведомления.ОтправитьПечатнуюФормуДокумента(Ссылка);

КонецФункции

&НаСервере
Процедура ПодготовитьРедакторыНаСервере()

	Если Не ЗначениеЗаполнено(Объект.Категория) И ЗначениеЗаполнено(Объект.ВидДокумента) Тогда
		Объект.Категория = Объект.ВидДокумента.Категория;
	КонецЕсли;
	ДинамическиеФормы.ПостроитьРедакторыПолей(ЭтотОбъект);
	Элементы.ЗначенияПолей.Видимость = Ложь;
	ПредыдущийВид = Объект.ВидДокумента;
	ПредыдущаяКатегория = Объект.Категория;
	НастроитьВыборВидаПоКатегории();

КонецПроцедуры

&НаСервере
Процедура НастроитьВыборВидаПоКатегории()

	ПараметрыОтбора = Новый Массив;
	ПараметрыОтбора.Добавить(Новый ПараметрВыбора(
		"Отбор.СтатусНастройки",
		Перечисления.СтатусыНастройкиВида.Готов));
	ПараметрыОтбора.Добавить(Новый ПараметрВыбора("Отбор.ПометкаУдаления", Ложь));
	Если ЗначениеЗаполнено(Объект.Категория) Тогда
		ПараметрыОтбора.Добавить(Новый ПараметрВыбора("Отбор.Категория", Объект.Категория));
	КонецЕсли;
	Элементы.ВидДокумента.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыОтбора);

	СписокВыбора = Элементы.ВидДокумента.СписокВыбора;
	СписокВыбора.Очистить();
	Если ЗначениеЗаполнено(Объект.Категория) Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Категория", Объект.Категория);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Ссылка,
		|	Наименование
		|ИЗ
		|	Справочник.ВидыДокументов
		|ГДЕ
		|	НЕ ПометкаУдаления
		|	И СтатусНастройки = ЗНАЧЕНИЕ(Перечисление.СтатусыНастройкиВида.Готов)
		|	И Категория = &Категория
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СписокВыбора.Добавить(Выборка.Ссылка, Выборка.Наименование);
		КонецЦикла;
	КонецЕсли;

	Элементы.ВидДокумента.РежимВыбораИзСписка = Истина;
	Элементы.ВидДокумента.КнопкаВыпадающегоСписка = Истина;
	Элементы.ВидДокумента.РедактированиеТекста = Ложь;
	Элементы.ВидДокумента.Доступность = ЗначениеЗаполнено(Объект.Категория) И Не РежимПредпросмотра;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)

	Если РежимПредпросмотра Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Отказ = Не ПодготовитьЗаписьНаСервере();

КонецПроцедуры

&НаСервере
Функция ПодготовитьЗаписьНаСервере()

	ДинамическиеФормы.ПеренестиРедакторыВДокумент(ЭтотОбъект);
	ТекстФормата = ДинамическиеФормы.ТекстПроверкиФорматаПолей(Объект);
	Если Не ПустаяСтрока(ТекстФормата) Тогда
		СообщитьПользователю(ТекстФормата, "Объект.ЗначенияПолей");
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ВидДокумента) И ЗначениеЗаполнено(Объект.Категория)
		И Объект.ВидДокумента.Категория <> Объект.Категория Тогда
		СообщитьПользователю("Выберите вид выбранной категории.", "Объект.ВидДокумента");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если РежимПредпросмотра Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если Не ПодготовитьЗаписьНаСервере() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ТекущийОбъект.Категория = Объект.Категория;
	ТекущийОбъект.ВидДокумента = Объект.ВидДокумента;
	ТекущийОбъект.ЗначенияПолей.Очистить();
	Для Каждого СтрокаЗначения Из Объект.ЗначенияПолей Цикл
		СтрокаОбъекта = ТекущийОбъект.ЗначенияПолей.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаОбъекта, СтрокаЗначения);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СообщитьПользователю(Текст, Поле)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.Сообщить();

КонецПроцедуры
