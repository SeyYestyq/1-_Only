&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Заголовок = "Документы";
	ТолькоМоиСогласования = Параметры.ПоказатьМоиСогласования = Истина;
	ТолькоМоиДокументы = Параметры.ПоказатьМоиДокументы = Истина;
	НастроитьОформлениеСтатусов();
	НастроитьПараметрыВыбораВида();
	ПрименитьОтборы();
	Элементы.КнопкаМои.Заголовок = ?(ТолькоМоиСогласования, "Мои задачи · вкл", "Мои задачи");
	СкрытьСтандартнуюКнопкуСоздать();

КонецПроцедуры

&НаСервере
Процедура СкрытьСтандартнуюКнопкуСоздать()

	Для Каждого Имя Из СтрРазделить("ФормаСоздать,Создать,СписокСоздать", ",") Цикл
		Кнопка = Элементы.Найти(Имя);
		Если Кнопка <> Неопределено Тогда
			Кнопка.Видимость = Ложь;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокумент(Команда)

	ОткрытьФорму("Документ.ДокументСЭД.Форма.ФормаДокумента");

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИнструкцию(Команда)

	Текст =
	"Создать документ
	|
	|1. В шапке списка нажмите «Создать».
	|2. В шапке формы выберите категорию, затем готовый вид документа.
	|3. Заполните блок «Поля документа» и поле «Суть».
	|4. В блоке «Кто участвует» укажите ответственного.
	|5. В шапке формы нажмите «Записать».
	|В шапке формы появится номер (СЗ-…, Д-…, ИСХ-…).
	|6. В шапке формы нажмите «Отправить на согласование».
	|
	|В шапке списка поля «Категория», «Вид документа», «Ответственный» и «Статус»
	|фильтруют список. Можно задать несколько отборов сразу.
	|Кнопка «Сбросить» очищает все отборы.
	|
	|Кнопка «Мои задачи» показывает документы на согласовании, которые ждут вашего решения.
	|Подробные шаги: «Справка» (i) в карточке документа.";
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияСправки", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ОК, , , "Справка");

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияСправки(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Возврат;
КонецПроцедуры

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	ПрименитьОтборыНаСервере(Элемент.Имя);
	Элементы.Список.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура СброситьОтборы(Команда)

	ОтборКатегория = Неопределено;
	ОтборВидДокумента = Неопределено;
	ОтборОтветственный = Неопределено;
	ОтборСтатус = Неопределено;
	ТолькоМоиСогласования = Ложь;
	ТолькоМоиДокументы = Ложь;
	Элементы.КнопкаМои.Заголовок = "Мои задачи";
	ПрименитьОтборыНаСервере("");
	Элементы.Список.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьТолькоМоиСогласования(Команда)

	ТолькоМоиСогласования = Не ТолькоМоиСогласования;
	Если ТолькоМоиСогласования И Не СеансПривязанКСотруднику() Тогда
		ТолькоМоиСогласования = Ложь;
		Элементы.КнопкаМои.Заголовок = "Мои задачи";
		ПоказатьПредупреждение(,
			"Сеанс не сопоставлен с карточкой сотрудника. Укажите «Имя пользователя ИБ» у сотрудника "
			+ "или войдите под сопоставленным пользователем.");
		Возврат;
	КонецЕсли;

	ПрименитьОтборыНаСервере("");
	Элементы.Список.Обновить();
	Если ТолькоМоиСогласования Тогда
		Элементы.КнопкаМои.Заголовок = "Мои задачи · вкл";
	Иначе
		Элементы.КнопкаМои.Заголовок = "Мои задачи";
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СеансПривязанКСотруднику()

	Возврат ЗначениеЗаполнено(Согласование.ТекущийСотрудник());

КонецФункции

&НаСервере
Процедура ПрименитьОтборыНаСервере(ИмяЭлемента)

	Если ИмяЭлемента = "ОтборКатегория" Тогда
		СброситьВидЕслиНеПодходитККатегории();
	КонецЕсли;
	НастроитьПараметрыВыбораВида();
	ПрименитьОтборы();

КонецПроцедуры

&НаСервере
Процедура НастроитьПараметрыВыбораВида()

	// Категория сужает выбор вида — не весь справочник подряд.
	// Имя «Параметры» на форме занято — нельзя присваивать.
	МассивПараметров = Новый Массив;
	Если ЗначениеЗаполнено(ОтборКатегория) Тогда
		МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Категория", ОтборКатегория));
	КонецЕсли;
	Элементы.ОтборВидДокумента.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);

КонецПроцедуры

&НаСервере
Процедура СброситьВидЕслиНеПодходитККатегории()

	Если Не ЗначениеЗаполнено(ОтборВидДокумента) Или Не ЗначениеЗаполнено(ОтборКатегория) Тогда
		Возврат;
	КонецЕсли;
	Если ОтборВидДокумента.Категория <> ОтборКатегория Тогда
		ОтборВидДокумента = Неопределено;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПрименитьОтборы()

	Отбор = Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор;
	Отбор.Элементы.Очистить();

	Если ТолькоМоиДокументы Тогда
		ТекущийСотрудник = ДинамическиеФормы.ПривязкаПользователяДляИнтерфейса().Сотрудник;
		Если Не ЗначениеЗаполнено(ТекущийСотрудник) Тогда
			ДобавитьОтборРавно(Отбор, "Ссылка", Документы.ДокументСЭД.ПустаяСсылка());
		Иначе
			ГруппаМоих = Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			ГруппаМоих.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
			ГруппаМоих.Использование = Истина;
			ДобавитьОтборРавно(ГруппаМоих, "Автор", ТекущийСотрудник);
			ДобавитьОтборРавно(ГруппаМоих, "Ответственный", ТекущийСотрудник);
		КонецЕсли;
		Заголовок = "Мои документы";
	Иначе
		Заголовок = "Документы";
	КонецЕсли;

	ДобавитьОтборЕслиЗаполнено(Отбор, "Категория", ОтборКатегория);
	ДобавитьОтборЕслиЗаполнено(Отбор, "ВидДокумента", ОтборВидДокумента);
	ДобавитьОтборЕслиЗаполнено(Отбор, "Ответственный", ОтборОтветственный);

	Если ТолькоМоиСогласования Тогда
		Текущий = Согласование.ТекущийСотрудник();
		Если ЗначениеЗаполнено(Текущий) Тогда
			ДобавитьОтборРавно(Отбор, "Статус", Перечисления.СтатусыДокументов.НаСогласовании);
			ДобавитьОтборРавно(Отбор, "ТекущийСогласующий", Текущий);
		КонецЕсли;
	Иначе
		ДобавитьОтборЕслиЗаполнено(Отбор, "Статус", ОтборСтатус);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДобавитьОтборЕслиЗаполнено(Отбор, ИмяПоля, Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	ДобавитьОтборРавно(Отбор, ИмяПоля, Значение);

КонецПроцедуры

&НаСервере
Процедура ДобавитьОтборРавно(Отбор, ИмяПоля, Значение)

	ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Значение;
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;

КонецПроцедуры

&НаСервере
Процедура НастроитьОформлениеСтатусов()

	ДобавитьОформлениеСтатуса(
		Перечисления.СтатусыДокументов.Черновик,
		ЦветаСтиля.СтатусЧерновикЦвет,
		ЦветаСтиля.СтатусЧерновикФон);
	ДобавитьОформлениеСтатуса(
		Перечисления.СтатусыДокументов.НаСогласовании,
		ЦветаСтиля.СтатусНаСогласованииЦвет,
		ЦветаСтиля.СтатусНаСогласованииФон);
	ДобавитьОформлениеСтатуса(
		Перечисления.СтатусыДокументов.Согласован,
		ЦветаСтиля.СтатусСогласованЦвет,
		ЦветаСтиля.СтатусСогласованФон);
	ДобавитьОформлениеСтатуса(
		Перечисления.СтатусыДокументов.Отклонен,
		ЦветаСтиля.СтатусОтклоненЦвет,
		ЦветаСтиля.СтатусОтклоненФон);
	ДобавитьОформлениеСтатуса(
		Перечисления.СтатусыДокументов.НаДоработке,
		ЦветаСтиля.СтатусНаДоработкеЦвет,
		ЦветаСтиля.СтатусНаДоработкеФон);

КонецПроцедуры

&НаСервере
Процедура ДобавитьОформлениеСтатуса(Статус, ЦветТекста, ЦветФона)

	ЭлементОформления = Список.УсловноеОформление.Элементы.Добавить();
	ПолеСтатус = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеСтатус.Поле = Новый ПолеКомпоновкиДанных("Статус");
	ПолеСтатус.Использование = Истина;

	Отбор = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Статус");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Статус;
	Отбор.Использование = Истина;

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветТекста);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
	ЭлементОформления.Использование = Истина;

КонецПроцедуры
