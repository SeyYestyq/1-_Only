Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)

	Если ЗначениеЗаполнено(ВидДокумента) Тогда
		ПрефиксВида = СокрЛП(ВидДокумента.Префикс);
		Если Не ПустаяСтрока(ПрефиксВида) Тогда
			Префикс = ПрефиксВида + "-";
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ЗаписьДвижка = ЭтоЗаписьДвижка();

	Если ЭтоНовый() И Не ЗначениеЗаполнено(Автор) Тогда
		Сотрудник = Согласование.ТекущийСотрудник();
		Если ЗначениеЗаполнено(Сотрудник) Тогда
			Автор = Сотрудник;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(Ответственный) И Не ЗначениеЗаполнено(Руководитель) Тогда
		Руководитель = Ответственный.Руководитель;
	КонецЕсли;

	Если Не ЗаписьДвижка Тогда
		ТекстФормата = ДинамическиеФормы.ТекстПроверкиФорматаПолей(ЭтотОбъект);
		Если Не ПустаяСтрока(ТекстФормата) Тогда
			Отказ = Истина;
			СообщитьПроверку(ТекстФормата);
			Возврат;
		КонецЕсли;

		Если Не ЭтоНовый() Тогда
			ПроверитьЗапретПравкиСодержания(Отказ);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ЭтоЗаписьДвижка()

	Если ДополнительныеСвойства.Свойство("РазрешитьЗаписьДвижка")
		И ДополнительныеСвойства.РазрешитьЗаписьДвижка = Истина Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Процедура ПроверитьЗапретПравкиСодержания(Отказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДокументСЭД.Статус КАК Статус,
	|	ДокументСЭД.ВидДокумента КАК ВидДокумента,
	|	ДокументСЭД.Автор КАК Автор,
	|	ДокументСЭД.Ответственный КАК Ответственный,
	|	ДокументСЭД.Руководитель КАК Руководитель,
	|	ДокументСЭД.Содержание КАК Содержание
	|ИЗ
	|	Документ.ДокументСЭД КАК ДокументСЭД
	|ГДЕ
	|	ДокументСЭД.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;

	Если Выборка.Статус = Перечисления.СтатусыДокументов.Черновик
		Или Выборка.Статус = Перечисления.СтатусыДокументов.НаДоработке Тогда
		Возврат;
	КонецЕсли;

	ЗапросЗначений = Новый Запрос;
	ЗапросЗначений.Текст =
	"ВЫБРАТЬ
	|	ЗначенияПолей.Идентификатор КАК Идентификатор,
	|	ЗначенияПолей.ЗначениеСтрока КАК ЗначениеСтрока
	|ИЗ
	|	Документ.ДокументСЭД.ЗначенияПолей КАК ЗначенияПолей
	|ГДЕ
	|	ЗначенияПолей.Ссылка = &Ссылка";
	ЗапросЗначений.УстановитьПараметр("Ссылка", Ссылка);
	ТаблицаВБазе = ЗапросЗначений.Выполнить().Выгрузить();

	Если СнимокСодержания(Выборка, ТаблицаВБазе) = СнимокСодержания(ЭтотОбъект, ЗначенияПолей.Выгрузить()) Тогда
		Возврат;
	КонецЕсли;

	Отказ = Истина;
	СообщитьПроверку(
		"Документ в статусе «" + Строка(Выборка.Статус)
		+ "» нельзя менять. Содержимое доступно только в статусах «Черновик» или «На доработке».");

КонецПроцедуры

Функция СнимокСодержания(Источник, ЗначенияТаблица)

	Части = Новый Массив;
	Части.Добавить(Строка(Источник.ВидДокумента));
	Части.Добавить(Строка(Источник.Автор));
	Части.Добавить(Строка(Источник.Ответственный));
	Части.Добавить(Строка(Источник.Руководитель));
	Части.Добавить(Строка(Источник.Содержание));

	Значения = Новый СписокЗначений;
	Для Каждого СтрокаЗначения Из ЗначенияТаблица Цикл
		Значения.Добавить(
			Строка(СтрокаЗначения.Идентификатор) + "=" + Строка(СтрокаЗначения.ЗначениеСтрока));
	КонецЦикла;
	Значения.СортироватьПоЗначению();
	СтрокиЗначений = Новый Массив;
	Для Каждого ЭлементЗначения Из Значения Цикл
		СтрокиЗначений.Добавить(ЭлементЗначения.Значение);
	КонецЦикла;
	Части.Добавить(СтрСоединить(СтрокиЗначений, ";"));

	Возврат СтрСоединить(Части, "|");

КонецФункции

Процедура СообщитьПроверку(Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();

КонецПроцедуры
