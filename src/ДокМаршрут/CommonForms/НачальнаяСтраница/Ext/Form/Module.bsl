#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	НастроитьОформлениеСтатусов();
	ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура РазобратьВнимание(Команда)
	ОбновитьВниманиеНаСервере(ВопросВнимания, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДокумент(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	СтрокаДокумента = Элемент.ТекущиеДанные;
	Если СтрокаДокумента <> Неопределено Тогда
		ОткрытьФорму("Документ.ДокументСЭД.Форма.ФормаДокумента",
			Новый Структура("Ключ", СтрокаДокумента.Ссылка), ЭтаФорма, , , ,
			Новый ОписаниеОповещения("ПослеЗакрытияРабочейФормы", ЭтотОбъект));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияРабочейФормы(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	ОбновитьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеСтраницы

&НаСервере
Процедура ОбновитьНаСервере()
	Данные = ДинамическиеФормы.ДанныеНачальнойСтраницы();
	ЗначениеВРеквизитФормы(Данные.Документы, "МоиДокументы");
	ЗначениеВРеквизитФормы(Данные.Согласования, "МоиСогласования");
	Пояснение = Данные.Пояснение;
	Приветствие = ?(ЗначениеЗаполнено(Данные.Сотрудник), "ДокМаршрут — " + Строка(Данные.Сотрудник), "ДокМаршрут");
	ВсегоДокументов = 0;
	ВсегоСогласований = Данные.ВсегоСогласований;
	Черновики = 0;
	НаСогласовании = 0;
	Согласованы = 0;
	Отклонены = 0;
	НаДоработке = 0;
	Для Каждого Счетчик Из Данные.Счетчики Цикл
		ВсегоДокументов = ВсегоДокументов + Счетчик.Количество;
		Если Счетчик.Статус = Перечисления.СтатусыДокументов.Черновик Тогда
			Черновики = Счетчик.Количество;
		ИначеЕсли Счетчик.Статус = Перечисления.СтатусыДокументов.НаСогласовании Тогда
			НаСогласовании = Счетчик.Количество;
		ИначеЕсли Счетчик.Статус = Перечисления.СтатусыДокументов.Согласован Тогда
			Согласованы = Счетчик.Количество;
		ИначеЕсли Счетчик.Статус = Перечисления.СтатусыДокументов.Отклонен Тогда
			Отклонены = Счетчик.Количество;
		ИначеЕсли Счетчик.Статус = Перечисления.СтатусыДокументов.НаДоработке Тогда
			НаДоработке = Счетчик.Количество;
		КонецЕсли;
	КонецЦикла;
	Элементы.БлокСогласования.Заголовок = СтрШаблон("Ожидают вашего решения: %1", ВсегоСогласований);
	Элементы.БлокДокументы.Заголовок = СтрШаблон("Мои документы: %1", ВсегоДокументов);
	Для Каждого Имя Из СтрРазделить("Черновики,НаСогласовании,Согласованы,Отклонены,НаДоработке", ",") Цикл
		Элементы[Имя].Формат = "ЧГ=0;ЧДЦ=0;ЧН=0";
	КонецЦикла;
	ОбновитьВниманиеНаСервере(ВопросВнимания, Ложь);
КонецПроцедуры

&НаСервере
Процедура ОбновитьВниманиеНаСервере(ТекстВопроса, ИспользоватьМодель)

	Разбор = Консультант.Ответить(ТекстВопроса, ИспользоватьМодель);
	ТекстВнимания = Разбор.Текст;
	ЗначениеВРеквизитФормы(Разбор.Документы, "ДокументыВнимания");
	Элементы.БлокВнимания.Заголовок = СтрШаблон(
		"На что обратить внимание: %1",
		Разбор.Документы.Количество());

КонецПроцедуры

#КонецОбласти

#Область Оформление

&НаСервере
Процедура НастроитьОформлениеСтатусов()

	ДобавитьОформлениеСтатуса(
		"МоиДокументы",
		Перечисления.СтатусыДокументов.Черновик,
		ЦветаСтиля.СтатусЧерновикЦвет,
		ЦветаСтиля.СтатусЧерновикФон);
	ДобавитьОформлениеСтатуса(
		"МоиДокументы",
		Перечисления.СтатусыДокументов.НаСогласовании,
		ЦветаСтиля.СтатусНаСогласованииЦвет,
		ЦветаСтиля.СтатусНаСогласованииФон);
	ДобавитьОформлениеСтатуса(
		"МоиДокументы",
		Перечисления.СтатусыДокументов.Согласован,
		ЦветаСтиля.СтатусСогласованЦвет,
		ЦветаСтиля.СтатусСогласованФон);
	ДобавитьОформлениеСтатуса(
		"МоиДокументы",
		Перечисления.СтатусыДокументов.Отклонен,
		ЦветаСтиля.СтатусОтклоненЦвет,
		ЦветаСтиля.СтатусОтклоненФон);
	ДобавитьОформлениеСтатуса(
		"МоиДокументы",
		Перечисления.СтатусыДокументов.НаДоработке,
		ЦветаСтиля.СтатусНаДоработкеЦвет,
		ЦветаСтиля.СтатусНаДоработкеФон);

	ДобавитьОформлениеСтатуса(
		"МоиСогласования",
		Перечисления.СтатусыДокументов.Черновик,
		ЦветаСтиля.СтатусЧерновикЦвет,
		ЦветаСтиля.СтатусЧерновикФон);
	ДобавитьОформлениеСтатуса(
		"МоиСогласования",
		Перечисления.СтатусыДокументов.НаСогласовании,
		ЦветаСтиля.СтатусНаСогласованииЦвет,
		ЦветаСтиля.СтатусНаСогласованииФон);
	ДобавитьОформлениеСтатуса(
		"МоиСогласования",
		Перечисления.СтатусыДокументов.Согласован,
		ЦветаСтиля.СтатусСогласованЦвет,
		ЦветаСтиля.СтатусСогласованФон);
	ДобавитьОформлениеСтатуса(
		"МоиСогласования",
		Перечисления.СтатусыДокументов.Отклонен,
		ЦветаСтиля.СтатусОтклоненЦвет,
		ЦветаСтиля.СтатусОтклоненФон);
	ДобавитьОформлениеСтатуса(
		"МоиСогласования",
		Перечисления.СтатусыДокументов.НаДоработке,
		ЦветаСтиля.СтатусНаДоработкеЦвет,
		ЦветаСтиля.СтатусНаДоработкеФон);

	ДобавитьОформлениеСтатуса(
		"ДокументыВнимания",
		Перечисления.СтатусыДокументов.Черновик,
		ЦветаСтиля.СтатусЧерновикЦвет,
		ЦветаСтиля.СтатусЧерновикФон);
	ДобавитьОформлениеСтатуса(
		"ДокументыВнимания",
		Перечисления.СтатусыДокументов.НаСогласовании,
		ЦветаСтиля.СтатусНаСогласованииЦвет,
		ЦветаСтиля.СтатусНаСогласованииФон);
	ДобавитьОформлениеСтатуса(
		"ДокументыВнимания",
		Перечисления.СтатусыДокументов.Согласован,
		ЦветаСтиля.СтатусСогласованЦвет,
		ЦветаСтиля.СтатусСогласованФон);
	ДобавитьОформлениеСтатуса(
		"ДокументыВнимания",
		Перечисления.СтатусыДокументов.Отклонен,
		ЦветаСтиля.СтатусОтклоненЦвет,
		ЦветаСтиля.СтатусОтклоненФон);
	ДобавитьОформлениеСтатуса(
		"ДокументыВнимания",
		Перечисления.СтатусыДокументов.НаДоработке,
		ЦветаСтиля.СтатусНаДоработкеЦвет,
		ЦветаСтиля.СтатусНаДоработкеФон);

КонецПроцедуры

&НаСервере
Процедура ДобавитьОформлениеСтатуса(ИмяТаблицы, Статус, ЦветТекста, ЦветФона)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ПолеСтатус = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеСтатус.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ".Статус");
	ПолеСтатус.Использование = Истина;

	Отбор = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ".Статус");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Статус;
	Отбор.Использование = Истина;

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветТекста);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
	ЭлементОформления.Использование = Истина;

КонецПроцедуры

#КонецОбласти
