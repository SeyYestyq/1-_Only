&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.СтатусНастройки.Пустая() Тогда
		Объект.СтатусНастройки = Перечисления.СтатусыНастройкиВида.Черновик;
	КонецЕсли;
	Элементы.ПоляИдентификатор.Видимость = Ложь;
	ОбновитьОформлениеСтатуса();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ОбновитьОформлениеСтатуса();

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	МаксимальныйПорядок = 0;
	Для Каждого Поле Из ТекущийОбъект.Поля Цикл
		МаксимальныйПорядок = Макс(МаксимальныйПорядок, Поле.Порядок);
	КонецЦикла;
	Для Каждого Поле Из ТекущийОбъект.Поля Цикл
		Если ПустаяСтрока(Поле.Идентификатор) Тогда
			Поле.Идентификатор = СвободныйИдентификаторПоля(ТекущийОбъект.Поля);
		КонецЕсли;
		Если Поле.Порядок <= 0 Тогда
			МаксимальныйПорядок = МаксимальныйПорядок + 1;
			Поле.Порядок = МаксимальныйПорядок;
		КонецЕсли;
		Объект.Поля[Поле.НомерСтроки - 1].Идентификатор = Поле.Идентификатор;
		Объект.Поля[Поле.НомерСтроки - 1].Порядок = Поле.Порядок;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ОбновитьОформлениеСтатуса();

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	Оповестить("ДокМаршрут_ВидДокументаЗаписан", Объект.Ссылка, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ПоляПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если Не НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	СтрокаПоля = Элемент.ТекущиеДанные;
	Если СтрокаПоля = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СледующийПорядок = 1;
	Для Каждого Поле Из Объект.Поля Цикл
		СледующийПорядок = Макс(СледующийПорядок, Поле.Порядок + 1);
	КонецЦикла;
	СтрокаПоля.Порядок = СледующийПорядок;
	СтрокаПоля.Идентификатор = "Поле" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	Если Не ЗначениеЗаполнено(СтрокаПоля.ТипПоля) Тогда
		СтрокаПоля.ТипПоля = ПредопределенноеЗначение("Перечисление.ТипыПолей.Строка");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СвободныйИдентификаторПоля(Поля)

	Пока Истина Цикл
		Кандидат = "Поле" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
		Занят = Ложь;
		Для Каждого Поле Из Поля Цикл
			Если Поле.Идентификатор = Кандидат Тогда
				Занят = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не Занят Тогда
			Возврат Кандидат;
		КонецЕсли;
	КонецЦикла;

КонецФункции

&НаСервере
Процедура ОбновитьОформлениеСтатуса()

	Если Объект.СтатусНастройки = Перечисления.СтатусыНастройкиВида.Готов Тогда
		БейджСтатуса = "✓ Готов";
		Элементы.БейджСтатуса.ЦветТекста = ЦветаСтиля.СтатусСогласованЦвет;
		Элементы.БейджСтатуса.ЦветФона = ЦветаСтиля.СтатусСогласованФон;
	Иначе
		БейджСтатуса = "○ Черновик";
		Элементы.БейджСтатуса.ЦветТекста = ЦветаСтиля.СтатусЧерновикЦвет;
		Элементы.БейджСтатуса.ЦветФона = ЦветаСтиля.СтатусЧерновикФон;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИнструкцию(Команда)

	Текст =
	"Настроить вид документа
	|
	|Новый вид создайте кнопкой «Создать» в списке видов.
	|Черновик продолжите кнопкой «Продолжить в мастере».
	|«Предпросмотр формы» показывает поля вида и не записывает документ.
	|
	|1. Заполните поля «Наименование», «Категория» и «Префикс».
	|
	|2. В таблице «1. Поля документа» добавьте не меньше одного поля.
	|В колонке «Тип поля» выберите: Строка, Число, Дата или Выбор из списка.
	|
	|3. Если тип поля «Выбор из списка»: выделите строку поля, нажмите «Значения списка»
	|и добавьте не меньше двух значений (кнопка «Создать» в открывшемся списке).
	|
	|4. В таблице «2. Маршрут согласования» добавьте не меньше двух этапов.
	|
	|5. Нажмите «Записать».
	|
	|6. Нажмите «Проверить и сохранить шаблон».
	|
	|7. Нажмите «Опубликовать вид».
	|Пока вид в статусе «Черновик», его нельзя выбрать в документе.";
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияСправки", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ОК, , , "Справка");

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияСправки(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Возврат;
КонецПроцедуры

&НаКлиенте
Процедура ЗначенияСписка(Команда)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Или Модифицированность Тогда
		ПоказатьПредупреждение(, "Сначала нажмите «Записать».");
		Возврат;
	КонецЕсли;

	ТекДанные = Элементы.Поля.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "В таблице «1. Поля документа» выделите строку поля.");
		Возврат;
	КонецЕсли;

	Если ТекДанные.ТипПоля <> ПредопределенноеЗначение("Перечисление.ТипыПолей.ВыборИзСписка") Тогда
		ПоказатьПредупреждение(,
			"Значения списка нужны только для типа «Выбор из списка». В колонке «Тип поля» выберите это значение.");
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(ТекДанные.Идентификатор) Тогда
		ПоказатьПредупреждение(, "Сначала нажмите «Записать», затем откройте значения списка.");
		Возврат;
	КонецЕсли;

	Отбор = Новый Структура;
	Отбор.Вставить("Владелец", Объект.Ссылка);
	Отбор.Вставить("ИдентификаторПоля", ТекДанные.Идентификатор);

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", Отбор);
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", Отбор);

	ОткрытьФорму("Справочник.ЗначенияПолей.ФормаСписка", ПараметрыФормы);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьШаблон(Команда)

	Если Модифицированность Тогда
		ПоказатьПредупреждение(, "Сначала нажмите «Записать».");
		Возврат;
	КонецЕсли;

	Результат = ПроверитьШаблонНаСервере(Объект.Ссылка);
	Текст = СтрСоединить(Результат.Сообщения, Символы.ПС);
	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя("ДокМаршрут", , Текст);
	Иначе
		ПоказатьПредупреждение(, Текст);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОпубликоватьВид(Команда)

	Если Модифицированность Тогда
		ПоказатьПредупреждение(, "Сначала нажмите «Записать».");
		Возврат;
	КонецЕсли;

	Результат = ОпубликоватьВидНаСервере(Объект.Ссылка);
	Текст = СтрСоединить(Результат.Сообщения, Символы.ПС);
	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя("ДокМаршрут", , Текст);
		Прочитать();
	Иначе
		ПоказатьПредупреждение(, Текст);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьШаблонНаСервере(СсылкаВид)

	Возврат КонструкторВидов.ПроверитьШаблон(СсылкаВид);

КонецФункции

&НаСервереБезКонтекста
Функция ОпубликоватьВидНаСервере(СсылкаВид)

	Возврат КонструкторВидов.ОпубликоватьВид(СсылкаВид);

КонецФункции

&НаКлиенте
Процедура ПредпросмотрФормы(Команда)

	Если Модифицированность Или Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Сначала запишите вид, чтобы показать актуальный состав полей.");
		Возврат;
	КонецЕсли;
	ОткрытьФорму(
		"Документ.ДокументСЭД.Форма.ФормаДокумента",
		Новый Структура("ВидДляПредпросмотра", Объект.Ссылка),
		ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьМастер(Команда)

	Если Объект.СтатусНастройки = ПредопределенноеЗначение("Перечисление.СтатусыНастройкиВида.Готов") Тогда
		ПоказатьПредупреждение(, "Опубликованный вид редактируется в обычной карточке.");
		Возврат;
	КонецЕсли;
	Если Модифицированность Или Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	СсылкаВида = Объект.Ссылка;
	Закрыть();
	ОткрытьФорму("Справочник.ВидыДокументов.Форма.ФормаМастер", Новый Структура("Ключ", СсылкаВида));

КонецПроцедуры
