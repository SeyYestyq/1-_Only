#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Объект.СтатусНастройки = Перечисления.СтатусыНастройкиВида.Готов Тогда
		Отказ = Истина;
		СообщитьОшибку("Опубликованный вид открывайте в обычной карточке.", "");
		Возврат;
	КонецЕсли;
	Объект.СтатусНастройки = Перечисления.СтатусыНастройкиВида.Черновик;
	Элементы.РезультатПроверки.Высота = 8;
	Элементы.ПоляИдентификатор.Видимость = Ложь;
	ШагМастера = 1;
	ОбновитьШаг();
КонецПроцедуры

&НаКлиенте
Процедура Далее(Команда)
	// ОчиститьСообщения есть только на клиенте. На сервере вызов не компилируется.
	ОчиститьСообщения();
	Если Не ПроверитьШагНаСервере() Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗаписатьВидСОповещением() Тогда
		Возврат;
	КонецЕсли;
	ПерейтиНаШаг(ШагМастера + 1);
КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)
	ПерейтиНаШаг(ШагМастера - 1);
КонецПроцедуры

&НаКлиенте
Процедура СохранитьЧерновик(Команда)
	Если ЗаписатьВидСОповещением() Тогда
		ПоказатьОповещениеПользователя("Черновик вида сохранён");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗначенияСписка(Команда)
	СтрокаПоля = Элементы.Поля.ТекущиеДанные;
	Если СтрокаПоля = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите строку поля в таблице.");
		Возврат;
	КонецЕсли;
	Если СтрокаПоля.ТипПоля <> ПредопределенноеЗначение("Перечисление.ТипыПолей.ВыборИзСписка") Тогда
		ПоказатьПредупреждение(, "Выберите поле с типом «Выбор из списка».");
		Возврат;
	КонецЕсли;
	Если Не ЗаписатьВидСОповещением() Тогда
		Возврат;
	КонецЕсли;
	СтрокаПоля = Элементы.Поля.ТекущиеДанные;
	Если СтрокаПоля = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИдентификаторПоля = СтрокаПоля.Идентификатор;
	Отбор = Новый Структура("Владелец,ИдентификаторПоля", Объект.Ссылка, ИдентификаторПоля);
	ОткрытьФорму("Справочник.ЗначенияПолей.ФормаСписка",
		Новый Структура("Отбор,ЗначенияЗаполнения", Отбор, Отбор), ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВид(Команда)
	Если Не ЗаписатьВидСОповещением() Тогда
		Возврат;
	КонецЕсли;
	ПроверитьШаблонНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Опубликовать(Команда)
	Если Не ЗаписатьВидСОповещением() Тогда
		Возврат;
	КонецЕсли;
	Если ОпубликоватьНаСервере() Тогда
		Оповестить("ДокМаршрут_ВидДокументаЗаписан", Объект.Ссылка, ЭтаФорма);
		ПоказатьОповещениеПользователя("Вид опубликован. Он доступен при создании документов.");
		Закрыть(Объект.Ссылка);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Предпросмотр(Команда)
	Если Не ЗаписатьВидСОповещением() Тогда
		Возврат;
	КонецЕсли;
	ОткрытьФорму("Документ.ДокументСЭД.Форма.ФормаДокумента",
		Новый Структура("ВидДляПредпросмотра", Объект.Ссылка), ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Функция ЗаписатьВидСОповещением()

	Если Не Записать() Тогда
		Возврат Ложь;
	КонецЕсли;
	Оповестить("ДокМаршрут_ВидДокументаЗаписан", Объект.Ссылка, ЭтаФорма);
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область ШагиМастера

&НаСервере
Процедура ПерейтиНаШаг(НовыйШаг)
	ШагМастера = Макс(1, Мин(4, НовыйШаг));
	ОбновитьШаг();
	Если ШагМастера = 4 Тогда
		ПроверитьШаблонНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбновитьШаг()
	Элементы.ШагОсновное.Видимость = ШагМастера = 1;
	Элементы.ШагПоля.Видимость = ШагМастера = 2;
	Элементы.ШагМаршрут.Видимость = ШагМастера = 3;
	Элементы.ШагПроверка.Видимость = ШагМастера = 4;
	Элементы.КнопкаНазад.Доступность = ШагМастера > 1;
	Элементы.КнопкаДалее.Видимость = ШагМастера < 4;
	Элементы.КнопкаПубликация.Видимость = ШагМастера = 4;
	Элементы.КнопкаЗначенияСписка.Видимость = ШагМастера = 2;
	Элементы.КнопкаПредпросмотр.Видимость = ШагМастера > 1;
	Элементы.КнопкаПроверить.Видимость = ШагМастера = 4;
	Элементы.КнопкаДалее.КнопкаПоУмолчанию = ШагМастера < 4;
	Элементы.КнопкаПубликация.КнопкаПоУмолчанию = ШагМастера = 4;
	Если ШагМастера = 1 Тогда
		ПодсказкаМастера = "После «Далее» сохраняется черновик. Продолжить можно из карточки вида.";
	ИначеЕсли ШагМастера = 2 Тогда
		ПодсказкаМастера = "Для поля «Выбор из списка» добавьте не меньше двух значений кнопкой «Значения списка».";
	ИначеЕсли ШагМастера = 3 Тогда
		ПодсказкаМастера = "Добавьте не меньше двух разных согласующих в порядке прохождения документа.";
	Иначе
		ПодсказкаМастера = "Исправьте ошибки на предыдущих шагах, затем нажмите «Проверить снова».";
	КонецЕсли;
	Названия = СтрРазделить("Основное,Поля,Маршрут,Проверка", ",");
	ИндикаторШагов = "";
	Для Номер = 1 По 4 Цикл
		Если Номер > 1 Тогда
			ИндикаторШагов = ИндикаторШагов + "  →  ";
		КонецЕсли;
		ИндикаторШагов = ИндикаторШагов + ?(Номер < ШагМастера, "✓ ", ?(Номер = ШагМастера, "● ", "○ ")) + Названия[Номер - 1];
	КонецЦикла;
	Заголовок = СтрШаблон("Мастер вида — шаг %1 из 4", ШагМастера);
КонецПроцедуры

&НаСервере
Функция ПроверитьШагНаСервере()
	// DataPath поля — Объект.Description (стандартный реквизит в XML),
	// не Объект.Наименование: иначе проверка всегда видит пусто.
	Успех = Истина;
	Если ШагМастера = 1 Тогда
		Если ПустаяСтрока(СокрЛП(Объект.Description)) Тогда
			СообщитьОшибку("Заполните наименование вида.", "Объект.Description");
			Успех = Ложь;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.Категория) Тогда
			СообщитьОшибку("Выберите категорию.", "Объект.Категория");
			Успех = Ложь;
		КонецЕсли;
		Если ПустаяСтрока(СокрЛП(Объект.Префикс)) Тогда
			СообщитьОшибку("Задайте префикс номера, например ДОП.", "Объект.Префикс");
			Успех = Ложь;
		КонецЕсли;
	ИначеЕсли ШагМастера = 2 Тогда
		ЕстьВидимое = Ложь;
		Для Каждого Поле Из Объект.Поля Цикл
			Если Поле.Скрыто Тогда
				Продолжить;
			КонецЕсли;
			ЕстьВидимое = Истина;
			Если ПустаяСтрока(Поле.Заголовок) Или Не ЗначениеЗаполнено(Поле.ТипПоля) Тогда
				СообщитьОшибку("У каждого поля заполните заголовок и тип.", "Объект.Поля");
				Успех = Ложь;
			КонецЕсли;
		КонецЦикла;
		Если Не ЕстьВидимое Тогда
			СообщитьОшибку("Добавьте хотя бы одно видимое поле.", "Объект.Поля");
			Успех = Ложь;
		КонецЕсли;
	ИначеЕсли ШагМастера = 3 Тогда
		Если Объект.Маршрут.Количество() < 2 Тогда
			СообщитьОшибку("Добавьте не меньше двух этапов с разными согласующими.", "Объект.Маршрут");
			Успех = Ложь;
		КонецЕсли;
	КонецЕсли;
	Возврат Успех;
КонецФункции

&НаСервере
Процедура ПроверитьШаблонНаСервере()
	Результат = КонструкторВидов.ПроверитьШаблон(Объект.Ссылка);
	РезультатПроверки = ТекстПроверкиМастера(Результат.Сообщения);
	Элементы.КнопкаПубликация.Доступность = Результат.Успех;
КонецПроцедуры

&НаСервере
Функция ОпубликоватьНаСервере()
	// Проверка в ядре выполняется заново, а не по сохранённому результату шага 4.
	Результат = КонструкторВидов.ОпубликоватьВид(Объект.Ссылка);
	РезультатПроверки = ТекстПроверкиМастера(Результат.Сообщения);
	Возврат Результат.Успех;
КонецФункции

&НаСервере
Процедура СообщитьОшибку(Текст, Поле)
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.Сообщить();
КонецПроцедуры

#КонецОбласти


&НаКлиенте
Процедура ПоляПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если Не НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	СтрокаПоля = Элемент.ТекущиеДанные;
	Если СтрокаПоля = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СледующийПорядок = 1;
	Для Каждого Поле Из Объект.Поля Цикл
		СледующийПорядок = Макс(СледующийПорядок, Поле.Порядок + 1);
	КонецЦикла;
	СтрокаПоля.Порядок = СледующийПорядок;
	СтрокаПоля.Идентификатор = "Поле" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	Если Не ЗначениеЗаполнено(СтрокаПоля.ТипПоля) Тогда
		СтрокаПоля.ТипПоля = ПредопределенноеЗначение("Перечисление.ТипыПолей.Строка");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура МаршрутПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если Не НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	СтрокаМаршрута = Элемент.ТекущиеДанные;
	Если СтрокаМаршрута <> Неопределено Тогда
		СтрокаМаршрута.НомерЭтапа = Объект.Маршрут.Количество();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	МаксимальныйПорядок = 0;
	Для Каждого Поле Из ТекущийОбъект.Поля Цикл
		МаксимальныйПорядок = Макс(МаксимальныйПорядок, Поле.Порядок);
	КонецЦикла;
	Для Каждого Поле Из ТекущийОбъект.Поля Цикл
		Если ПустаяСтрока(Поле.Идентификатор) Тогда
			Поле.Идентификатор = СвободныйИдентификаторПоля(ТекущийОбъект.Поля);
		КонецЕсли;
		Если Поле.Порядок <= 0 Тогда
			МаксимальныйПорядок = МаксимальныйПорядок + 1;
			Поле.Порядок = МаксимальныйПорядок;
		КонецЕсли;
		Объект.Поля[Поле.НомерСтроки - 1].Идентификатор = Поле.Идентификатор;
		Объект.Поля[Поле.НомерСтроки - 1].Порядок = Поле.Порядок;
	КонецЦикла;
	Номер = 0;
	Для Каждого Этап Из ТекущийОбъект.Маршрут Цикл
		Номер = Номер + 1;
		Этап.НомерЭтапа = Номер;
		Объект.Маршрут[Номер - 1].НомерЭтапа = Номер;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ТекстПроверкиМастера(Сообщения)
	Текст = СтрСоединить(Сообщения, Символы.ПС);
	Текст = СтрЗаменить(Текст, "«1. Поля документа»", "«Поля документа»");
	Возврат СтрЗаменить(Текст, "«2. Маршрут согласования»", "«Маршрут»");
КонецФункции

&НаСервере
Функция СвободныйИдентификаторПоля(Поля)
	Пока Истина Цикл
		Кандидат = "Поле" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
		Занят = Ложь;
		Для Каждого Поле Из Поля Цикл
			Если Поле.Идентификатор = Кандидат Тогда
				Занят = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не Занят Тогда
			Возврат Кандидат;
		КонецЕсли;
	КонецЦикла;
КонецФункции
