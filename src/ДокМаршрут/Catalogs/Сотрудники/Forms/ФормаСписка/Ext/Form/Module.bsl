&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Заголовок = "Сотрудники";
	Для Каждого Имя Из СтрРазделить("ФормаСоздать,Создать,СписокСоздать", ",") Цикл
		Кнопка = Элементы.Найти(Имя);
		Если Кнопка <> Неопределено И Кнопка <> Элементы.КнопкаСоздать Тогда
			Кнопка.Видимость = Ложь;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура Создать(Команда)

	ОткрытьФорму("Справочник.Сотрудники.Форма.ФормаЭлемента");

КонецПроцедуры
