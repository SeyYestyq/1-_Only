&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Настройки = Уведомления.ПрочитатьНастройкиSMTP();
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Настройки);
	// Пароль в форму не подставляем: пустое поле при записи не затирает сохранённый.
	ПарольSMTP = "";
	ПарольПоказан = Ложь;
	ОбновитьПодписьПароляНаСервере(Настройки.ПарольЗадан);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИнструкцию(Команда)

	Текст =
	"Настройка почты
	|
	|1. В блоке «Сервер» укажите адрес SMTP, порт и при необходимости включите флажок «Использовать SSL».
	|2. В блоке «Учётная запись» введите логин и пароль SMTP.
	|3. В блоке «Отправитель» укажите адрес отправителя.
	|4. В шапке формы нажмите «Записать настройки».
	|5. В шапке формы нажмите «Проверить отправку».
	|Тестовое письмо уйдёт на адрес отправителя.
	|
	|Письма уходят ответственному и руководителю из карточки сотрудника.
	|Пустой пароль не затирает уже сохранённый.
	|Кнопка «Показать пароль» справа от поля показывает сохранённый пароль. Повторное нажатие снова скрывает поле.
	|Флажок «Автоматически повторять неудачные отправки» включает очередь неудачных писем.";
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияСправки", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ОК, , , "Справка");

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияСправки(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Возврат;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьНастройки(Команда)

	ЗаписатьНастройкиНаСервере();
	Если ПарольПоказан Тогда
		СкрытьПарольНаКлиенте();
	Иначе
		ОбновитьПодписьПослеЗаписиНаСервере();
	КонецЕсли;
	ПоказатьОповещениеПользователя("ДокМаршрут", , "Настройки почты записаны.");

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОтправку(Команда)

	ЗаписатьНастройкиНаСервере();
	Результат = ПроверитьОтправкуНаСервере();
	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя("ДокМаршрут", , Результат.Текст);
	Иначе
		ПоказатьПредупреждение(, Результат.Текст);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПароль(Команда)

	Если ПарольПоказан Тогда
		СкрытьПарольНаКлиенте();
		Возврат;
	КонецЕсли;

	ПарольSMTP = ПрочитатьПарольНаСервере();
	Если ПустаяСтрока(ПарольSMTP) Тогда
		ПодписьПароля = "Пароль ещё не задан. Введите новый и нажмите «Записать настройки».";
		ПоказатьПредупреждение(, "Сохранённый пароль пуст. Введите пароль в поле и запишите настройки.");
		Возврат;
	КонецЕсли;

	ПарольПоказан = Истина;
	Элементы.ПарольSMTP.РежимПароля = Ложь;
	Элементы.КнопкаПоказатьПароль.Заголовок = "Скрыть пароль";
	ПодписьПароля = "Пароль показан. Нажмите «Показать пароль» ещё раз, чтобы скрыть.";

КонецПроцедуры

&НаКлиенте
Процедура СкрытьПарольНаКлиенте()

	ПарольSMTP = "";
	ПарольПоказан = Ложь;
	Элементы.ПарольSMTP.РежимПароля = Истина;
	Элементы.КнопкаПоказатьПароль.Заголовок = "Показать пароль";
	ОбновитьПодписьПароляНаСервере(Истина);

КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиНаСервере()

	Настройки = Новый Структура;
	Настройки.Вставить("АдресSMTP", АдресSMTP);
	Настройки.Вставить("ПортSMTP", ПортSMTP);
	Настройки.Вставить("ИспользоватьSSL", ИспользоватьSSL);
	Настройки.Вставить("ЛогинSMTP", ЛогинSMTP);
	Настройки.Вставить("ПарольSMTP", ПарольSMTP);
	Настройки.Вставить("АдресОтправителя", АдресОтправителя);
	Настройки.Вставить("ТаймаутSMTP", ?(ТаймаутSMTP < 1, 30, ТаймаутSMTP));
	Настройки.Вставить("Автоповтор", Автоповтор);
	Уведомления.ЗаписатьНастройкиSMTP(Настройки);

КонецПроцедуры

&НаСервере
Функция ПроверитьОтправкуНаСервере()

	Возврат Уведомления.ПроверитьОтправку(АдресОтправителя);

КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьПарольНаСервере()

	Возврат Уведомления.ПрочитатьПарольSMTP();

КонецФункции

&НаСервере
Процедура ОбновитьПодписьПароляНаСервере(ПарольЗадан)

	Если ПарольЗадан Тогда
		ПодписьПароля =
			"Пароль сохранён. Пустое поле при записи его не меняет. "
			+ "Кнопка «Показать пароль» справа показывает сохранённый.";
	Иначе
		ПодписьПароля = "Пароль ещё не задан. Введите новый и нажмите «Записать настройки».";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьПодписьПослеЗаписиНаСервере()

	ОбновитьПодписьПароляНаСервере(Не ПустаяСтрока(Уведомления.ПрочитатьПарольSMTP()));

КонецПроцедуры
