&НаКлиенте
Процедура СоздатьДемоБазу(Команда)

	ТекстРезультата = СоздатьДемоБазуНаСервере();
	РезультатЗагрузки = ТекстРезультата;
	ПоказатьОповещениеПользователя("ДокМаршрут", , ТекстРезультата);

КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьДемоБазуНаСервере()

	Текст = ТестовыеДанные.СоздатьДемоБазу();
	Возврат Текст;

КонецФункции
