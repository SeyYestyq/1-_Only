&НаКлиенте
Процедура ЗапуститьПроверки(Команда)

	ЖурналПроверок = ЗапуститьПроверкиНаСервере();
	Если СтрНайти(ЖурналПроверок, "ИТОГ: FAIL") > 0 Тогда
		ПоказатьПредупреждение(, "Есть ошибки. Смотрите журнал на форме.");
	Иначе
		ПоказатьОповещениеПользователя("ДокМаршрут", , "Проверки пройдены. Журнал на форме.");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИнструкцию(Команда)

	Текст =
	"Проверки P0
	|
	|1. Откройте обработку из раздела «Сервис».
	|2. В шапке формы нажмите «Запустить проверки».
	|3. Читайте журнал на форме.
	|Внизу журнала итог PASS или FAIL.";
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияСправки", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ОК, , , "Справка");

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияСправки(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Возврат;
КонецПроцедуры

&НаСервере
Функция ЗапуститьПроверкиНаСервере()

	Строки = Новый Массив;
	Строки.Добавить("=== Проверки P0 ===");
	Строки.Добавить(ВыполнитьПроверку("метаданные", "ПроверкаМетаданных"));
	Строки.Добавить(ВыполнитьПроверку("демо-данные", "ПроверкаДемоДанных"));
	Строки.Добавить(ВыполнитьПроверку("демо-виды", "ПроверкаДемоВидов"));
	Строки.Добавить(ВыполнитьПроверку("инвариант шаблона", "ПроверкаИнвариантаШаблона"));
	Строки.Добавить(ВыполнитьПроверку("обязательные поля", "ПроверкаОбязательныхПолей"));
	Строки.Добавить(ВыполнитьПроверку("сценарий согласования", "ПроверкаСценарияСогласования"));
	Строки.Добавить(ВыполнитьПроверку("отклонение без комментария", "ПроверкаОтклоненияБезКомментария"));
	Строки.Добавить(ВыполнитьПроверку("повторное решение", "ПроверкаПовторногоРешения"));
	Строки.Добавить(ВыполнитьПроверку("печать", "ПроверкаПечати"));
	Строки.Добавить(ВыполнитьПроверку("журнал уведомлений", "ПроверкаЖурналаУведомлений"));
	Строки.Добавить(ИтогПоЖурналу(Строки));
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаСервере
Функция ВыполнитьПроверку(ИмяПроверки, ИмяПроцедуры)

	Попытка
		Если ИмяПроцедуры = "ПроверкаМетаданных" Тогда
			Возврат ПроверкаМетаданных();
		ИначеЕсли ИмяПроцедуры = "ПроверкаДемоДанных" Тогда
			Возврат ПроверкаДемоДанных();
		ИначеЕсли ИмяПроцедуры = "ПроверкаДемоВидов" Тогда
			Возврат ПроверкаДемоВидов();
		ИначеЕсли ИмяПроцедуры = "ПроверкаИнвариантаШаблона" Тогда
			Возврат ПроверкаИнвариантаШаблона();
		ИначеЕсли ИмяПроцедуры = "ПроверкаОбязательныхПолей" Тогда
			Возврат ПроверкаОбязательныхПолей();
		ИначеЕсли ИмяПроцедуры = "ПроверкаСценарияСогласования" Тогда
			Возврат ПроверкаСценарияСогласования();
		ИначеЕсли ИмяПроцедуры = "ПроверкаОтклоненияБезКомментария" Тогда
			Возврат ПроверкаОтклоненияБезКомментария();
		ИначеЕсли ИмяПроцедуры = "ПроверкаПовторногоРешения" Тогда
			Возврат ПроверкаПовторногоРешения();
		ИначеЕсли ИмяПроцедуры = "ПроверкаПечати" Тогда
			Возврат ПроверкаПечати();
		ИначеЕсли ИмяПроцедуры = "ПроверкаЖурналаУведомлений" Тогда
			Возврат ПроверкаЖурналаУведомлений();
		КонецЕсли;
		Возврат "FAIL: неизвестная проверка «" + ИмяПроцедуры + "».";
	Исключение
		Возврат "FAIL: " + ИмяПроверки + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

&НаСервере
Функция ИтогПоЖурналу(Строки)

	Ок = 0;
	Провал = 0;
	Пропуск = 0;
	Для Каждого Строка Из Строки Цикл
		Если СтрНачинаетсяС(Строка, "OK:") Тогда
			Ок = Ок + 1;
		ИначеЕсли СтрНачинаетсяС(Строка, "FAIL:") Тогда
			Провал = Провал + 1;
		ИначеЕсли СтрНачинаетсяС(Строка, "SKIP:") Тогда
			Пропуск = Пропуск + 1;
		КонецЕсли;
	КонецЦикла;

	Если Провал = 0 Тогда
		Возврат СтрШаблон("--- ИТОГ: PASS (OK %1, SKIP %2, FAIL %3) ---", Ок, Пропуск, Провал);
	КонецЕсли;
	Возврат СтрШаблон("--- ИТОГ: FAIL (OK %1, SKIP %2, FAIL %3) ---", Ок, Пропуск, Провал);

КонецФункции

&НаСервере
Функция ПроверкаМетаданных()

	Если Метаданные.Документы.ДокументСЭД.Проведение = Метаданные.СвойстваОбъектов.Проведение.Запретить Тогда
		Возврат "OK: документ без проведения.";
	КонецЕсли;
	Возврат "FAIL: у документа разрешено проведение.";

КонецФункции

&НаСервере
Функция ПроверкаДемоДанных()

	Сотрудники = КоличествоСсылок("Справочник.Сотрудники");
	Виды = КоличествоСсылок("Справочник.ВидыДокументов");
	ДокументыСЭД = КоличествоСсылок("Документ.ДокументСЭД");

	Если Сотрудники < 5 Или Виды < 3 Или ДокументыСЭД < 6 Тогда
		Возврат СтрШаблон(
			"FAIL: демо-данных мало (%1/%2/%3). Нужно не меньше 5/3/6. Откройте «Загрузка демо-данных» в «Сервис».",
			Сотрудники,
			Виды,
			ДокументыСЭД);
	КонецЕсли;

	Возврат СтрШаблон("OK: демо-данные на месте (%1 сотрудников, %2 видов, %3 документов).", Сотрудники, Виды, ДокументыСЭД);

КонецФункции

&НаСервере
Функция КоличествоСсылок(ИмяТаблицы)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Т.Ссылка) КАК Количество
	|ИЗ
	|	" + ИмяТаблицы + " КАК Т";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	Возврат 0;

КонецФункции

&НаСервере
Функция ПроверкаДемоВидов()

	ТестовыеДанные.ОбеспечитьДемоВиды();

	Имена = Новый Массив;
	Имена.Добавить("Служебная записка");
	Имена.Добавить("Договор поставки");
	Имена.Добавить("Исходящее письмо");

	Проблемы = Новый Массив;
	Для Каждого ИмяВида Из Имена Цикл
		Вид = Справочники.ВидыДокументов.НайтиПоНаименованию(ИмяВида);
		Если Не ЗначениеЗаполнено(Вид) Тогда
			Проблемы.Добавить("нет вида «" + ИмяВида + "»");
			Продолжить;
		КонецЕсли;

		ОбъектВид = Вид.ПолучитьОбъект();
		Если ОбъектВид.СтатусНастройки <> Перечисления.СтатусыНастройкиВида.Готов Тогда
			Проблемы.Добавить(ИмяВида + ": не опубликован");
		КонецЕсли;
		Если ОбъектВид.Маршрут.Количество() < 2 Тогда
			Проблемы.Добавить(ИмяВида + ": в маршруте меньше 2 этапов");
		КонецЕсли;
		Если ОбъектВид.Поля.Количество() < 1 Тогда
			Проблемы.Добавить(ИмяВида + ": нет полей");
		КонецЕсли;

		Проверка = КонструкторВидов.ПроверитьШаблон(Вид);
		Если Не Проверка.Успех Тогда
			Проблемы.Добавить(ИмяВида + ": " + СтрСоединить(Проверка.Сообщения, "; "));
		КонецЕсли;
	КонецЦикла;

	Если Проблемы.Количество() > 0 Тогда
		Возврат "FAIL: демо-виды: " + СтрСоединить(Проблемы, "; ");
	КонецЕсли;
	Возврат "OK: три демо-вида опубликованы, шаблоны и маршруты из 2+ этапов в порядке.";

КонецФункции

&НаСервере
Функция ПроверкаИнвариантаШаблона()

	// Property: вид с одним этапом не проходит проверку.
	Вид = Справочники.ВидыДокументов.СоздатьЭлемент();
	Вид.Наименование = "P0-плохой-шаблон-" + Формат(ТекущаяДатаСеанса(), "ДФ=HHmmss");
	Вид.Категория = Перечисления.КатегорииДокументов.Входящий;
	Вид.Префикс = "P0";
	Вид.СтатусНастройки = Перечисления.СтатусыНастройкиВида.Черновик;

	СтрокаПоля = Вид.Поля.Добавить();
	СтрокаПоля.Порядок = 1;
	СтрокаПоля.Заголовок = "Тема";
	СтрокаПоля.Идентификатор = "Тема";
	СтрокаПоля.ТипПоля = Перечисления.ТипыПолей.Строка;
	СтрокаПоля.Обязательное = Истина;
	СтрокаПоля.Длина = 100;

	Сотрудник = Справочники.Сотрудники.НайтиПоНаименованию("Иванов Сергей");
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат "SKIP: нет сотрудника для проверки шаблона с одним этапом.";
	КонецЕсли;

	СтрокаМ = Вид.Маршрут.Добавить();
	СтрокаМ.НомерЭтапа = 1;
	СтрокаМ.НазваниеЭтапа = "Один";
	СтрокаМ.Согласующий = Сотрудник;
	Вид.Записать();

	Проверка = КонструкторВидов.ПроверитьШаблон(Вид.Ссылка);
	Вид.УстановитьПометкуУдаления(Истина);

	Если Проверка.Успех Тогда
		Возврат "FAIL: шаблон с одним этапом ошибочно прошёл проверку.";
	КонецЕсли;
	Возврат "OK: маршрут из одного этапа отклоняется.";

КонецФункции

&НаСервере
Функция ПроверкаОбязательныхПолей()

	Вид = Справочники.ВидыДокументов.НайтиПоНаименованию("Служебная записка");
	Если Не ЗначениеЗаполнено(Вид) Тогда
		Возврат "SKIP: нет вида для проверки обязательных полей.";
	КонецЕсли;

	Док = Документы.ДокументСЭД.СоздатьДокумент();
	Док.Дата = ТекущаяДатаСеанса();
	Док.ВидДокумента = Вид;
	Док.Категория = Вид.Категория;
	Док.Статус = Перечисления.СтатусыДокументов.Черновик;
	Док.Содержание = "P0-обязательные-поля";
	ДинамическиеФормы.ЗаполнитьЗначенияПолейИзВида(Док, Вид.ПолучитьОбъект());

	Текст = ДинамическиеФормы.ТекстПроверкиОбязательных(Док);
	Если ПустаяСтрока(Текст) Тогда
		Возврат "FAIL: пустые обязательные поля не пойманы.";
	КонецЕсли;
	Возврат "OK: пустые обязательные поля блокируют отправку («" + Текст + "»).";

КонецФункции

&НаСервере
Функция ПроверкаСценарияСогласования()

	ДокументСсылка = НайтиИлиСоздатьСценарийДокумент("P0-E2E-согласование");
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат "FAIL: не удалось подготовить документ сценария.";
	КонецЕсли;

	ОбъектДок = ДокументСсылка.ПолучитьОбъект();
	Если ОбъектДок.Статус = Перечисления.СтатусыДокументов.Согласован
		И ОбъектДок.МаршрутСнимок.Количество() >= 2 Тогда
		Возврат "OK: сценарий уже пройден: документ «P0-E2E-согласование» в статусе Согласован.";
	КонецЕсли;

	Если ОбъектДок.Статус <> Перечисления.СтатусыДокументов.Черновик
		И ОбъектДок.Статус <> Перечисления.СтатусыДокументов.НаДоработке Тогда
		ДокументСсылка = НайтиИлиСоздатьСценарийДокумент(
			"P0-E2E-согласование-" + Формат(ТекущаяДатаСеанса(), "ДФ=HHmmss"),
			Истина);
		ОбъектДок = ДокументСсылка.ПолучитьОбъект();
	КонецЕсли;

	ЗаполнитьЗначенияПолейТестом(ОбъектДок);
	ОбъектДок.Записать();

	РезультатОтправки = Согласование.ОтправитьНаСогласование(ДокументСсылка);
	Если Не РезультатОтправки.Успех Тогда
		Возврат "FAIL: отправка на согласование: " + РезультатОтправки.Текст;
	КонецЕсли;

	ОбъектДок = ДокументСсылка.ПолучитьОбъект();
	Если ОбъектДок.МаршрутСнимок.Количество() < 2 Тогда
		Возврат "FAIL: в снимке маршрута меньше 2 этапов.";
	КонецЕсли;
	Если ОбъектДок.Статус <> Перечисления.СтатусыДокументов.НаСогласовании Тогда
		Возврат "FAIL: после отправки статус не «На согласовании».";
	КонецЕсли;

	ВсегоЭтапов = ОбъектДок.ВсегоЭтапов;
	Для Номер = 1 По ВсегоЭтапов Цикл
		РезультатРешения = Согласование.ПринятьРешение(
			ДокументСсылка,
			Перечисления.РешенияСогласования.Согласовано,
			"");
		Если Не РезультатРешения.Успех Тогда
			Возврат "FAIL: этап " + Номер + ": " + РезультатРешения.Текст;
		КонецЕсли;
	КонецЦикла;

	ОбъектДок = ДокументСсылка.ПолучитьОбъект();
	Если ОбъектДок.Статус <> Перечисления.СтатусыДокументов.Согласован Тогда
		Возврат "FAIL: после всех этапов статус " + Строка(ОбъектДок.Статус) + ", ждали Согласован.";
	КонецЕсли;

	Таймлайн = Согласование.ЭтапыДляТаймлайна(ДокументСсылка);
	Если Таймлайн.Количество() <> ВсегоЭтапов Тогда
		Возврат "FAIL: в таймлайне " + Таймлайн.Количество() + " этапов, ждали " + ВсегоЭтапов + ".";
	КонецЕсли;
	Для Каждого СтрокаТаймлайна Из Таймлайн Цикл
		Если СтрокаТаймлайна.Состояние <> "Пройден" Тогда
			Возврат "FAIL: этап " + СтрокаТаймлайна.Номер + " в состоянии «"
				+ СтрокаТаймлайна.Состояние + "», ждали Пройден.";
		КонецЕсли;
	КонецЦикла;

	Возврат СтрШаблон(
		"OK: отправка, %1 согласований, статус Согласован, таймлайн %2×Пройден.",
		ВсегоЭтапов,
		Таймлайн.Количество());

КонецФункции

&НаСервере
Функция ПроверкаОтклоненияБезКомментария()

	ДокументСсылка = НайтиИлиСоздатьСценарийДокумент("P0-отклонение-без-комментария", Истина);
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат "SKIP: нет документа для проверки отклонения.";
	КонецЕсли;

	ОбъектДок = ДокументСсылка.ПолучитьОбъект();
	ДинамическиеФормы.СинхронизироватьЗначенияПолейСВидом(ОбъектДок);
	ЗаполнитьЗначенияПолейТестом(ОбъектДок);
	ОбъектДок.Записать();

	Если ОбъектДок.Статус = Перечисления.СтатусыДокументов.Черновик
		Или ОбъектДок.Статус = Перечисления.СтатусыДокументов.НаДоработке Тогда
		РезультатОтправки = Согласование.ОтправитьНаСогласование(ДокументСсылка);
		Если Не РезультатОтправки.Успех Тогда
			Возврат "FAIL: не удалось подготовить отклонение: " + РезультатОтправки.Текст;
		КонецЕсли;
	КонецЕсли;

	Результат = Согласование.ПринятьРешение(
		ДокументСсылка,
		Перечисления.РешенияСогласования.Отклонено,
		"");
	Если Результат.Успех Тогда
		Возврат "FAIL: отклонение без комментария прошло.";
	КонецЕсли;
	Возврат "OK: отклонение без комментария запрещено.";

КонецФункции

&НаСервере
Функция ПроверкаПовторногоРешения()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДокументСЭД.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ДокументСЭД КАК ДокументСЭД
	|ГДЕ
	|	ДокументСЭД.Статус = &Статус
	|	И ВЫРАЗИТЬ(ДокументСЭД.Содержание КАК СТРОКА(100)) ПОДОБНО &Маска";
	Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыДокументов.Согласован);
	Запрос.УстановитьПараметр("Маска", "P0-E2E-согласование%");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "SKIP: нет согласованного документа сценария для проверки повторного решения.";
	КонецЕсли;

	Результат = Согласование.ПринятьРешение(
		Выборка.Ссылка,
		Перечисления.РешенияСогласования.Согласовано,
		"");
	Если Результат.Успех Тогда
		Возврат "FAIL: повторное решение на согласованном документе прошло.";
	КонецЕсли;
	Возврат "OK: повторное решение отклонено («" + Результат.Текст + "»).";

КонецФункции

&НаСервере
Функция ПроверкаПечати()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДокументСЭД.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ДокументСЭД КАК ДокументСЭД
	|УПОРЯДОЧИТЬ ПО
	|	ДокументСЭД.Дата УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "SKIP: нет документов для печати.";
	КонецЕсли;

	Попытка
		ТабличныйДокумент = ПечатьДокументов.ПечатнаяФорма(Выборка.Ссылка.ПолучитьОбъект());
		Если ТабличныйДокумент.ВысотаТаблицы < 1 Тогда
			Возврат "FAIL: печатная форма пустая.";
		КонецЕсли;
	Исключение
		Возврат "FAIL: печать: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// Учебная 8.5 может ограничивать PDF — проверяем хотя бы табличный документ.
	Возврат "OK: печатная форма строится (" + ТабличныйДокумент.ВысотаТаблицы + " строк).";

КонецФункции

&НаСервере
Функция ПроверкаЖурналаУведомлений()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Журнал.Документ) КАК Количество
	|ИЗ
	|	РегистрСведений.ЖурналУведомлений КАК Журнал";
	Выборка = Запрос.Выполнить().Выбрать();
	Количество = 0;
	Если Выборка.Следующий() Тогда
		Количество = Выборка.Количество;
	КонецЕсли;

	Если Количество = 0 Тогда
		Возврат "SKIP: журнал уведомлений пуст (SMTP ещё не вызывался; нормально до сценария и настроек почты).";
	КонецЕсли;

	// FR-N5: ошибки SMTP не должны мешать наличию записей журнала после событий.
	Возврат "OK: в журнале уведомлений записей: " + Количество + ".";

КонецФункции

&НаСервере
Функция НайтиИлиСоздатьСценарийДокумент(КлючСодержания, ВсегдаНовый = Ложь)

	Если Не ВсегдаНовый Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДокументСЭД.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ДокументСЭД КАК ДокументСЭД
		|ГДЕ
		|	ВЫРАЗИТЬ(ДокументСЭД.Содержание КАК СТРОКА(100)) = &Ключ";
		Запрос.УстановитьПараметр("Ключ", КлючСодержания);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	Вид = Справочники.ВидыДокументов.НайтиПоНаименованию("Служебная записка");
	Если Не ЗначениеЗаполнено(Вид) Тогда
		Возврат Документы.ДокументСЭД.ПустаяСсылка();
	КонецЕсли;

	Док = Документы.ДокументСЭД.СоздатьДокумент();
	Док.Дата = ТекущаяДатаСеанса();
	Док.ВидДокумента = Вид;
	Док.Категория = Вид.Категория;
	Док.Автор = Справочники.Сотрудники.НайтиПоНаименованию("Никитин Денис");
	Док.Ответственный = Справочники.Сотрудники.НайтиПоНаименованию("Сидоров Олег");
	Док.Руководитель = Справочники.Сотрудники.НайтиПоНаименованию("Козлова Мария");
	Док.Статус = Перечисления.СтатусыДокументов.Черновик;
	Док.Содержание = КлючСодержания;
	ДинамическиеФормы.ЗаполнитьЗначенияПолейИзВида(Док, Вид.ПолучитьОбъект());
	ЗаполнитьЗначенияПолейТестом(Док);
	Док.Записать();
	Возврат Док.Ссылка;

КонецФункции

&НаСервере
Процедура ЗаполнитьЗначенияПолейТестом(ДокументОбъект)

	Если Не ЗначениеЗаполнено(ДокументОбъект.ВидДокумента) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаЗначения Из ДокументОбъект.ЗначенияПолей Цикл
		ТипПоля = ДинамическиеФормы.ТипПоляПоИдентификатору(
			ДокументОбъект.ВидДокумента,
			СтрокаЗначения.Идентификатор);
		Текущее = СокрЛП(СтрокаЗначения.ЗначениеСтрока);
		НужноЗаполнить = ПустаяСтрока(Текущее);
		Если ТипПоля = Перечисления.ТипыПолей.Число Тогда
			Если НужноЗаполнить Или Текущее = "тест P0" Тогда
				СтрокаЗначения.ЗначениеСтрока = "1";
			КонецЕсли;
		ИначеЕсли ТипПоля = Перечисления.ТипыПолей.Дата Тогда
			Если НужноЗаполнить Или Текущее = "тест P0" Тогда
				СтрокаЗначения.ЗначениеСтрока = "31.12.2026";
			КонецЕсли;
		ИначеЕсли НужноЗаполнить Тогда
			СтрокаЗначения.ЗначениеСтрока = "тест P0";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
