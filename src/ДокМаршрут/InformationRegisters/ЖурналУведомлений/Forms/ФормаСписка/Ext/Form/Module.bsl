&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Заголовок = "Журнал уведомлений";
	ОтборТолькоОшибки = Ложь;
	НастроитьПоляОтборов();
	ОбновитьСпискиВыбораОтборов();
	ПрименитьОтборы();

КонецПроцедуры

&НаСервере
Процедура НастроитьПоляОтборов()

	// Документ — только из журнала (выпадающий список), без общего списка всех СЭД.
	ПолеДокумент = Элементы.ОтборДокумент;
	ПолеДокумент.КнопкаВыбора = Ложь;
	ПолеДокумент.КнопкаВыпадающегоСписка = Истина;
	ПолеДокумент.КнопкаОчистки = Истина;
	ПолеДокумент.РедактированиеТекста = Ложь;

	ПолеПолучатель = Элементы.ОтборПолучатель;
	ПолеПолучатель.КнопкаВыбора = Ложь;
	ПолеПолучатель.КнопкаВыпадающегоСписка = Истина;
	ПолеПолучатель.КнопкаОчистки = Истина;
	ПолеПолучатель.РедактированиеТекста = Истина;

	ПолеСобытие = Элементы.ОтборСобытие;
	ПолеСобытие.КнопкаВыбора = Ложь;
	ПолеСобытие.КнопкаВыпадающегоСписка = Истина;
	ПолеСобытие.КнопкаОчистки = Истина;
	ПолеСобытие.РедактированиеТекста = Истина;

КонецПроцедуры

&НаСервере
Процедура ОбновитьСпискиВыбораОтборов()

	ЗаполнитьСписокВыбораДокументов();
	ЗаполнитьСписокВыбораСтрок(Элементы.ОтборПолучатель, "Получатель");
	ЗаполнитьСписокВыбораСтрок(Элементы.ОтборСобытие, "Событие");

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораДокументов()

	СписокВыбора = Элементы.ОтборДокумент.СписокВыбора;
	СписокВыбора.Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Журнал.Документ КАК Документ
	|ИЗ
	|	РегистрСведений.ЖурналУведомлений КАК Журнал
	|ГДЕ
	|	Журнал.Документ <> ЗНАЧЕНИЕ(Документ.ДокументСЭД.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Документ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокВыбора.Добавить(Выборка.Документ);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораСтрок(ПолеФормы, ИмяПоляРегистра)

	СписокВыбора = ПолеФормы.СписокВыбора;
	СписокВыбора.Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Журнал." + ИмяПоляРегистра + " КАК Значение
	|ИЗ
	|	РегистрСведений.ЖурналУведомлений КАК Журнал
	|ГДЕ
	|	Журнал." + ИмяПоляРегистра + " <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	Значение";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокВыбора.Добавить(Выборка.Значение);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИнструкцию(Команда)

	Текст =
	"Журнал уведомлений
	|
	|В шапке списка поля «Документ», «Получатель» и «Событие» фильтруют записи.
	|Списки значений строятся по уже имеющимся записям и обновляются при открытии.
	|«Сбросить» очищает все отборы.
	|
	|Выберите неудачную строку и нажмите «Отправить повторно».
	|Удалить запись: выберите строку и удалите через меню «⋯».";
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияСправки", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ОК, , , "Справка");

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияСправки(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Возврат;
КонецПроцедуры

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	ПрименитьОтборыНаСервере();
	Элементы.Список.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура СброситьОтборы(Команда)

	ОтборДокумент = Неопределено;
	ОтборПолучатель = "";
	ОтборСобытие = "";
	ОтборТолькоОшибки = Ложь;
	ПрименитьОтборыНаСервере();
	Элементы.Список.Обновить();

КонецПроцедуры

&НаСервере
Процедура ПрименитьОтборыНаСервере()

	ОбновитьСпискиВыбораОтборов();
	ПрименитьОтборы();

КонецПроцедуры

&НаСервере
Процедура ПрименитьОтборы()

	Отбор = Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор;
	Отбор.Элементы.Очистить();

	Если ЗначениеЗаполнено(ОтборДокумент) Тогда
		ДобавитьОтбор(Отбор, "Документ", ВидСравненияКомпоновкиДанных.Равно, ОтборДокумент);
	КонецЕсли;

	ТекстПолучателя = "";
	Если ТипЗнч(ОтборПолучатель) = Тип("Строка") Тогда
		ТекстПолучателя = СокрЛП(ОтборПолучатель);
	КонецЕсли;
	Если Не ПустаяСтрока(ТекстПолучателя) Тогда
		ДобавитьОтбор(Отбор, "Получатель", ВидСравненияКомпоновкиДанных.Содержит, ТекстПолучателя);
	КонецЕсли;

	ТекстСобытия = "";
	Если ТипЗнч(ОтборСобытие) = Тип("Строка") Тогда
		ТекстСобытия = СокрЛП(ОтборСобытие);
	КонецЕсли;
	Если Не ПустаяСтрока(ТекстСобытия) Тогда
		ДобавитьОтбор(Отбор, "Событие", ВидСравненияКомпоновкиДанных.Содержит, ТекстСобытия);
	КонецЕсли;

	Если ОтборТолькоОшибки = Истина Тогда
		ДобавитьОтбор(Отбор, "Успешно", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДобавитьОтбор(Отбор, ИмяПоля, ВидСравнения, Значение)

	ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
	ЭлементОтбора.ВидСравнения = ВидСравнения;
	ЭлементОтбора.ПравоеЗначение = Значение;
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;

КонецПроцедуры

&НаКлиенте
Процедура ПовторитьОтправку(Команда)

	СтрокаЖурнала = Элементы.Список.ТекущаяСтрока;
	Если СтрокаЖурнала = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите неудачную попытку в журнале.");
		Возврат;
	КонецЕсли;
	Результат = ПовторитьОтправкуНаСервере(СтрокаЖурнала);
	Элементы.Список.Обновить();
	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя("ДокМаршрут", , Результат.Текст);
	Иначе
		ПоказатьПредупреждение(, Результат.Текст);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПовторитьОтправкуНаСервере(СтрокаЖурнала)

	Ключ = Новый Структура("Документ, ДатаВремя, Получатель, Канал, ИдентификаторПопытки");
	ЗаполнитьЗначенияСвойств(Ключ, СтрокаЖурнала);
	Возврат Уведомления.ПовторитьПоЗаписиЖурнала(Ключ);

КонецФункции
