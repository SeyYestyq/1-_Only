
// Локальный файл с ключом не коммитится. В журнал и в файл статуса ключ не пишется.

Функция ПрочитатьНастройкиИИ() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("АдресСервисаИИ", Константы.АдресСервисаИИ.Получить());
	Настройки.Вставить("КлючAPIИИ", Константы.КлючAPIИИ.Получить());
	Возврат Настройки;

КонецФункции

Процедура ЗаписатьНастройкиИИ(Настройки) Экспорт

	Константы.АдресСервисаИИ.Установить(СокрЛП(Настройки.АдресСервисаИИ));
	Константы.КлючAPIИИ.Установить(СокрЛП(Настройки.КлючAPIИИ));

КонецПроцедуры

Процедура ПодключитьЛокальныйКлючИИ(Принудительно = Ложь) Экспорт

	АдресУжеЗадан = Не ПустаяСтрока(СокрЛП(Константы.АдресСервисаИИ.Получить()));
	КлючУжеЗадан = Не ПустаяСтрока(СокрЛП(Константы.КлючAPIИИ.Получить()));
	Если Не Принудительно И АдресУжеЗадан И КлючУжеЗадан Тогда
		Возврат;
	КонецЕсли;

	ОписаниеФайла = Неопределено;
	КлючAPI = "";
	Для Каждого ПутьКлюча Из ПутиЛокальногоФайлаКлюча() Цикл
		ОписаниеФайла = ОписаниеФайлаКлюча(ПутьКлюча);
		Если ОписаниеФайла = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		КлючAPI = КлючАвторизацииИзТекста(ОписаниеФайла.Текст);
		Если Не ПустаяСтрока(КлючAPI) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ПустаяСтрока(КлючAPI) Тогда
		Если Принудительно Тогда
			Если ОписаниеФайла = Неопределено Тогда
				ЗаписатьСтатусПодключенияИИ("unchanged", "file-missing", "");
			Иначе
				ЗаписатьСтатусПодключенияИИ("unchanged", "key-not-found", ОписаниеФайла.Диагностика);
			КонецЕсли;
		КонецЕсли;
		Возврат;
	КонецЕсли;

	АдресСервиса = "https://gigachat.devices.sberbank.ru/api/v1/chat/completions";
	Настройки = Новый Структура;
	Настройки.Вставить("АдресСервисаИИ", АдресСервиса);
	Настройки.Вставить("КлючAPIИИ", КлючAPI);
	ЗаписатьНастройкиИИ(Настройки);

	Если Не Принудительно Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Результат = ИнтеграцияИИСервер.ПолучитьРекомендациюЧтоЧитатьДальше("Чистый код", 10, "рефакторинг");
		Если Результат.Успех Тогда
			ЗаписатьСтатусПодключенияИИ("set", "ok", ОписаниеФайла.Диагностика);
		Иначе
			ЗаписатьСтатусПодключенияИИ("set", "fail", СкрытьСекрет(Результат.ТекстОшибки, КлючAPI));
		КонецЕсли;
	Исключение
		ЗаписатьСтатусПодключенияИИ("set", "fail", СкрытьСекрет(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), КлючAPI));
	КонецПопытки;

КонецПроцедуры

Функция ОписаниеФайлаКлюча(Путь)

	Файл = Новый Файл(Путь);
	Если Не Файл.Существует() Или Файл.ЭтоКаталог() Или Файл.Размер() <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Документ = Новый ТекстовыйДокумент;
	Документ.Прочитать(Путь, КодировкаТекста.UTF8);
	ЧислоСтрок = Документ.КоличествоСтрок();
	МаксДлина = 0;
	Части = Новый Массив;
	Для Номер = 1 По ЧислоСтрок Цикл
		СтрокаФайла = Документ.ПолучитьСтроку(Номер);
		Если СтрДлина(СтрокаФайла) > МаксДлина Тогда
			МаксДлина = СтрДлина(СтрокаФайла);
		КонецЕсли;
		Части.Добавить(СтрокаФайла);
	КонецЦикла;
	Описание = Новый Структура;
	Описание.Вставить("Текст", СтрСоединить(Части, Символы.ПС));
	Описание.Вставить(
		"Диагностика",
		"lines=" + Формат(ЧислоСтрок, "ЧГ=0")
		+ ";size=" + Формат(Файл.Размер(), "ЧГ=0")
		+ ";max=" + Формат(МаксДлина, "ЧГ=0"));
	Возврат Описание;

КонецФункции

Функция ПутиЛокальногоФайлаКлюча()

	КаталогПроекта = "/Users/damir/Documents/хакатоны/1С";
	Пути = Новый Массив;
	Пути.Добавить(КаталогПроекта + "/bases/giga-auth.key");
	Найденные = НайтиФайлы(КаталогПроекта, "ключи гига*", Ложь);
	Для Каждого Файл Из Найденные Цикл
		Пути.Добавить(Файл.ПолноеИмя);
	КонецЦикла;
	Пути.Добавить(КаталогПроекта + "/ключи гига ");
	Пути.Добавить(КаталогПроекта + "/ключи гига");
	Пути.Добавить(КаталогПроекта + "/src/ЧитательскийДневникПолка/НАСТРОЙКИ.local.md");
	Возврат Пути;

КонецФункции

Функция КлючАвторизацииИзТекста(Текст)

	Лучший = "";
	Текущий = "";
	ДлинаТекста = СтрДлина(Текст);
	Для Индекс = 1 По ДлинаТекста + 1 Цикл
		Символ = "";
		Если Индекс <= ДлинаТекста Тогда
			Символ = Сред(Текст, Индекс, 1);
		КонецЕсли;
		Если Индекс <= ДлинаТекста И ЭтоСимволBase64(Символ) Тогда
			Текущий = Текущий + Символ;
		Иначе
			Если СтрДлина(Текущий) >= 40 И СтрДлина(Текущий) > СтрДлина(Лучший) Тогда
				Лучший = Текущий;
			КонецЕсли;
			Текущий = "";
		КонецЕсли;
	КонецЦикла;
	Возврат Лучший;

КонецФункции

Функция ЭтоСимволBase64(Символ)

	Код = КодСимвола(Символ);
	Возврат (Код >= 48 И Код <= 57)
		Или (Код >= 65 И Код <= 90)
		Или (Код >= 97 И Код <= 122)
		Или Символ = "+"
		Или Символ = "/"
		Или Символ = "=";

КонецФункции

Процедура ЗаписатьСтатусПодключенияИИ(СостояниеКонстант, Результат, Детали)

	Адрес = СокрЛП(Константы.АдресСервисаИИ.Получить());
	ДлинаКлюча = СтрДлина(СокрЛП(Константы.КлючAPIИИ.Получить()));
	Строки = Новый Массив;
	Строки.Добавить("constants=" + СостояниеКонстант);
	Строки.Добавить("address=" + Адрес);
	Строки.Добавить("key_length=" + Формат(ДлинаКлюча, "ЧГ=0"));
	Строки.Добавить("scope=GIGACHAT_API_PERS");
	Строки.Добавить("model=GigaChat");
	Строки.Добавить("result=" + Результат);
	Строки.Добавить("detail=" + Детали);
	Запись = Новый ЗаписьТекста("/Users/damir/Documents/хакатоны/1С/bases/polka-ai-check.txt", КодировкаТекста.UTF8);
	Запись.Записать(СтрСоединить(Строки, Символы.ПС));
	Запись.Закрыть();

КонецПроцедуры

Функция СкрытьСекрет(Текст, КлючAPI)

	Результат = Строка(Текст);
	Если Не ПустаяСтрока(КлючAPI) Тогда
		Результат = СтрЗаменить(Результат, КлючAPI, "***");
	КонецЕсли;
	ПозицияBearer = СтрНайти(НРег(Результат), "bearer ");
	Если ПозицияBearer > 0 Тогда
		Результат = Лев(Результат, ПозицияBearer - 1) + "Bearer ***";
	КонецЕсли;
	Результат = СтрЗаменить(Результат, "access_token", "token");
	Если СтрДлина(Результат) > 240 Тогда
		Результат = Лев(Результат, 240);
	КонецЕсли;
	Возврат Результат;

КонецФункции
