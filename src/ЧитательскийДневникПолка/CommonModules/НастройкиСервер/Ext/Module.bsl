Функция ПрочитатьНастройкиИИ() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("АдресСервисаИИ", Константы.АдресСервисаИИ.Получить());
	Настройки.Вставить("КлючAPIИИ", Константы.КлючAPIИИ.Получить());
	Возврат Настройки;

КонецФункции

Процедура ЗаписатьНастройкиИИ(Настройки) Экспорт

	Константы.АдресСервисаИИ.Установить(СокрЛП(Настройки.АдресСервисаИИ));
	Константы.КлючAPIИИ.Установить(СокрЛП(Настройки.КлючAPIИИ));

КонецПроцедуры
