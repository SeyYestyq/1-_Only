// Запросы к базе выполняются до цикла записи. Внутри цикла запросов нет.
Функция ЗагрузитьДемоДанные() Экспорт

	ИсточникиПоИмени = НайтиИсточники(ИменаИсточников());
	СессииПоКомментарию = НайтиСессии(КомментарииСессий());
	ЗаметкиПоКлючу = НайтиЗаметки(ИменаИсточников());

	Источники = Новый Соответствие;
	Для Каждого ОписаниеИсточника Из ПланИсточников() Цикл
		Источники.Вставить(
			ОписаниеИсточника.Наименование,
			ЗаписатьИсточник(ОписаниеИсточника, ИсточникиПоИмени));
	КонецЦикла;

	СозданоСессий = 0;
	СессийЗаНеделю = 0;
	СтраницЗаНеделю = 0;
	СтраницыИсточникаЗаНеделю = Новый Соответствие;
	Для Каждого ОписаниеСессии Из ПланСессий() Цикл
		ПрочитаноСтраниц = ОписаниеСессии.КонечнаяСтраница - ОписаниеСессии.НачальнаяСтраница + 1;
		Если ОписаниеСессии.СдвигДней >= -7 Тогда
			СессийЗаНеделю = СессийЗаНеделю + 1;
			СтраницЗаНеделю = СтраницЗаНеделю + ПрочитаноСтраниц;
			УжеНакоплено = СтраницыИсточникаЗаНеделю.Получить(ОписаниеСессии.ИмяИсточника);
			Если УжеНакоплено = Неопределено Тогда
				УжеНакоплено = 0;
			КонецЕсли;
			СтраницыИсточникаЗаНеделю.Вставить(ОписаниеСессии.ИмяИсточника, УжеНакоплено + ПрочитаноСтраниц);
		КонецЕсли;
		СозданоСессий = СозданоСессий + ЗаписатьСессию(ОписаниеСессии, Источники, СессииПоКомментарию);
	КонецЦикла;

	СозданоЗаметок = 0;
	Для Каждого ОписаниеЗаметки Из ПланЗаметок() Цикл
		СозданоЗаметок = СозданоЗаметок + ЗаписатьЗаметку(ОписаниеЗаметки, Источники, ЗаметкиПоКлючу);
	КонецЦикла;

	ИмяАктивного = "нет данных за 7 дней";
	СтраницАктивного = 0;
	Для Каждого ПараИсточника Из СтраницыИсточникаЗаНеделю Цикл
		Если ПараИсточника.Значение > СтраницАктивного Тогда
			СтраницАктивного = ПараИсточника.Значение;
			ИмяАктивного = ПараИсточника.Ключ;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрШаблон(
		"Демо-данные полки готовы. Новых сессий: %1, новых заметок: %2. "
		+ "Внутри 7 дней: %3 сессий и %4 страниц. Самый активный источник: %5, %6 страниц. "
		+ "Две сессии старше 7 дней: «Чистый код» страницы 81-100 и учебник страницы 51-70.",
		СозданоСессий,
		СозданоЗаметок,
		СессийЗаНеделю,
		СтраницЗаНеделю,
		ИмяАктивного,
		СтраницАктивного);

КонецФункции

Функция ПланИсточников()

	План = Новый Массив;
	План.Добавить(Новый Структура(
		"Наименование, Автор, ИмяТипа, ОбщееКоличествоСтраниц, Тема",
		"Чистый код",
		"Р. Мартин",
		"Книга",
		464,
		"Архитектура ПО"));
	План.Добавить(Новый Структура(
		"Наименование, Автор, ИмяТипа, ОбщееКоличествоСтраниц, Тема",
		"Практическое пособие разработчика 1С:Предприятие 8.3",
		"М.Г. Радченко",
		"Учебник",
		920,
		"Разработка 1С"));
	План.Добавить(Новый Структура(
		"Наименование, Автор, ИмяТипа, ОбщееКоличествоСтраниц, Тема",
		"Интеграция LLM и REST API в учетных системах",
		"Коллектив авторов",
		"Статья",
		25,
		"Искусственный интеллект"));
	Возврат План;

КонецФункции

Функция ПланСессий()

	План = Новый Массив;
	План.Добавить(ОписаниеСессии("Чистый код", 1, 40, 0, "Демо: сегодня, страницы 1-40"));
	План.Добавить(ОписаниеСессии("Чистый код", 41, 80, -2, "Демо: два дня назад, страницы 41-80"));
	План.Добавить(ОписаниеСессии("Чистый код", 81, 100, -10, "Демо: десять дней назад, страницы 81-100"));
	План.Добавить(ОписаниеСессии("Практическое пособие разработчика 1С:Предприятие 8.3", 1, 30, -3, "Демо: три дня назад, страницы 1-30"));
	План.Добавить(ОписаниеСессии("Практическое пособие разработчика 1С:Предприятие 8.3", 31, 50, -5, "Демо: пять дней назад, страницы 31-50"));
	План.Добавить(ОписаниеСессии("Практическое пособие разработчика 1С:Предприятие 8.3", 51, 70, -20, "Демо: двадцать дней назад, страницы 51-70"));
	План.Добавить(ОписаниеСессии("Интеграция LLM и REST API в учетных системах", 1, 10, -1, "Демо: вчера, страницы 1-10"));
	План.Добавить(ОписаниеСессии("Интеграция LLM и REST API в учетных системах", 11, 15, -6, "Демо: шесть дней назад, страницы 11-15"));
	Возврат План;

КонецФункции

Функция ОписаниеСессии(ИмяИсточника, НачальнаяСтраница, КонечнаяСтраница, СдвигДней, Комментарий)

	Возврат Новый Структура(
		"ИмяИсточника, НачальнаяСтраница, КонечнаяСтраница, СдвигДней, Комментарий",
		ИмяИсточника,
		НачальнаяСтраница,
		КонечнаяСтраница,
		СдвигДней,
		Комментарий);

КонецФункции

Функция ПланЗаметок()

	План = Новый Массив;
	План.Добавить(ОписаниеЗаметки("Чистый код", 12, "Имена должны раскрывать намерение.", "Имена и намерение", 0));
	План.Добавить(ОписаниеЗаметки("Чистый код", 45, "Функция делает одно дело.", "Одна функция", -2));
	План.Добавить(ОписаниеЗаметки("Чистый код", 90, "Не комментируйте плохой код, перепишите его.", "Переписать код", -10));
	План.Добавить(ОписаниеЗаметки("Практическое пособие разработчика 1С:Предприятие 8.3", 15, "Документ фиксирует событие.", "Документ и событие", -3));
	План.Добавить(ОписаниеЗаметки("Практическое пособие разработчика 1С:Предприятие 8.3", 40, "Запрос в цикле замедляет проведение.", "Запрос в цикле", -5));
	План.Добавить(ОписаниеЗаметки("Интеграция LLM и REST API в учетных системах", 3, "Ключ API хранится в константе, не в модуле.", "Ключ в константе", -1));
	Возврат План;

КонецФункции

Функция ОписаниеЗаметки(ИмяИсточника, НомерСтраницы, ТекстЗаметки, Заголовок, СдвигДней)

	Возврат Новый Структура(
		"ИмяИсточника, НомерСтраницы, ТекстЗаметки, Заголовок, СдвигДней",
		ИмяИсточника,
		НомерСтраницы,
		ТекстЗаметки,
		Заголовок,
		СдвигДней);

КонецФункции

Функция ИменаИсточников()

	Имена = Новый Массив;
	Для Каждого ОписаниеИсточника Из ПланИсточников() Цикл
		Имена.Добавить(ОписаниеИсточника.Наименование);
	КонецЦикла;
	Возврат Имена;

КонецФункции

Функция КомментарииСессий()

	Комментарии = Новый Массив;
	Для Каждого ОписаниеСессии Из ПланСессий() Цикл
		Комментарии.Добавить(ОписаниеСессии.Комментарий);
	КонецЦикла;
	Возврат Комментарии;

КонецФункции

Функция НайтиИсточники(Имена)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Источники.Ссылка КАК Ссылка,
	|	Источники.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ИсточникиЧтения КАК Источники
	|ГДЕ
	|	Источники.Наименование В (&Имена)
	|	И НЕ Источники.ПометкаУдаления";
	Запрос.УстановитьПараметр("Имена", Имена);

	Найденные = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Найденные.Вставить(Выборка.Наименование, Выборка.Ссылка);
	КонецЦикла;
	Возврат Найденные;

КонецФункции

Функция НайтиСессии(Комментарии)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сессия.Ссылка КАК Ссылка,
	|	Сессия.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.СессияЧтения КАК Сессия
	|ГДЕ
	|	Сессия.Комментарий В (&Комментарии)";
	Запрос.УстановитьПараметр("Комментарии", Комментарии);

	Найденные = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Найденные.Вставить(Выборка.Комментарий, Выборка.Ссылка);
	КонецЦикла;
	Возврат Найденные;

КонецФункции

Функция НайтиЗаметки(ИменаИсточников)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заметки.Владелец.Наименование КАК ИмяИсточника,
	|	Заметки.НомерСтраницы КАК НомерСтраницы,
	|	Заметки.ТекстЗаметки КАК ТекстЗаметки
	|ИЗ
	|	Справочник.ЗаметкиКИсточникам КАК Заметки
	|ГДЕ
	|	Заметки.Владелец.Наименование В (&ИменаИсточников)
	|	И НЕ Заметки.ПометкаУдаления";
	Запрос.УстановитьПараметр("ИменаИсточников", ИменаИсточников);

	Найденные = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Найденные.Вставить(
			КлючЗаметки(Выборка.ИмяИсточника, Выборка.НомерСтраницы, Выборка.ТекстЗаметки),
			Истина);
	КонецЦикла;
	Возврат Найденные;

КонецФункции

Функция ЗаписатьИсточник(ОписаниеИсточника, Найденные)

	Ссылка = Найденные.Получить(ОписаниеИсточника.Наименование);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		ОбъектИсточника = Ссылка.ПолучитьОбъект();
	Иначе
		ОбъектИсточника = Справочники.ИсточникиЧтения.СоздатьЭлемент();
	КонецЕсли;

	ОбъектИсточника.Наименование = ОписаниеИсточника.Наименование;
	ОбъектИсточника.Автор = ОписаниеИсточника.Автор;
	ОбъектИсточника.ТипИсточника = ТипИсточникаПоИмени(ОписаниеИсточника.ИмяТипа);
	ОбъектИсточника.ОбщееКоличествоСтраниц = ОписаниеИсточника.ОбщееКоличествоСтраниц;
	ОбъектИсточника.Тема = ОписаниеИсточника.Тема;
	ОбъектИсточника.Записать();
	Найденные.Вставить(ОписаниеИсточника.Наименование, ОбъектИсточника.Ссылка);
	Возврат ОбъектИсточника.Ссылка;

КонецФункции

Функция ЗаписатьСессию(ОписаниеСессии, Источники, Найденные)

	Если Найденные.Получить(ОписаниеСессии.Комментарий) <> Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	ДокументОбъект = Документы.СессияЧтения.СоздатьДокумент();
	ДокументОбъект.Дата = ДатаСоСдвигомДней(ОписаниеСессии.СдвигДней, 18);
	ДокументОбъект.ИсточникЧтения = Источники.Получить(ОписаниеСессии.ИмяИсточника);
	ДокументОбъект.НачальнаяСтраница = ОписаниеСессии.НачальнаяСтраница;
	ДокументОбъект.КонечнаяСтраница = ОписаниеСессии.КонечнаяСтраница;
	ДокументОбъект.Комментарий = ОписаниеСессии.Комментарий;
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Найденные.Вставить(ОписаниеСессии.Комментарий, ДокументОбъект.Ссылка);
	Возврат 1;

КонецФункции

Функция ЗаписатьЗаметку(ОписаниеЗаметки, Источники, Найденные)

	Ключ = КлючЗаметки(ОписаниеЗаметки.ИмяИсточника, ОписаниеЗаметки.НомерСтраницы, ОписаниеЗаметки.ТекстЗаметки);
	Если Найденные.Получить(Ключ) <> Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Заметка = Справочники.ЗаметкиКИсточникам.СоздатьЭлемент();
	Заметка.Владелец = Источники.Получить(ОписаниеЗаметки.ИмяИсточника);
	Заметка.Наименование = ОписаниеЗаметки.Заголовок;
	Заметка.НомерСтраницы = ОписаниеЗаметки.НомерСтраницы;
	Заметка.ТекстЗаметки = ОписаниеЗаметки.ТекстЗаметки;
	Заметка.ДатаСоздания = ДатаСоСдвигомДней(ОписаниеЗаметки.СдвигДней, 12);
	Заметка.Записать();
	Найденные.Вставить(Ключ, Истина);
	Возврат 1;

КонецФункции

Функция КлючЗаметки(ИмяИсточника, НомерСтраницы, ТекстЗаметки)

	Возврат ИмяИсточника + "|" + Формат(НомерСтраницы, "ЧГ=0") + "|" + ТекстЗаметки;

КонецФункции

Функция ТипИсточникаПоИмени(ИмяТипа)

	Если ИмяТипа = "Статья" Тогда
		Возврат Перечисления.ТипыИсточниковЧтения.Статья;
	ИначеЕсли ИмяТипа = "Учебник" Тогда
		Возврат Перечисления.ТипыИсточниковЧтения.Учебник;
	КонецЕсли;
	Возврат Перечисления.ТипыИсточниковЧтения.Книга;

КонецФункции

Функция ДатаСоСдвигомДней(СдвигДней, Час)

	ДатаСеанса = ТекущаяДатаСеанса();
	Возврат Дата(Год(ДатаСеанса), Месяц(ДатаСеанса), День(ДатаСеанса) + СдвигДней, Час, 0, 0);

КонецФункции
