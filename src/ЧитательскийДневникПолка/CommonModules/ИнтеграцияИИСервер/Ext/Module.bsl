// Адаптер HTTP. Ключ и адрес только из констант.
// Адрес с gigachat: OAuth, затем chat/completions.
// Иной адрес: один POST JSON, текст ищется в распространённых полях ответа.
Функция ПолучитьРекомендациюЧтоЧитатьДальше(НазваниеИсточника, ПроцентЗавершения, ТемаИсточника) Экспорт

	Результат = Новый Структура("Успех, ТекстРекомендации, ТекстОшибки", Ложь, "", "");

	АдресСервиса = СокрЛП(Константы.АдресСервисаИИ.Получить());
	КлючAPI = СокрЛП(Константы.КлючAPIИИ.Получить());
	Если ПустаяСтрока(АдресСервиса) Или ПустаяСтрока(КлючAPI) Тогда
		Результат.ТекстОшибки =
			"Заполните константы «Адрес сервиса ИИ» и «Ключ API ИИ» в обработке «Настройки сервиса ИИ». "
			+ "Если сервис не проверяет ключ, впишите в ключ любое непустое значение, например demo.";
		Возврат Результат;
	КонецЕсли;

	ТекстПромпта = СтрШаблон(
		"Студент читает «%1», тема «%2», процент завершения %3. "
		+ "Напиши 1-2 предложения на русском: что читать дальше по этой теме.",
		НазваниеИсточника,
		ТемаИсточника,
		Формат(ПроцентЗавершения, "ЧДЦ=1; ЧН=0"));

	Попытка
		Если ЭтоАдресGigaChat(АдресСервиса) Тогда
			ТекстОтвета = ТекстОтветаGigaChat(АдресСервиса, КлючAPI, ТекстПромпта);
		Иначе
			ТекстОтвета = ТекстОтветаПроизвольногоСервиса(
				АдресСервиса,
				КлючAPI,
				ТекстПромпта,
				НазваниеИсточника,
				ПроцентЗавершения,
				ТемаИсточника);
		КонецЕсли;
		Результат.Успех = Истина;
		Результат.ТекстРекомендации = ОставитьОдноДваПредложения(ТекстОтвета);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			"ИнтеграцияИИ.Ошибка",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Результат.Успех = Ложь;
		Результат.ТекстОшибки = ТекстОшибкиПользователя(ТекстОшибки);
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция ТекстОшибкиПользователя(ТекстОшибки)

	Если СтрНайти(ТекстОшибки, "Повторить") = 0 Тогда
		Возврат ТекстОшибки + " Нажмите «Повторить».";
	КонецЕсли;
	Возврат ТекстОшибки;

КонецФункции

Функция ЭтоАдресGigaChat(АдресСервиса)

	АдресНижний = НРег(АдресСервиса);
	Возврат СтрНайти(АдресНижний, "gigachat") > 0
		Или (СтрНайти(АдресНижний, "sberbank.ru") > 0 И СтрНайти(АдресНижний, "devices") > 0);

КонецФункции

Функция ТекстОтветаGigaChat(АдресСервиса, КлючAPI, ТекстПромпта)

	Адреса = АдресаGigaChat(АдресСервиса);
	ТокенДоступа = ТокенДоступаGigaChat(Адреса.АдресOAuth, КлючAPI);

	Тело = Новый Структура;
	Тело.Вставить("model", "GigaChat");
	Тело.Вставить("temperature", 0.7);
	Тело.Вставить("messages", СообщенияЧата(ТекстПромпта));

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Заголовки.Вставить("Accept", "application/json");
	Заголовки.Вставить("Authorization", "Bearer " + ТокенДоступа);

	ОтветHTTP = ОтветPOST(Адреса.АдресЧата, Заголовки, ЗаписатьТелоJSON(Тело));
	Возврат ТекстИзТелаОтвета(ОтветHTTP);

КонецФункции

Функция АдресаGigaChat(АдресСервиса)

	АдресOAuth = "https://ngw.devices.sberbank.ru:9443/api/v2/oauth";
	АдресЧата = "https://gigachat.devices.sberbank.ru/api/v1/chat/completions";
	АдресНижний = НРег(АдресСервиса);

	Если СтрНайти(АдресНижний, "oauth") > 0 Тогда
		АдресOAuth = АдресСервиса;
	ИначеЕсли СтрНайти(АдресНижний, "chat/completions") > 0 Или СтрНайти(АдресНижний, "/completions") > 0 Тогда
		АдресЧата = АдресСервиса;
	ИначеЕсли СтрНайти(АдресСервиса, "/api/") = 0 Тогда
		АдресЧата = СокрП(АдресСервиса) + "/api/v1/chat/completions";
	Иначе
		АдресЧата = АдресСервиса;
	КонецЕсли;

	Возврат Новый Структура("АдресOAuth, АдресЧата", АдресOAuth, АдресЧата);

КонецФункции

Функция ТокенДоступаGigaChat(АдресOAuth, КлючAPI)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Заголовки.Вставить("Accept", "application/json");
	Заголовки.Вставить("RqUID", Строка(Новый УникальныйИдентификатор));
	Заголовки.Вставить("Authorization", ЗаголовокBasic(КлючAPI));

	ОтветHTTP = ОтветPOST(АдресOAuth, Заголовки, "scope=GIGACHAT_API_PERS");
	КодСостояния = ОтветHTTP.КодСостояния;
	Тело = ОтветHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если КодСостояния < 200 Или КодСостояния >= 300 Тогда
		ВызватьИсключение СтрШаблон(
			"GigaChat не выдал токен, HTTP %1. %2",
			КодСостояния,
			Лев(СокрЛП(Тело), 300));
	КонецЕсли;

	Данные = РазобратьJSON(Тело);
	ТокенДоступа = СтроковоеСвойство(Данные, "access_token");
	Если ПустаяСтрока(ТокенДоступа) Тогда
		ВызватьИсключение "В ответе OAuth GigaChat нет access_token.";
	КонецЕсли;
	Возврат ТокенДоступа;

КонецФункции

Функция ТекстОтветаПроизвольногоСервиса(АдресСервиса, КлючAPI, ТекстПромпта, НазваниеИсточника, ПроцентЗавершения, ТемаИсточника)

	Тело = Новый Структура;
	Тело.Вставить("messages", СообщенияЧата(ТекстПромпта));
	Тело.Вставить("sourceName", НазваниеИсточника);
	Тело.Вставить("completionPercent", ПроцентЗавершения);
	Тело.Вставить("theme", ТемаИсточника);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Заголовки.Вставить("Accept", "application/json");
	Заголовки.Вставить("Authorization", ЗаголовокАвторизации(КлючAPI));

	ОтветHTTP = ОтветPOST(АдресСервиса, Заголовки, ЗаписатьТелоJSON(Тело));
	Возврат ТекстИзТелаОтвета(ОтветHTTP);

КонецФункции

Функция СообщенияЧата(ТекстПромпта)

	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура(
		"role, content",
		"system",
		"Ты консультант студенческого читательского дневника. Отвечай на русском, строго 1-2 предложения."));
	Сообщения.Добавить(Новый Структура("role, content", "user", ТекстПромпта));
	Возврат Сообщения;

КонецФункции

Функция ЗаголовокАвторизации(КлючAPI)

	Ключ = СокрЛП(КлючAPI);
	КлючНижний = НРег(Ключ);
	Если СтрНачинаетсяС(КлючНижний, "bearer ") Или СтрНачинаетсяС(КлючНижний, "basic ") Тогда
		Возврат Ключ;
	КонецЕсли;
	Возврат "Bearer " + Ключ;

КонецФункции

Функция ЗаголовокBasic(КлючAPI)

	Ключ = СокрЛП(КлючAPI);
	Если СтрНачинаетсяС(НРег(Ключ), "basic ") Тогда
		Возврат Ключ;
	КонецЕсли;
	Если СтрНачинаетсяС(НРег(Ключ), "bearer ") Тогда
		Ключ = СокрЛП(Сред(Ключ, 8));
	КонецЕсли;
	Возврат "Basic " + Ключ;

КонецФункции

Функция ОтветPOST(Адрес, Заголовки, Тело)

	Разбор = РазобратьАдресHTTP(Адрес);
	Если ПустаяСтрока(Разбор.Хост) Тогда
		ВызватьИсключение "В адресе сервиса ИИ не найден хост.";
	КонецЕсли;

	ЗащищенноеСоединение = Неопределено;
	Если Разбор.Схема = "https" Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	КонецЕсли;

	Соединение = Новый HTTPСоединение(Разбор.Хост, Разбор.Порт, , , , 30, ЗащищенноеСоединение);
	ЗапросHTTP = Новый HTTPЗапрос(Разбор.Путь, Заголовки);
	ЗапросHTTP.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Соединение.ОтправитьДляОбработки(ЗапросHTTP);

КонецФункции

Функция ТекстИзТелаОтвета(ОтветHTTP)

	КодСостояния = ОтветHTTP.КодСостояния;
	Тело = ОтветHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если КодСостояния < 200 Или КодСостояния >= 300 Тогда
		ВызватьИсключение СтрШаблон(
			"Сервис ИИ вернул HTTP %1. %2 Нажмите «Повторить».",
			КодСостояния,
			Лев(СокрЛП(Тело), 300));
	КонецЕсли;

	Текст = "";
	Попытка
		Данные = РазобратьJSON(Тело);
		Если ТипЗнч(Данные) = Тип("Строка") Тогда
			Текст = Данные;
		Иначе
			Текст = ИзвлечьТекстОтвета(Данные);
		КонецЕсли;
	Исключение
		Текст = "";
	КонецПопытки;

	СокращенноеТело = СокрЛП(Тело);
	Если ПустаяСтрока(СокрЛП(Текст))
		И Не ПустаяСтрока(СокращенноеТело)
		И Не СтрНачинаетсяС(СокращенноеТело, "{")
		И Не СтрНачинаетсяС(СокращенноеТело, "[") Тогда
		Текст = СокращенноеТело;
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		ВызватьИсключение "Сервис вернул ответ без текста рекомендации. Нажмите «Повторить».";
	КонецЕсли;

	Возврат Текст;

КонецФункции

Функция ИзвлечьТекстОтвета(Данные)

	Выборы = ЗначениеСвойства(Данные, "choices");
	Если ТипЗнч(Выборы) = Тип("Массив") И Выборы.Количество() > 0 Тогда
		ПервыйВыбор = Выборы[0];
		СообщениеМодели = ЗначениеСвойства(ПервыйВыбор, "message");
		ТекстВыбора = СтроковоеСвойство(СообщениеМодели, "content");
		Если ПустаяСтрока(ТекстВыбора) Тогда
			ТекстВыбора = СтроковоеСвойство(ПервыйВыбор, "text");
		КонецЕсли;
		Если Не ПустаяСтрока(ТекстВыбора) Тогда
			Возврат ТекстВыбора;
		КонецЕсли;
	КонецЕсли;

	ИменаПолей = Новый Массив;
	ИменаПолей.Добавить("result");
	ИменаПолей.Добавить("text");
	ИменаПолей.Добавить("response");
	ИменаПолей.Добавить("answer");
	ИменаПолей.Добавить("content");
	ИменаПолей.Добавить("output");
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ТекстПоля = СтроковоеСвойство(Данные, ИмяПоля);
		Если Не ПустаяСтрока(ТекстПоля) Тогда
			Возврат ТекстПоля;
		КонецЕсли;
	КонецЦикла;

	Сообщение = ЗначениеСвойства(Данные, "message");
	Если ТипЗнч(Сообщение) = Тип("Строка") И Не ПустаяСтрока(СокрЛП(Сообщение)) Тогда
		Возврат Сообщение;
	КонецЕсли;
	ТекстСообщения = СтроковоеСвойство(Сообщение, "content");
	Если Не ПустаяСтрока(ТекстСообщения) Тогда
		Возврат ТекстСообщения;
	КонецЕсли;

	ВложенныеДанные = ЗначениеСвойства(Данные, "data");
	ТекстДанных = СтроковоеСвойство(ВложенныеДанные, "text");
	Если ПустаяСтрока(ТекстДанных) Тогда
		ТекстДанных = СтроковоеСвойство(ВложенныеДанные, "content");
	КонецЕсли;
	Возврат ТекстДанных;

КонецФункции

Функция ЗначениеСвойства(Узел, Имя)

	Если ТипЗнч(Узел) = Тип("Соответствие") Тогда
		Возврат Узел.Получить(Имя);
	ИначеЕсли ТипЗнч(Узел) = Тип("Структура") И Узел.Свойство(Имя) Тогда
		Возврат Узел[Имя];
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция СтроковоеСвойство(Узел, Имя)

	Значение = ЗначениеСвойства(Узел, Имя);
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат СокрЛП(Значение);
	КонецЕсли;
	Возврат "";

КонецФункции

Функция РазобратьJSON(Текст)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Текст);
	Данные = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	Возврат Данные;

КонецФункции

Функция ЗаписатьТелоJSON(Данные)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

Функция РазобратьАдресHTTP(АдресСервиса)

	Результат = Новый Структура("Схема, Хост, Порт, Путь", "https", "", 443, "/");
	Адрес = СокрЛП(АдресСервиса);

	Если СтрНачинаетсяС(НРег(Адрес), "https://") Тогда
		Результат.Схема = "https";
		Адрес = Сред(Адрес, 9);
		Результат.Порт = 443;
	ИначеЕсли СтрНачинаетсяС(НРег(Адрес), "http://") Тогда
		Результат.Схема = "http";
		Адрес = Сред(Адрес, 8);
		Результат.Порт = 80;
	КонецЕсли;

	ПозицияСлеша = СтрНайти(Адрес, "/");
	Если ПозицияСлеша = 0 Тогда
		ХостИПорт = Адрес;
		Результат.Путь = "/";
	Иначе
		ХостИПорт = Лев(Адрес, ПозицияСлеша - 1);
		Результат.Путь = Сред(Адрес, ПозицияСлеша);
	КонецЕсли;

	ПозицияДвоеточия = СтрНайти(ХостИПорт, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Результат.Хост = Лев(ХостИПорт, ПозицияДвоеточия - 1);
		Результат.Порт = Число(Сред(ХостИПорт, ПозицияДвоеточия + 1));
	Иначе
		Результат.Хост = ХостИПорт;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ОставитьОдноДваПредложения(Текст)

	Текст = СокрЛП(Текст);
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	ЧислоПредложений = 0;
	Результат = "";
	ДлинаТекста = СтрДлина(Текст);
	Для ИндексСимвола = 1 По ДлинаТекста Цикл
		Символ = Сред(Текст, ИндексСимвола, 1);
		Результат = Результат + Символ;
		Если Символ = "." Или Символ = "!" Или Символ = "?" Тогда
			СледующийСимвол = Сред(Текст, ИндексСимвола + 1, 1);
			Если СледующийСимвол = "" Или СледующийСимвол = " " Или СледующийСимвол = Символы.ПС Тогда
				ЧислоПредложений = ЧислоПредложений + 1;
				Если ЧислоПредложений >= 2 Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат СокрЛП(Результат);

КонецФункции
