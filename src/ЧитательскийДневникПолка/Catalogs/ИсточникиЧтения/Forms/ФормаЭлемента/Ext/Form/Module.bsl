&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	Оповестить("ЗаписанИсточникЧтения");

КонецПроцедуры

&НаКлиенте
Процедура ЗаметкиИсточника(Команда)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Сначала запишите источник.");
		Возврат;
	КонецЕсли;

	Отбор = Новый Структура("Владелец", Объект.Ссылка);
	ОткрытьФорму("Справочник.ЗаметкиКИсточникам.ФормаСписка", Новый Структура("Отбор", Отбор));

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗаметку(Команда)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Сначала запишите источник.");
		Возврат;
	КонецЕсли;

	ЗначенияЗаполнения = Новый Структура("Владелец", Объект.Ссылка);
	ОткрытьФорму(
		"Справочник.ЗаметкиКИсточникам.ФормаОбъекта",
		Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения));

КонецПроцедуры
