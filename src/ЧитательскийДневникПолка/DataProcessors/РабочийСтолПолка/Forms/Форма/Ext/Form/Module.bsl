&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьПрогрессНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПрогресс(Команда)

	ОбновитьПрогрессНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ЗаписанаСессияЧтения" Или ИмяСобытия = "ЗаписанИсточникЧтения" Тогда
		ОбновитьПрогрессНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПрогрессаПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.ТаблицаПрогресса.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущийИсточникПредставление = ТекущиеДанные.НазваниеИсточника;
	ПоказатьЗаметкиНаСервере(ТекущиеДанные.ИсточникЧтения);

КонецПроцедуры

&НаКлиенте
Процедура ЧтоЧитатьДальше(Команда)

	ЗапроситьРекомендацию();

КонецПроцедуры

&НаКлиенте
Процедура Повторить(Команда)

	ЗапроситьРекомендацию();

КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьРекомендацию()

	ТекущиеДанные = Элементы.ТаблицаПрогресса.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено И ТаблицаПрогресса.Количество() > 0 Тогда
		Элементы.ТаблицаПрогресса.ТекущаяСтрока = ТаблицаПрогресса[0].ПолучитьИдентификатор();
		ТекущиеДанные = Элементы.ТаблицаПрогресса.ТекущиеДанные;
	КонецЕсли;

	Если ТекущиеДанные = Неопределено Тогда
		ТекстРекомендации = "";
		ТекстОшибки = "Выберите источник в таблице прогресса.";
		Элементы.КнопкаПовторить.Видимость = Ложь;
		Возврат;
	КонецЕсли;

	РезультатРекомендации = РекомендацияНаСервере(
		ТекущиеДанные.НазваниеИсточника,
		ТекущиеДанные.ПроцентЗавершения,
		ТекущиеДанные.Тема);

	Если РезультатРекомендации.Успех Тогда
		ТекстРекомендации = РезультатРекомендации.ТекстРекомендации;
		ТекстОшибки = "";
		Элементы.КнопкаПовторить.Видимость = Ложь;
	Иначе
		ТекстРекомендации = "";
		ТекстОшибки = РезультатРекомендации.ТекстОшибки;
		Элементы.КнопкаПовторить.Видимость = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НоваяСессия(Команда)

	ПараметрыФормы = Новый Структура;
	ТекущиеДанные = Элементы.ТаблицаПрогресса.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПараметрыФормы.Вставить(
			"ЗначенияЗаполнения",
			Новый Структура("ИсточникЧтения", ТекущиеДанные.ИсточникЧтения));
	КонецЕсли;
	ОткрытьФорму("Документ.СессияЧтения.ФормаОбъекта", ПараметрыФормы);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьИсточник(Команда)

	ТекущиеДанные = Элементы.ТаблицаПрогресса.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите источник в таблице прогресса.");
		Возврат;
	КонецЕсли;
	ПоказатьЗначение(, ТекущиеДанные.ИсточникЧтения);

КонецПроцедуры

&НаКлиенте
Процедура СписокИсточников(Команда)

	ОткрытьФорму("Справочник.ИсточникиЧтения.ФормаСписка");

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДемо(Команда)

	ОткрытьФорму("Обработка.ЗагрузкаДемоДанных.Форма");

КонецПроцедуры

&НаКлиенте
Процедура НастройкиИИ(Команда)

	ОткрытьФорму("Обработка.НастройкиСервисаИИ.Форма");

КонецПроцедуры

&НаСервере
Процедура ОбновитьПрогрессНаСервере()

	ДанныеПрогресса = ДневникЧтенияСервер.ДанныеПрогресса();
	ТаблицаПрогресса.Загрузить(ДанныеПрогресса.ТаблицаПрогресса);
	КоличествоСессийЗаНеделю = ДанныеПрогресса.КоличествоСессийЗаНеделю;
	СуммаСтраницЗаНеделю = ДанныеПрогресса.СуммаСтраницЗаНеделю;
	СамыйАктивныйИсточник = ДанныеПрогресса.СамыйАктивныйИсточник;

	Если ТаблицаПрогресса.Количество() = 0 Тогда
		ТекущийИсточникПредставление = "";
		Заметки.Очистить();
		Возврат;
	КонецЕсли;

	ПерваяСтрока = ТаблицаПрогресса[0];
	ТекущийИсточникПредставление = ПерваяСтрока.НазваниеИсточника;
	Заметки.Загрузить(ДневникЧтенияСервер.ЗаметкиИсточника(ПерваяСтрока.ИсточникЧтения));

КонецПроцедуры

&НаСервере
Процедура ПоказатьЗаметкиНаСервере(ИсточникЧтения)

	Заметки.Загрузить(ДневникЧтенияСервер.ЗаметкиИсточника(ИсточникЧтения));

КонецПроцедуры

&НаСервереБезКонтекста
Функция РекомендацияНаСервере(НазваниеИсточника, ПроцентЗавершения, ТемаИсточника)

	Возврат ИнтеграцияИИСервер.ПолучитьРекомендациюЧтоЧитатьДальше(
		НазваниеИсточника,
		ПроцентЗавершения,
		ТемаИсточника);

КонецФункции
