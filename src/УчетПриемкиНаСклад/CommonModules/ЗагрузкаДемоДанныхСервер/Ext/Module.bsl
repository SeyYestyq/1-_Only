// Справочники и документы читаются отдельными запросами, не внутри цикла создания.
Функция ЗагрузитьДемоДанные() Экспорт

	ТоварыПоИмени = НайтиПоНаименованию("Справочник.Товары", ИменаТоваров());
	КонтактыПоИмени = НайтиПоНаименованию("Справочник.Контакты", ИменаКонтактов());
	ПоступленияПоКомментарию = НайтиДокументыПоКомментарию(КомментарииПоступлений());

	Монитор = ЗаписатьТовар("Монитор Dell 27", ТоварыПоИмени);
	Клавиатура = ЗаписатьТовар("Клавиатура механическая Keychron", ТоварыПоИмени);
	Кабель = ЗаписатьТовар("Кабель HDMI 2м", ТоварыПоИмени);
	Мышь = ЗаписатьТовар("Мышь Logitech", ТоварыПоИмени);
	ДокСтанция = ЗаписатьТовар("Док-станция USB-C", ТоварыПоИмени);

	Кладовщик = ЗаписатьКонтакт("Кладовщик демо", "sklad@example.com", КонтактыПоИмени);
	Руководитель = ЗаписатьКонтакт("Руководитель склада", "boss@example.com", КонтактыПоИмени);
	ЗаписатьКонтакт("Учебный ящик", "test@example.com", КонтактыПоИмени);

	СтрокиПервого = Новый Массив;
	СтрокиПервого.Добавить(Новый Структура("Товар, Количество", Монитор, 2));
	СтрокиПервого.Добавить(Новый Структура("Товар, Количество", Клавиатура, 5));
	СтрокиПервого.Добавить(Новый Структура("Товар, Количество", Кабель, 10));

	СтрокиВторого = Новый Массив;
	СтрокиВторого.Добавить(Новый Структура("Товар, Количество", Мышь, 4));
	СтрокиВторого.Добавить(Новый Структура("Товар, Количество", ДокСтанция, 1));

	СозданоПоступлений = 0;
	СозданоПоступлений = СозданоПоступлений + ЗаписатьПоступление(
		"Демо: поступление мониторов и кабеля",
		Кладовщик,
		"sklad@example.com",
		ПоступленияПоКомментарию,
		СтрокиПервого);
	СозданоПоступлений = СозданоПоступлений + ЗаписатьПоступление(
		"Демо: поступление мышей и док-станций",
		Руководитель,
		"boss@example.com",
		ПоступленияПоКомментарию,
		СтрокиВторого);

	Возврат СтрШаблон(
		"Демо-данные приемки готовы. Новых поступлений: %1. "
		+ "Первое: 2 монитора, 5 клавиатур, 10 кабелей, адрес sklad@example.com. "
		+ "Второе: 4 мыши и 1 док-станция, адрес boss@example.com. "
		+ "Повторное проведение не складывает остаток: в движениях остаётся один приход.",
		СозданоПоступлений);

КонецФункции

Функция ИменаТоваров()

	Имена = Новый Массив;
	Имена.Добавить("Монитор Dell 27");
	Имена.Добавить("Клавиатура механическая Keychron");
	Имена.Добавить("Кабель HDMI 2м");
	Имена.Добавить("Мышь Logitech");
	Имена.Добавить("Док-станция USB-C");
	Возврат Имена;

КонецФункции

Функция ИменаКонтактов()

	Имена = Новый Массив;
	Имена.Добавить("Кладовщик демо");
	Имена.Добавить("Руководитель склада");
	Имена.Добавить("Учебный ящик");
	Возврат Имена;

КонецФункции

Функция КомментарииПоступлений()

	Комментарии = Новый Массив;
	Комментарии.Добавить("Демо: поступление мониторов и кабеля");
	Комментарии.Добавить("Демо: поступление мышей и док-станций");
	Возврат Комментарии;

КонецФункции

Функция НайтиПоНаименованию(ИмяТаблицы, Наименования)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Таблица.Ссылка КАК Ссылка,
	|	Таблица.Наименование КАК Наименование
	|ИЗ
	|	" + ИмяТаблицы + " КАК Таблица
	|ГДЕ
	|	Таблица.Наименование В (&Наименования)
	|	И НЕ Таблица.ПометкаУдаления";
	Запрос.УстановитьПараметр("Наименования", Наименования);

	Найденные = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Найденные.Вставить(Выборка.Наименование, Выборка.Ссылка);
	КонецЦикла;
	Возврат Найденные;

КонецФункции

Функция НайтиДокументыПоКомментарию(Комментарии)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Поступление.Ссылка КАК Ссылка,
	|	Поступление.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.ПоступлениеТоваровНаСклад КАК Поступление
	|ГДЕ
	|	Поступление.Комментарий В (&Комментарии)";
	Запрос.УстановитьПараметр("Комментарии", Комментарии);

	Найденные = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Найденные.Вставить(Выборка.Комментарий, Выборка.Ссылка);
	КонецЦикла;
	Возврат Найденные;

КонецФункции

Функция ЗаписатьТовар(Наименование, Найденные)

	Ссылка = Найденные.Получить(Наименование);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	ОбъектТовара = Справочники.Товары.СоздатьЭлемент();
	ОбъектТовара.Наименование = Наименование;
	ОбъектТовара.Записать();
	Найденные.Вставить(Наименование, ОбъектТовара.Ссылка);
	Возврат ОбъектТовара.Ссылка;

КонецФункции

Функция ЗаписатьКонтакт(Наименование, АдресПочты, Найденные)

	Ссылка = Найденные.Получить(Наименование);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		ОбъектКонтакта = Ссылка.ПолучитьОбъект();
	Иначе
		ОбъектКонтакта = Справочники.Контакты.СоздатьЭлемент();
	КонецЕсли;

	ОбъектКонтакта.Наименование = Наименование;
	ОбъектКонтакта.Email = АдресПочты;
	ОбъектКонтакта.Записать();
	Найденные.Вставить(Наименование, ОбъектКонтакта.Ссылка);
	Возврат ОбъектКонтакта.Ссылка;

КонецФункции

Функция ЗаписатьПоступление(Комментарий, Контакт, АдресПочты, Найденные, Строки)

	Если Найденные.Получить(Комментарий) <> Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	ДокументОбъект = Документы.ПоступлениеТоваровНаСклад.СоздатьДокумент();
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	ДокументОбъект.КомуОтправить = Контакт;
	ДокументОбъект.АдресЭлектроннойПочты = АдресПочты;
	ДокументОбъект.Комментарий = Комментарий;

	Для Каждого ОписаниеСтроки Из Строки Цикл
		СтрокаТовары = ДокументОбъект.Товары.Добавить();
		СтрокаТовары.Товар = ОписаниеСтроки.Товар;
		СтрокаТовары.Количество = ОписаниеСтроки.Количество;
	КонецЦикла;

	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Найденные.Вставить(Комментарий, ДокументОбъект.Ссылка);
	Возврат 1;

КонецФункции
