&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НастройкиСервер.ПодключитьЛокальныеНастройкиSMTP();
	Настройки = НастройкиСервер.ПрочитатьНастройкиSMTP();
	АдресСервераSMTP = Настройки.АдресСервераSMTP;
	ПортSMTP = Настройки.ПортSMTP;
	ЛогинSMTP = Настройки.ЛогинSMTP;
	ПарольSMTP = Настройки.ПарольSMTP;
	ИспользоватьSSLSMTP = Настройки.ИспользоватьSSLSMTP;

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьНастройки(Команда)

	ЗаписатьНастройкиНаСервере();
	ПоказатьПредупреждение(, "Настройки SMTP записаны в константы.");

КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиНаСервере()

	Настройки = Новый Структура;
	Настройки.Вставить("АдресСервераSMTP", АдресСервераSMTP);
	Настройки.Вставить("ПортSMTP", ПортSMTP);
	Настройки.Вставить("ЛогинSMTP", ЛогинSMTP);
	Настройки.Вставить("ПарольSMTP", ПарольSMTP);
	Настройки.Вставить("ИспользоватьSSLSMTP", ИспользоватьSSLSMTP);
	НастройкиСервер.ЗаписатьНастройкиSMTP(Настройки);

КонецПроцедуры
